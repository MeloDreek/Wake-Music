    "MEGA.ProxyUnsupported" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع MEGA استخدام إعداد الوكيل الحالي للنظام. نصوص الوكيل التلقائي (PAC) غير مدعومة بعد. استخدم وكيل HTTP أو SOCKS يدويًا صالحًا، أو شبكة تصل إلى MEGA مباشرة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MEGA no pot utilitzar aquesta configuració de servidor intermediari. Els scripts automàtics (PAC) encara no són compatibles. Utilitza un proxy HTTP o SOCKS manual vàlid, o una xarxa amb accés directe a MEGA."
          }
        },
        "cs" : {
          "stringUnit" : {
