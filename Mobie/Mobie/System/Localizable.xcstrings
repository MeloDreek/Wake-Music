    "Purchase now to unlock all Apple devices, including iPhone, iPad, Mac, as well as the upcoming Apple Watch, Apple TV, and CarPlay." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الشراء الآن، ستحصل على إمكانية الوصول إلى جميع أجهزة Apple: iPhone وiPad وMac، بالإضافة إلى Apple Watch وApple TV وCarPlay القادمة قريبًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt kaufen und alle Apple-Geräte freischalten: iPhone, iPad, Mac sowie die bald verfügbaren Apple Watch, Apple TV und CarPlay."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purchase now to unlock all Apple devices, including iPhone, iPad, Mac, as well as the upcoming Apple Watch, Apple TV, and CarPlay."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purchase now to unlock all Apple devices, including iPhone, iPad, Mac, as well as the upcoming Apple Watch, Apple TV, and CarPlay."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purchase now to unlock all Apple devices, including iPhone, iPad, Mac, as well as the upcoming Apple Watch, Apple TV, and CarPlay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compra ahora y desbloquea todos los dispositivos Apple: iPhone, iPad, Mac, y próximamente Apple Watch, Apple TV y CarPlay."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adquiere ahora y desbloquea todos los dispositivos Apple: iPhone, iPad, Mac, y próximamente también Apple Watch, Apple TV y CarPlay."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compra ahora y accede a todos los dispositivos Apple: iPhone, iPad, Mac, y muy pronto Apple Watch, Apple TV y CarPlay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achetez maintenant pour débloquer tous les appareils Apple : iPhone, iPad, Mac, ainsi que les prochains Apple Watch, Apple TV et CarPlay."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achetez maintenant pour débloquer tous les appareils Apple : iPhone, iPad, Mac, ainsi que les prochains Apple Watch, Apple TV et CarPlay."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone, iPad, Mac, साथ ही आगामी Apple Watch, Apple TV और CarPlay सहित सभी Apple डिवाइसों को अनलॉक करने के लिए अभी खरीदें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beli sekarang untuk mengakses semua perangkat Apple, termasuk iPhone, iPad, Mac, serta Apple Watch, Apple TV, dan CarPlay yang akan datang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acquista ora per sbloccare tutti i dispositivi Apple: iPhone, iPad, Mac e, prossimamente, anche Apple Watch, Apple TV e CarPlay."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今すぐ購入すると、iPhone、iPad、Mac に加えて、近日対応予定の Apple Watch、Apple TV、CarPlay もすべて利用可能になります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 구매하시면 iPhone, iPad, Mac을 포함한 모든 Apple 기기에서 사용 가능하며, 곧 출시될 Apple Watch, Apple TV, CarPlay도 지원됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beli sekarang untuk membuka kunci semua peranti Apple, termasuk iPhone, iPad, Mac, serta Apple Watch, Apple TV dan CarPlay yang akan datang."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compre agora e desbloqueie todos os dispositivos Apple: iPhone, iPad, Mac e, em breve, Apple Watch, Apple TV e CarPlay."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compre agora e desbloqueie todos os dispositivos Apple: iPhone, iPad, Mac e, em breve, também Apple Watch, Apple TV e CarPlay"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Купите сейчас и получите доступ ко всем устройствам Apple: iPhone, iPad, Mac, а также к будущим Apple Watch, Apple TV и CarPlay."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซื้อตอนนี้เพื่อปลดล็อคอุปกรณ์ Apple ทั้งหมด รวมถึง iPhone, iPad, Mac รวมถึง Apple Watch, Apple TV และ CarPlay ที่จะวางจำหน่ายเร็วๆ นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi satın alarak iPhone, iPad, Mac dahil tüm Apple cihazlarının kilidini açın. Yakında Apple Watch, Apple TV ve CarPlay de desteklenecek!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mua ngay để mở khóa tất cả thiết bị Apple: iPhone, iPad, Mac, cùng với Apple Watch, Apple TV và CarPlay sẽ sớm ra mắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前购买即可解锁所有苹果设备，iPhone、iPad、Mac，以及即将推出的Apple Watch、Apple TV和CarPlay"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在購買即可解鎖所有 Apple 裝置，包括 iPhone、iPad、Mac，以及即將推出的 Apple Watch、Apple TV 和 CarPlay"
