        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virransäästötila päivittää sanoituksia harvemmin vähentääkseen suorittimen kuormitusta ja akun kulutusta. Poista se käytöstä, jos haluat tiheämmät päivitykset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode économie d’énergie actualise les paroles moins souvent pour réduire l’utilisation du processeur et la consommation de batterie. Désactivez-le pour des mises à jour plus fréquentes."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode économie d’énergie actualise les paroles moins souvent pour réduire l’utilisation du processeur et la consommation de batterie. Désactivez-le pour des mises à jour plus fréquentes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצב חיסכון בסוללה מעדכן את המילים בתדירות נמוכה יותר כדי לצמצם את השימוש במעבד ובסוללה. כבו אותו לעדכונים תכופים יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पावर सेविंग मोड में बोल कम बार अपडेट होते हैं, जिससे CPU और बैटरी का इस्तेमाल घटता है। अधिक बार अपडेट के लिए इसे बंद करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Način štednje energije rjeđe ažurira tekstove pjesama kako bi smanjio opterećenje procesora i potrošnju baterije. Isključite ga za češće ažuriranje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az energiatakarékos mód ritkábban frissíti a dalszöveget, így csökkenti a processzorterhelést és az akkumulátorfogyasztást. A gyakoribb frissítéshez kapcsolja ki."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode Hemat Daya memperbarui lirik lebih jarang untuk mengurangi penggunaan CPU dan baterai. Nonaktifkan untuk pembaruan yang lebih sering."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità Risparmio energetico aggiorna i testi meno spesso per ridurre l’uso della CPU e il consumo della batteria. Disattivala per aggiornamenti più frequenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "省電力モードでは歌詞の更新頻度を下げて、CPU使用率とバッテリー消費を抑えます。より頻繁に更新するにはオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "절전 모드는 가사 업데이트 빈도를 낮춰 CPU 사용량과 배터리 소모를 줄입니다. 더 자주 업데이트하려면 이 모드를 끄세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mod Penjimatan Kuasa mengemas kini lirik dengan lebih jarang untuk mengurangkan penggunaan CPU dan bateri. Matikan mod ini untuk kemas kini yang lebih kerap."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømsparingsmodus oppdaterer sangtekstene sjeldnere for å redusere CPU- og batteribruk. Slå den av for hyppigere oppdateringer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De energiebesparingsmodus werkt songteksten minder vaak bij om het CPU- en batterijverbruik te beperken. Schakel deze uit voor frequentere updates."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb oszczędzania energii rzadziej odświeża teksty, zmniejszając obciążenie procesora i zużycie baterii. Wyłącz go, aby odświeżać teksty częściej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo de economia de energia atualiza as letras com menos frequência para reduzir o uso da CPU e o consumo da bateria. Desative-o para atualizações mais frequentes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo de poupança de energia atualiza as letras com menos frequência para reduzir a utilização do processador e o consumo da bateria. Desative-o para atualizações mais frequentes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modul de economisire a energiei actualizează versurile mai rar pentru a reduce utilizarea procesorului și consumul bateriei. Dezactivați-l pentru actualizări mai frecvente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим энергосбережения обновляет текст песни реже, снижая нагрузку на процессор и расход батареи. Отключите его для более частого обновления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsporný režim aktualizuje texty menej často, čím znižuje zaťaženie procesora a spotrebu batérie. Pre častejšie aktualizácie ho vypnite."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varčevanje z energijo redkeje osvežuje besedila, da zmanjša obremenitev procesorja in porabo baterije. Za pogostejše osveževanje ga izklopite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strömsparläget uppdaterar låttexter mer sällan för att minska processorbelastningen och batteriförbrukningen. Stäng av det för tätare uppdateringar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหมดประหยัดพลังงานจะอัปเดตเนื้อเพลงน้อยครั้งลงเพื่อลดการใช้ CPU และแบตเตอรี่ ปิดโหมดนี้หากต้องการให้อัปเดตถี่ขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güç Tasarrufu Modu, CPU ve pil kullanımını azaltmak için şarkı sözlerini daha seyrek günceller. Daha sık güncelleme için bu modu kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим енергозбереження рідше оновлює текст пісні, зменшуючи навантаження на процесор і витрати заряду. Вимкніть його для частіших оновлень."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ tiết kiệm năng lượng cập nhật lời bài hát ít thường xuyên hơn để giảm mức dùng CPU và pin. Tắt chế độ này để cập nhật thường xuyên hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "省电模式会降低歌词更新频率，减少 CPU 占用和耗电。关闭后，歌词会更频繁地更新。"
          }
        },
        "zh-Hant" : {
