          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joidenkin tagien upottaminen epäonnistui. Tiedosto saattaa olla vioittunut. Yritä muokata manuaalisesti tai korvaa se uudella tiedostolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines métadonnées n’ont pas pu être intégrées. Le fichier est peut-être endommagé. Essayez de le modifier manuellement ou remplacez-le par un nouveau fichier."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines métadonnées n’ont pas pu être intégrées. Le fichier est peut-être endommagé. Essayez de le modifier manuellement ou remplacez-le par un nouveau fichier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן להטמיע חלק מהתגיות. ייתכן שהקובץ פגום. כדאי לנסות לערוך אותן ידנית או להחליף את הקובץ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ टैग एम्बेड करने में विफल। फ़ाइल दूषित हो सकती है। मैन्युअल रूप से संपादित करने या इसे एक नई फ़ाइल से बदलने का प्रयास करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugradnja nekih oznaka nije uspjela. Datoteka je možda oštećena. Pokušajte ručno urediti ili je zamijenite novom datotekom."
          }
        },
        "hu" : {
