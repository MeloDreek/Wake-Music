    "EQ.ListeningGuide" : {
      "comment" : "EQ footer above Reset. Gentle tuning advice; no source audio files are changed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تضبط الترددات المنخفضة دفء الصوت، وتبرز المتوسطة الغناء، وتضيف العالية التفاصيل. ابدأ بإعداد مسبق وأجرِ تعديلات صغيرة. إذا سمعت تشويشًا، خفّض كسب النطاقات أو المضخم الأولي. لا يغيّر المعادل ملفات الصوت الأصلية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els greus aporten calidesa, els mitjans destaquen les veus i els aguts afegeixen detall. Parteix d’un preajust i fes petits canvis. Si sents distorsió, redueix el guany de les bandes o del preamplificador. L’EQ no modifica els fitxers d’àudio."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basy dodávají plnost, středy zvýrazňují zpěv a výšky přidávají detaily. Začněte předvolbou a dělejte malé úpravy. Při zkreslení snižte zesílení pásem nebo předzesilovače. EQ nemění původní zvukové soubory."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bas giver fylde, mellemtoner fremhæver vokaler, og diskant tilføjer detaljer. Start med en forudindstilling, og foretag små justeringer. Hvis lyden forvrænges, så sænk båndenes forstærkning eller forforstærkeren. EQ ændrer ikke dine lydfiler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bässe geben Wärme, Mitten betonen Stimmen und Höhen bringen Details hervor. Nutze Presets als Ausgangspunkt und passe behutsam an. Bei Verzerrungen reduziere die Bandverstärkung oder den Vorverstärker. EQ verändert deine Audiodateien nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα μπάσα δίνουν όγκο, οι μεσαίες συχνότητες αναδεικνύουν τα φωνητικά και οι υψηλές προσθέτουν λεπτομέρεια. Ξεκινήστε με μια προρύθμιση και κάντε μικρές αλλαγές. Αν ακούτε παραμόρφωση, μειώστε την ενίσχυση των ζωνών ή του προενισχυτή. Το EQ δεν αλλάζει τα αρχεία ήχου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bass shapes warmth, mids bring out vocals, and treble adds detail. Use presets as a starting point and make small adjustments. If you hear distortion, reduce band gains or the preamp. EQ does not modify your audio files."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bass shapes warmth, mids bring out vocals, and treble adds detail. Use presets as a starting point and make small adjustments. If you hear distortion, reduce band gains or the preamp. EQ does not modify your audio files."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bass shapes warmth, mids bring out vocals, and treble adds detail. Use presets as a starting point and make small adjustments. If you hear distortion, reduce band gains or the preamp. EQ does not modify your audio files."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bass shapes warmth, mids bring out vocals, and treble adds detail. Use presets as a starting point and make small adjustments. If you hear distortion, reduce band gains or the preamp. EQ does not modify your audio files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los graves aportan calidez, los medios resaltan las voces y los agudos añaden detalle. Parte de un preajuste y haz pequeños cambios. Si oyes distorsión, reduce la ganancia de las bandas o del preamplificador. El EQ no modifica tus archivos de audio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los graves aportan calidez, los medios resaltan las voces y los agudos añaden detalle. Parte de un preajuste y haz pequeños cambios. Si oyes distorsión, reduce la ganancia de las bandas o del preamplificador. El EQ no modifica tus archivos de audio."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los graves aportan calidez, los medios resaltan las voces y los agudos añaden detalle. Parte de un preajuste y haz pequeños cambios. Si oyes distorsión, reduce la ganancia de las bandas o del preamplificador. El EQ no modifica tus archivos de audio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basso tuo lämpöä, keskitaajuudet korostavat laulua ja diskantti lisää yksityiskohtia. Aloita esiasetuksesta ja tee pieniä muutoksia. Jos ääni säröytyy, pienennä kaistojen tai esivahvistimen vahvistusta. EQ ei muuta äänitiedostojasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les basses apportent de la chaleur, les médiums mettent les voix en avant et les aigus ajoutent du détail. Partez d’un préréglage et ajustez légèrement. En cas de distorsion, baissez le gain des bandes ou du préampli. L’EQ ne modifie pas vos fichiers audio."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les basses apportent de la chaleur, les médiums mettent les voix en avant et les aigus ajoutent du détail. Partez d’un préréglage et ajustez légèrement. En cas de distorsion, baissez le gain des bandes ou du préampli. L’EQ ne modifie pas vos fichiers audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הבס מוסיף חמימות, תדרי הביניים מדגישים את השירה והגבוהים מוסיפים פרטים. התחילו בהגדרה מוכנה ובצעו שינויים קטנים. אם נשמע עיוות, הנמיכו את הגבר התדרים או את הקדם־מגבר. האקולייזר אינו משנה את קובצי השמע המקוריים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बास आवाज़ में गहराई देता है, मिड वोकल्स उभारते हैं और ट्रेबल बारीकियाँ जोड़ता है। प्रीसेट से शुरू करें और छोटे बदलाव करें। आवाज़ में विकृति हो तो बैंड गेन या प्रीऐम्प घटाएँ। EQ मूल ऑडियो फ़ाइलें नहीं बदलता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bas daje punoću, srednje frekvencije ističu vokale, a visoke dodaju detalje. Krenite od predloška i radite male prilagodbe. Ako čujete izobličenje, smanjite pojačanje pojaseva ili pretpojačala. EQ ne mijenja vaše audiodatoteke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mélyek teltséget adnak, a középtartomány kiemeli az éneket, a magasak részleteket hoznak elő. Induljon egy kész beállításból, és kis lépésekben módosítson. Torzítás esetén csökkentse a sávok vagy az előerősítő erősítését. Az EQ nem módosítja a hangfájlokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bas memberi kehangatan, frekuensi tengah menonjolkan vokal, dan trebel menambah detail. Mulai dari preset lalu sesuaikan sedikit demi sedikit. Jika terdengar distorsi, kurangi gain pita atau preamp. EQ tidak mengubah berkas audio asli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I bassi danno calore, i medi mettono in risalto le voci e gli alti aggiungono dettagli. Parti da un preset e fai piccoli aggiustamenti. Se senti distorsioni, riduci il guadagno delle bande o del preamplificatore. L’EQ non modifica i file audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低音域は厚み、中音域はボーカル、高音域は細部を調整します。プリセットを基準に少しずつ調整しましょう。音が歪む場合は、各帯域のゲインやプリアンプを下げてください。EQは元の音声ファイルを変更しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저음은 두께감을, 중음은 보컬을, 고음은 세부 표현을 조절합니다. 프리셋을 시작점으로 조금씩 조절하세요. 소리가 왜곡되면 밴드 게인이나 프리앰프를 낮추세요. EQ는 원본 오디오 파일을 변경하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bes memberi kehangatan, frekuensi pertengahan menonjolkan vokal dan trebel menambah perincian. Mulakan dengan praset dan buat pelarasan kecil. Jika bunyi terherot, kurangkan gandaan jalur atau prapenguat. EQ tidak mengubah fail audio asal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bass gir fylde, mellomtoner fremhever vokal, og diskant gir detaljer. Start med en forhåndsinnstilling og gjør små justeringer. Ved forvrengning kan du senke båndforsterkningen eller forforsterkeren. EQ endrer ikke lydfilene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lage tonen geven warmte, middentonen benadrukken zang en hoge tonen voegen details toe. Begin met een preset en pas voorzichtig aan. Hoor je vervorming, verlaag dan de bandversterking of voorversterker. EQ verandert je audiobestanden niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basy dodają pełni, średnie tony podkreślają wokal, a wysokie uwydatniają szczegóły. Zacznij od gotowego ustawienia i wprowadzaj małe zmiany. Jeśli słyszysz zniekształcenia, zmniejsz wzmocnienie pasm lub przedwzmacniacza. EQ nie zmienia plików audio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os graves dão corpo, os médios destacam as vozes e os agudos acrescentam detalhes. Comece com uma predefinição e faça pequenos ajustes. Se ouvir distorção, reduza o ganho das bandas ou do pré-amplificador. O EQ não modifica seus arquivos de áudio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os graves dão corpo, os médios destacam as vozes e os agudos acrescentam pormenores. Comece com uma predefinição e faça pequenos ajustes. Se ouvir distorção, reduza o ganho das bandas ou do pré-amplificador. O EQ não modifica os ficheiros de áudio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bașii dau căldură, mediile evidențiază vocea, iar înaltele adaugă detalii. Porniți de la o presetare și faceți ajustări mici. Dacă auziți distorsiuni, reduceți amplificarea benzilor sau a preamplificatorului. EQ nu modifică fișierele audio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Низкие частоты придают объём, средние выделяют вокал, высокие добавляют детали. Начните с пресета и вносите небольшие изменения. При искажениях уменьшите усиление полос или предусилителя. EQ не изменяет исходные аудиофайлы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basy dodávajú plnosť, stredy zvýrazňujú spev a výšky pridávajú detaily. Začnite predvoľbou a robte malé úpravy. Pri skreslení znížte zosilnenie pásiem alebo predzosilňovača. EQ nemení pôvodné zvukové súbory."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nizki toni dodajo polnost, srednji poudarijo vokale, visoki pa podrobnosti. Začnite s prednastavitvijo in delajte majhne prilagoditve. Če slišite popačenje, zmanjšajte ojačenje pasov ali predojačevalnika. EQ ne spreminja zvočnih datotek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bas ger fyllighet, mellanregister lyfter fram sång och diskant tillför detaljer. Börja med en förinställning och gör små justeringar. Vid distorsion kan du sänka bandens förstärkning eller förförstärkaren. EQ ändrar inte dina ljudfiler."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงต่ำเพิ่มความอิ่ม เสียงกลางเน้นเสียงร้อง และเสียงสูงเพิ่มรายละเอียด เริ่มจากพรีเซ็ตแล้วปรับทีละน้อย หากเสียงแตก ให้ลดเกนของย่านความถี่หรือพรีแอมป์ EQ จะไม่แก้ไขไฟล์เสียงต้นฉบับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bas sesin dolgunluğunu, orta frekanslar vokalleri, tizler ayrıntıları şekillendirir. Bir hazır ayarla başlayıp küçük değişiklikler yapın. Bozulma duyarsanız bant kazancını veya ön yükselticiyi azaltın. EQ, ses dosyalarınızı değiştirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Низькі частоти додають об’єму, середні виділяють вокал, високі підкреслюють деталі. Почніть із пресета й робіть невеликі зміни. Якщо чуєте спотворення, зменште підсилення смуг або передпідсилювача. EQ не змінює вихідні аудіофайли."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm trầm tạo độ ấm, âm trung làm nổi giọng hát và âm cao tăng chi tiết. Bắt đầu bằng một cấu hình có sẵn rồi điều chỉnh từng chút. Nếu nghe thấy méo tiếng, hãy giảm độ khuếch đại của dải tần hoặc tiền khuếch đại. EQ không thay đổi tệp âm thanh gốc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低频调节厚度，中频突出人声，高频增加细节。预设只是起点，建议小幅调整；若出现失真，请降低频段增益或前级增益。EQ 不会修改原音频文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低頻調整厚度，中頻凸顯人聲，高頻增加細節。預設只是起點，建議小幅調整；若出現失真，請降低頻段增益或前級增益。EQ 不會修改原始音訊檔案。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低頻調整厚度，中頻突出人聲，高頻增加細節。預設只是起點，建議小幅調整；若出現失真，請降低頻段增益或前級增益。EQ 不會修改原始音訊檔案。"
          }
        }
      }
    },
