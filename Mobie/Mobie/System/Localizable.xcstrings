        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Songtextdatei konnte nicht gelesen werden. Stelle sicher, dass sie nicht leer ist und UTF-8 oder GBK als Textkodierung verwendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν είναι δυνατή η ανάγνωση του αρχείου στίχων. Βεβαιωθείτε ότι δεν είναι κενό και χρησιμοποιεί κωδικοποίηση UTF-8 ή GBK."
          }
        },
        "en" : {
          "stringUnit" : {
