    "Your ultimate music player. Play anytime, anywhere, and enjoy total listening freedom!" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشغل الموسيقى المثالي لك. شغّل الموسيقى في أي وقت وأي مكان واستمتع بحرية الاستماع الكاملة!"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teu reproductor de música definitiu. Escolta en qualsevol moment i lloc, amb total llibertat!"
