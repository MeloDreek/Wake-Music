          "stringUnit" : {
            "state" : "translated",
            "value" : "हर सेवा से केवल एक खाता कनेक्ट कर सकते हैं। दूसरा जोड़ने से पहले मौजूदा खाते का कनेक्शन हटाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možete povezati samo jedan račun po usluzi. Prekinite postojeću vezu prije povezivanja drugog računa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szolgáltatásonként csak egy fiókot csatlakoztathat. Másik fiók használata előtt bontsa a meglévő kapcsolatot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya satu akun yang dapat dihubungkan per layanan. Hapus koneksi akun saat ini sebelum menambahkan akun lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi collegare un solo account per servizio. Rimuovi la connessione attuale prima di accedere con un altro account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービスごとに接続できるアカウントは1つです。別のアカウントを追加する前に、現在の接続を解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서비스마다 계정 하나만 연결할 수 있습니다. 다른 계정을 추가하기 전에 현재 계정의 연결을 제거하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya satu akaun boleh dipautkan bagi setiap perkhidmatan. Alih keluar sambungan akaun semasa sebelum menambah akaun lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan bare koble til én konto per tjeneste. Koble fra den eksisterende forbindelsen før du bruker en annen konto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt per dienst maar één account verbinden. Verwijder de huidige verbinding voordat je met een ander account inlogt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz połączyć tylko jedno konto dla każdej usługi. Przed użyciem innego konta rozłącz obecne połączenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você só pode conectar uma conta por serviço. Remova a conexão atual antes de entrar com outra conta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só pode ligar uma conta por serviço. Remova a ligação atual antes de iniciar sessão com outra conta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puteți conecta un singur cont pentru fiecare serviciu. Deconectați conexiunea existentă înainte de a folosi alt cont."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "К каждой службе можно подключить только одну учётную запись. Чтобы использовать другую, сначала отключите текущее подключение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ku každej službe môžete pripojiť len jeden účet. Pred použitím iného účtu najprv odpojte existujúce pripojenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za vsako storitev lahko povežete le en račun. Pred uporabo drugega računa prekinite obstoječo povezavo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
