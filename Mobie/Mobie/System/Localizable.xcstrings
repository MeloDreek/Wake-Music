    "WebDAV.ConnectionHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل WebDAV على NAS، ثم الصق عنوانه لملء البروتوكول والمضيف والمنفذ والمجلد. استخدم حسابًا بصلاحية القراءة. اترك المنفذ فارغًا للقيمة الافتراضية. خارج الشبكة المحلية يلزم إعداد وصول آمن."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa WebDAV al NAS i enganxa’n l’URL per omplir protocol, servidor, port i carpeta. Cal un compte amb accés de lectura. Deixa el port buit per usar el predeterminat. Fora de la xarxa local cal configurar accés remot segur."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte WebDAV na NAS a vložte jeho URL pro vyplnění protokolu, hostitele, portu a složky. Použijte účet s právem čtení. Prázdný port použije výchozí hodnotu. Mimo místní síť nastavte bezpečný vzdálený přístup."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivér WebDAV på din NAS, og indsæt URL’en for at udfylde protokol, vært, port og mappe. Brug en konto med læseadgang. Tom port bruger standardværdien. Uden for lokalnettet kræves sikker fjernadgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere WebDAV auf deinem NAS und füge dessen URL ein, um Protokoll, Host, Port und Ordner auszufüllen. Nutze ein Konto mit Leserechten. Ein leerer Port nutzt den Standard. Außerhalb des Heimnetzes ist ein sicherer Fernzugang nötig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε το WebDAV στο NAS και επικολλήστε το URL για πρωτόκολλο, διακομιστή, θύρα και φάκελο. Χρησιμοποιήστε λογαριασμό με δικαίωμα ανάγνωσης. Κενή θύρα σημαίνει προεπιλογή. Εκτός τοπικού δικτύου απαιτείται ασφαλής απομακρυσμένη πρόσβαση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable WebDAV on your NAS first. Paste its WebDAV URL to fill the protocol, host, port, and folder. Use an account with read access; leave the port blank for the default. On the same Wi-Fi, use the local address; away from home, use your configured secure remote address."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable WebDAV on your NAS first. Paste its WebDAV URL to fill the protocol, host, port, and folder. Use an account with read access; leave the port blank for the default. On the same Wi-Fi, use the local address; away from home, use your configured secure remote address."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable WebDAV on your NAS first. Paste its WebDAV URL to fill the protocol, host, port, and folder. Use an account with read access; leave the port blank for the default. On the same Wi-Fi, use the local address; away from home, use your configured secure remote address."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable WebDAV on your NAS first. Paste its WebDAV URL to fill the protocol, host, port, and folder. Use an account with read access; leave the port blank for the default. On the same Wi-Fi, use the local address; away from home, use your configured secure remote address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa WebDAV en tu NAS y pega su URL para rellenar protocolo, servidor, puerto y carpeta. Usa una cuenta con permiso de lectura. Deja el puerto vacío para usar el predeterminado. Fuera de la red local necesitas acceso remoto seguro."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa WebDAV en tu NAS y pega su URL para rellenar protocolo, servidor, puerto y carpeta. Usa una cuenta con permiso de lectura. Deja el puerto vacío para usar el predeterminado. Fuera de la red local necesitas acceso remoto seguro."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa WebDAV en tu NAS y pega su URL para rellenar protocolo, servidor, puerto y carpeta. Usa una cuenta con permiso de lectura. Deja el puerto vacío para usar el predeterminado. Fuera de la red local necesitas acceso remoto seguro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota WebDAV käyttöön NASissa ja liitä sen URL täyttääksesi protokollan, palvelimen, portin ja kansion. Käytä lukutiliä. Tyhjä portti käyttää oletusta. Lähiverkon ulkopuolella tarvitaan turvallinen etäyhteys."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez WebDAV sur votre NAS, puis collez son URL pour remplir protocole, hôte, port et dossier. Utilisez un compte avec accès en lecture. Un port vide utilise la valeur par défaut. Hors du réseau local, configurez un accès distant sécurisé."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez WebDAV sur votre NAS, puis collez son URL pour remplir protocole, hôte, port et dossier. Utilisez un compte avec accès en lecture. Un port vide utilise la valeur par défaut. Hors du réseau local, configurez un accès distant sécurisé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להפעיל WebDAV ב-NAS ולהדביק את ה-URL למילוי הפרוטוקול, השרת, היציאה והתיקייה. השתמשו בחשבון עם הרשאת קריאה. יציאה ריקה משתמשת בברירת המחדל. מחוץ לרשת המקומית נדרשת גישה מרחוק מאובטחת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NAS पर WebDAV चालू करें और प्रोटोकॉल, होस्ट, पोर्ट व फ़ोल्डर भरने के लिए उसका URL पेस्ट करें। पढ़ने की अनुमति वाला खाता उपयोग करें। डिफ़ॉल्ट पोर्ट के लिए इसे खाली छोड़ें। स्थानीय नेटवर्क से बाहर सुरक्षित रिमोट एक्सेस सेट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućite WebDAV na NAS-u i zalijepite URL za protokol, poslužitelj, priključak i mapu. Koristite račun s pravom čitanja. Prazan priključak koristi zadani. Izvan lokalne mreže potreban je siguran udaljeni pristup."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsold be a WebDAV-ot a NAS-on, és illeszd be az URL-t a protokoll, gép, port és mappa kitöltéséhez. Olvasási jogosultságú fiókot használj. Üres port esetén az alapérték érvényes. Távolról biztonságos hozzáférést kell beállítani."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan WebDAV di NAS, lalu tempel URL-nya untuk mengisi protokol, host, port, dan folder. Gunakan akun dengan izin baca. Kosongkan port untuk nilai bawaan. Di luar jaringan lokal, siapkan akses jarak jauh yang aman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva WebDAV sul NAS e incolla il suo URL per compilare protocollo, host, porta e cartella. Usa un account con accesso in lettura. La porta vuota usa il valore predefinito. Fuori dalla rete locale serve un accesso remoto sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NASでWebDAVを有効にし、そのURLを貼り付けると、プロトコル・ホスト・ポート・フォルダを自動入力できます。読み取り権限のあるアカウントを使用してください。ポートは空欄で既定値になります。宅外では安全なリモートアクセスの設定が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NAS에서 WebDAV를 켜고 URL을 붙여넣으면 프로토콜, 호스트, 포트, 폴더가 자동 입력됩니다. 읽기 권한이 있는 계정을 사용하세요. 포트를 비우면 기본값을 사용합니다. 외부에서는 안전한 원격 접속을 설정해야 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan WebDAV pada NAS dan tampal URL untuk mengisi protokol, hos, port dan folder. Gunakan akaun dengan akses baca. Kosongkan port untuk nilai lalai. Di luar rangkaian setempat, sediakan akses jauh yang selamat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver WebDAV på NAS-en og lim inn URL-en for å fylle ut protokoll, vert, port og mappe. Bruk en konto med lesetilgang. Tom port bruker standardverdien. Utenfor lokalnettet kreves sikker fjerntilgang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel WebDAV op je NAS in en plak de URL om protocol, host, poort en map in te vullen. Gebruik een account met leesrechten. Een lege poort gebruikt de standaardwaarde. Buiten je lokale netwerk is veilige toegang op afstand nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz WebDAV na NAS i wklej URL, aby uzupełnić protokół, host, port i folder. Użyj konta z prawem odczytu. Pusty port oznacza domyślny. Poza siecią lokalną skonfiguruj bezpieczny dostęp zdalny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o WebDAV no NAS e cole o URL para preencher protocolo, servidor, porta e pasta. Use uma conta com permissão de leitura. Deixe a porta vazia para usar o padrão. Fora da rede local, configure acesso remoto seguro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o WebDAV no NAS e cole o URL para preencher protocolo, servidor, porta e pasta. Use uma conta com permissão de leitura. Deixe a porta vazia para usar o padrão. Fora da rede local, configure acesso remoto seguro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activează WebDAV pe NAS și lipește URL-ul pentru protocol, gazdă, port și dosar. Folosește un cont cu drept de citire. Portul gol folosește valoarea implicită. În afara rețelei locale, configurează acces la distanță securizat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите WebDAV на NAS и вставьте его URL для заполнения протокола, хоста, порта и папки. Нужна учётная запись с правом чтения. Пустой порт означает стандартный. Вне локальной сети настройте безопасный удалённый доступ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnite WebDAV na NAS a vložte URL na vyplnenie protokolu, hostiteľa, portu a priečinka. Použite účet s právom čítania. Prázdny port použije predvolený. Mimo lokálnej siete nastavte bezpečný vzdialený prístup."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogočite WebDAV na NAS in prilepite URL za protokol, gostitelja, vrata in mapo. Uporabite račun s pravico branja. Prazna vrata uporabijo privzeto vrednost. Zunaj lokalnega omrežja nastavite varen oddaljeni dostop."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera WebDAV på din NAS och klistra in URL:en för protokoll, värd, port och mapp. Använd ett konto med läsbehörighet. Tom port använder standardvärdet. Utanför det lokala nätverket krävs säker fjärråtkomst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิด WebDAV บน NAS แล้ววาง URL เพื่อกรอกโปรโตคอล โฮสต์ พอร์ต และโฟลเดอร์ ใช้บัญชีที่มีสิทธิ์อ่าน เว้นพอร์ตว่างเพื่อใช้ค่าเริ่มต้น หากอยู่นอกเครือข่ายท้องถิ่น ต้องตั้งค่าการเข้าถึงระยะไกลที่ปลอดภัย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NAS üzerinde WebDAV’ı açın ve protokol, sunucu, bağlantı noktası ve klasör için URL’yi yapıştırın. Okuma izni olan bir hesap kullanın. Boş bağlantı noktası varsayılanı kullanır. Yerel ağ dışında güvenli uzaktan erişim ayarlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть WebDAV на NAS і вставте URL для заповнення протоколу, хоста, порту та папки. Використовуйте обліковий запис із правом читання. Порожній порт означає стандартний. Поза локальною мережею налаштуйте безпечний віддалений доступ."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật WebDAV trên NAS rồi dán URL để điền giao thức, máy chủ, cổng và thư mục. Dùng tài khoản có quyền đọc. Để trống cổng để dùng mặc định. Ngoài mạng nội bộ, cần thiết lập truy cập từ xa an toàn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先在 NAS 上开启 WebDAV 服务。粘贴 WebDAV 地址可自动填写协议、主机、端口和文件夹；使用有读取权限的账号，端口留空则使用默认值。同一 Wi-Fi 下可用局域网地址，外出访问需先配置安全的远程地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先在 NAS 上開啟 WebDAV 服務。貼上 WebDAV 位址可自動填入協定、主機、連接埠及資料夾；使用有讀取權限的帳號，連接埠留空則使用預設值。同一 Wi-Fi 下可用區域網路位址，外出存取需先設定安全的遠端位址。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先在 NAS 上開啟 WebDAV 服務。貼上 WebDAV 位址可自動填入協定、主機、連接埠及資料夾；使用有讀取權限的帳號，連接埠留空則使用預設值。同一 Wi-Fi 下可用區域網路位址，外出存取需先設定安全的遠端位址。"
          }
        }
      }
    },
    "WebDAV.InvalidAddress" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل عنوان HTTP أو HTTPS صالحًا ومنفذًا بين 1 و65535 أو اتركه فارغًا. أدخل بيانات الدخول في حقول الحساب. لا تُدعم معاملات الاستعلام أو الأجزاء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introdueix una adreça HTTP o HTTPS vàlida i un port entre 1 i 65535, o deixa’l buit. Escriu les credencials als camps del compte. No s’admeten paràmetres ni fragments."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte platnou adresu HTTP nebo HTTPS a port 1–65535, nebo jej nechte prázdný. Přihlašovací údaje patří do polí účtu. Parametry dotazu a fragmenty nejsou podporovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angiv en gyldig HTTP- eller HTTPS-adresse og port 1–65535, eller lad porten stå tom. Brug kontofelterne til login. Forespørgselsparametre og fragmenter understøttes ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib eine gültige HTTP- oder HTTPS-Adresse und einen Port von 1 bis 65535 ein, oder lasse den Port leer. Zugangsdaten gehören in die Kontofelder. Abfrageparameter und Fragmente werden nicht unterstützt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισαγάγετε έγκυρη διεύθυνση HTTP ή HTTPS και θύρα 1–65535 ή αφήστε τη κενή. Βάλτε τα διαπιστευτήρια στα πεδία λογαριασμού. Δεν υποστηρίζονται παράμετροι ερωτήματος ή τμήματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a valid HTTP or HTTPS server address and a port from 1 to 65535, or leave the port blank. Enter credentials in the account fields. Query strings and fragments are not supported."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a valid HTTP or HTTPS server address and a port from 1 to 65535, or leave the port blank. Enter credentials in the account fields. Query strings and fragments are not supported."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a valid HTTP or HTTPS server address and a port from 1 to 65535, or leave the port blank. Enter credentials in the account fields. Query strings and fragments are not supported."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a valid HTTP or HTTPS server address and a port from 1 to 65535, or leave the port blank. Enter credentials in the account fields. Query strings and fragments are not supported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce una dirección HTTP o HTTPS válida y un puerto entre 1 y 65535, o déjalo vacío. Usa los campos de cuenta para las credenciales. No se admiten parámetros de consulta ni fragmentos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce una dirección HTTP o HTTPS válida y un puerto entre 1 y 65535, o déjalo vacío. Usa los campos de cuenta para las credenciales. No se admiten parámetros de consulta ni fragmentos."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce una dirección HTTP o HTTPS válida y un puerto entre 1 y 65535, o déjalo vacío. Usa los campos de cuenta para las credenciales. No se admiten parámetros de consulta ni fragmentos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna kelvollinen HTTP- tai HTTPS-osoite ja portti 1–65535 tai jätä portti tyhjäksi. Kirjoita tunnukset tilikenttiin. Kyselyparametreja ja fragmentteja ei tueta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez une adresse HTTP ou HTTPS valide et un port de 1 à 65535, ou laissez-le vide. Utilisez les champs du compte pour les identifiants. Les paramètres de requête et fragments ne sont pas pris en charge."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez une adresse HTTP ou HTTPS valide et un port de 1 à 65535, ou laissez-le vide. Utilisez les champs du compte pour les identifiants. Les paramètres de requête et fragments ne sont pas pris en charge."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזינו כתובת HTTP או HTTPS תקינה ויציאה בין 1 ל-65535, או השאירו אותה ריקה. פרטי ההתחברות שייכים לשדות החשבון. פרמטרי שאילתה ומקטעים אינם נתמכים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मान्य HTTP या HTTPS पता और 1–65535 का पोर्ट भरें या पोर्ट खाली छोड़ें। लॉगिन विवरण खाता फ़ील्ड में भरें। क्वेरी पैरामीटर और फ़्रैगमेंट समर्थित नहीं हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unesite valjanu HTTP ili HTTPS adresu i priključak 1–65535 ili ga ostavite praznim. Vjerodajnice unesite u polja računa. Parametri upita i fragmenti nisu podržani."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Érvényes HTTP- vagy HTTPS-címet és 1–65535 közötti portot adj meg, vagy hagyd üresen. A belépési adatokat a fiókmezőkbe írd. Lekérdezési paraméterek és töredékek nem támogatottak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan alamat HTTP atau HTTPS yang valid dan port 1–65535, atau kosongkan port. Isi kredensial di kolom akun. Parameter kueri dan fragmen tidak didukung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci un indirizzo HTTP o HTTPS valido e una porta da 1 a 65535, oppure lasciala vuota. Usa i campi account per le credenziali. Parametri di query e frammenti non sono supportati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効なHTTPまたはHTTPSアドレスと1〜65535のポートを入力するか、ポートを空欄にしてください。認証情報はアカウント欄に入力します。クエリやフラグメントは使用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유효한 HTTP 또는 HTTPS 주소와 1–65535 포트를 입력하거나 포트를 비워 두세요. 인증 정보는 계정 입력란에 입력하세요. 쿼리 매개변수와 프래그먼트는 지원하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan alamat HTTP atau HTTPS yang sah dan port 1–65535, atau kosongkan port. Isi kelayakan dalam medan akaun. Parameter pertanyaan dan fragmen tidak disokong."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angi en gyldig HTTP- eller HTTPS-adresse og port 1–65535, eller la porten stå tom. Skriv inn påloggingsdata i kontofeltene. Spørringsparametere og fragmenter støttes ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer een geldig HTTP- of HTTPS-adres en poort 1–65535 in, of laat de poort leeg. Gebruik de accountvelden voor inloggegevens. Queryparameters en fragmenten worden niet ondersteund."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz poprawny adres HTTP lub HTTPS i port 1–65535 albo pozostaw port pusty. Dane logowania wpisz w polach konta. Parametry zapytania i fragmenty nie są obsługiwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insira um endereço HTTP ou HTTPS válido e uma porta de 1 a 65535, ou deixe-a vazia. Use os campos da conta para as credenciais. Parâmetros de consulta e fragmentos não são suportados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insira um endereço HTTP ou HTTPS válido e uma porta de 1 a 65535, ou deixe-a vazia. Use os campos da conta para as credenciais. Parâmetros de consulta e fragmentos não são suportados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introdu o adresă HTTP sau HTTPS validă și un port 1–65535, sau lasă portul gol. Introdu datele de autentificare în câmpurile contului. Parametrii de interogare și fragmentele nu sunt acceptate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите корректный HTTP- или HTTPS-адрес и порт 1–65535 либо оставьте порт пустым. Данные входа укажите в полях аккаунта. Параметры запроса и фрагменты не поддерживаются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadajte platnú adresu HTTP alebo HTTPS a port 1–65535 alebo ho nechajte prázdny. Prihlasovacie údaje patria do polí účtu. Parametre dopytu a fragmenty nie sú podporované."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vnesite veljaven naslov HTTP ali HTTPS in vrata 1–65535 ali jih pustite prazna. Poverilnice vnesite v polja računa. Parametri poizvedbe in fragmenti niso podprti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange en giltig HTTP- eller HTTPS-adress och port 1–65535, eller lämna porten tom. Skriv in inloggningsuppgifter i kontofälten. Frågeparametrar och fragment stöds inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กรอกที่อยู่ HTTP หรือ HTTPS ที่ถูกต้องและพอร์ต 1–65535 หรือเว้นพอร์ตว่าง กรอกข้อมูลเข้าสู่ระบบในช่องบัญชี ไม่รองรับพารามิเตอร์คำค้นหรือส่วนย่อยของ URL"
