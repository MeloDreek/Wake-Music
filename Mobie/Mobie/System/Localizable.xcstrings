        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen mevcut cihazın bilgisayarınız veya Android telefonunuzla aynı Wi-Fi'ye bağlı olduğundan emin olun ve aktarım sırasında ekranı kapatmayın"
