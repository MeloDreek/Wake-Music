    "Navidrome.ConnectionHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل عنوان خادم Navidrome أو Subsonic المتوافق وحساب الموسيقى، وليس مسار مجلد مشترك. اطلب التفاصيل من المسؤول؛ قد يختلف الحساب عن حساب NAS. يلزم إعداد الوصول عن بُعد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introdueix l’URL i el compte d’un servidor Navidrome o compatible amb Subsonic, no una carpeta compartida. Demana’ls a l’administrador; el compte pot ser diferent del NAS. Cal configurar l’accés remot."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte URL a účet hudebního serveru Navidrome nebo kompatibilního se Subsonic, ne sdílenou složku. Údaje získáte od správce; účet se může lišit od NAS. Vzdálený přístup vyžaduje nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast URL og musikkonto til en Navidrome- eller Subsonic-kompatibel server, ikke en delt mappe. Spørg administratoren; kontoen kan være forskellig fra NAS-kontoen. Fjernadgang skal konfigureres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib URL und Musikkonto eines Navidrome- oder Subsonic-kompatiblen Servers ein, keinen Freigabeordner. Frage den Administrator; das Konto kann vom NAS-Konto abweichen. Fernzugriff muss eingerichtet werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισαγάγετε URL και λογαριασμό μουσικού διακομιστή Navidrome ή συμβατού με Subsonic, όχι κοινόχρηστο φάκελο. Ρωτήστε τον διαχειριστή· ο λογαριασμός μπορεί να διαφέρει από του NAS. Ρυθμίστε χωριστά την απομακρυσμένη πρόσβαση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect to a Navidrome or compatible Subsonic music server, not a shared folder. Enter its server URL (including any port and path) and music-server account. Ask the administrator for these details. Your NAS login may be different; remote access must be configured separately."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect to a Navidrome or compatible Subsonic music server, not a shared folder. Enter its server URL (including any port and path) and music-server account. Ask the administrator for these details. Your NAS login may be different; remote access must be configured separately."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect to a Navidrome or compatible Subsonic music server, not a shared folder. Enter its server URL (including any port and path) and music-server account. Ask the administrator for these details. Your NAS login may be different; remote access must be configured separately."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect to a Navidrome or compatible Subsonic music server, not a shared folder. Enter its server URL (including any port and path) and music-server account. Ask the administrator for these details. Your NAS login may be different; remote access must be configured separately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce la URL y la cuenta de un servidor musical Navidrome o compatible con Subsonic, no una carpeta compartida. Pídelas al administrador; la cuenta puede ser distinta de la del NAS. Configura el acceso remoto por separado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce la URL y la cuenta de un servidor musical Navidrome o compatible con Subsonic, no una carpeta compartida. Pídelas al administrador; la cuenta puede ser distinta de la del NAS. Configura el acceso remoto por separado."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce la URL y la cuenta de un servidor musical Navidrome o compatible con Subsonic, no una carpeta compartida. Pídelas al administrador; la cuenta puede ser distinta de la del NAS. Configura el acceso remoto por separado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna Navidrome- tai Subsonic-yhteensopivan musiikkipalvelimen URL ja tili, ei jaettua kansiota. Kysy tiedot ylläpitäjältä; tili voi erota NAS-tilistä. Etäkäyttö on määritettävä erikseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez l’URL et le compte d’un serveur musical Navidrome ou compatible Subsonic, pas un dossier partagé. Demandez-les à l’administrateur ; le compte peut différer de celui du NAS. L’accès distant doit être configuré séparément."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez l’URL et le compte d’un serveur musical Navidrome ou compatible Subsonic, pas un dossier partagé. Demandez-les à l’administrateur ; le compte peut différer de celui du NAS. L’accès distant doit être configuré séparément."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזינו URL וחשבון של שרת מוזיקה Navidrome או תואם Subsonic, ולא תיקייה משותפת. בקשו פרטים מהמנהל; החשבון עשוי להיות שונה מחשבון ה-NAS. יש להגדיר גישה מרחוק בנפרד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navidrome या Subsonic-संगत संगीत सर्वर का URL और खाता भरें, साझा फ़ोल्डर नहीं। विवरण व्यवस्थापक से लें; NAS का खाता अलग हो सकता है। रिमोट एक्सेस अलग से सेट करना होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unesite URL i račun glazbenog poslužitelja Navidrome ili kompatibilnog sa Subsonicom, ne dijeljenu mapu. Pitajte administratora; račun se može razlikovati od NAS računa. Udaljeni pristup postavite zasebno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navidrome- vagy Subsonic-kompatibilis zeneszerver URL-jét és fiókját add meg, ne megosztott mappát. Kérdezd a rendszergazdát; a fiók eltérhet a NAS-fióktól. A távoli hozzáférést külön kell beállítani."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan URL dan akun server musik Navidrome atau yang kompatibel dengan Subsonic, bukan folder bersama. Minta detail kepada administrator; akun NAS bisa berbeda. Akses jarak jauh perlu diatur terpisah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci URL e account di un server musicale Navidrome o compatibile con Subsonic, non una cartella condivisa. Chiedili all’amministratore; l’account può essere diverso da quello del NAS. Configura separatamente l’accesso remoto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有フォルダではなく、NavidromeまたはSubsonic互換の音楽サーバーのURLとアカウントを入力します。不明な場合は管理者に確認してください。NASのログイン情報とは異なる場合があります。宅外アクセスは別途設定が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 폴더가 아닌 Navidrome 또는 Subsonic 호환 음악 서버의 URL과 계정을 입력하세요. 관리자에게 정보를 요청하세요. NAS 계정과 다를 수 있으며 외부 접속은 별도 설정이 필요합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan URL dan akaun pelayan muzik Navidrome atau serasi Subsonic, bukan folder kongsi. Minta butiran daripada pentadbir; akaun NAS mungkin berbeza. Akses jauh perlu dikonfigurasi berasingan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angi URL og musikkonto for en Navidrome- eller Subsonic-kompatibel server, ikke en delt mappe. Spør administratoren; kontoen kan være ulik NAS-kontoen. Fjerntilgang må konfigureres separat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer de URL en het account van een Navidrome- of Subsonic-compatibele muziekserver in, geen gedeelde map. Vraag de beheerder om details; het NAS-account kan anders zijn. Stel externe toegang apart in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz URL i konto serwera muzycznego Navidrome lub zgodnego z Subsonic, nie folder współdzielony. Zapytaj administratora; konto NAS może być inne. Dostęp zdalny wymaga osobnej konfiguracji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insira o URL e a conta de um servidor de música Navidrome ou compatível com Subsonic, não uma pasta partilhada. Peça os dados ao administrador; a conta do NAS pode ser diferente. Configure o acesso remoto separadamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insira o URL e a conta de um servidor de música Navidrome ou compatível com Subsonic, não uma pasta partilhada. Peça os dados ao administrador; a conta do NAS pode ser diferente. Configure o acesso remoto separadamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introdu URL-ul și contul unui server muzical Navidrome sau compatibil Subsonic, nu un dosar partajat. Cere detalii administratorului; contul NAS poate fi diferit. Accesul la distanță se configurează separat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите URL и аккаунт музыкального сервера Navidrome или совместимого с Subsonic, а не общую папку. Уточните данные у администратора: аккаунт NAS может отличаться. Удалённый доступ настраивается отдельно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadajte URL a účet hudobného servera Navidrome alebo kompatibilného so Subsonic, nie zdieľaný priečinok. Údaje získate od správcu; účet NAS môže byť iný. Vzdialený prístup nastavte osobitne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vnesite URL in račun glasbenega strežnika Navidrome ali združljivega s Subsonic, ne skupne mape. Podatke dobite pri skrbniku; račun NAS je lahko drugačen. Oddaljeni dostop nastavite posebej."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange URL och musikkonto för en Navidrome- eller Subsonic-kompatibel server, inte en delad mapp. Fråga administratören; kontot kan skilja sig från NAS-kontot. Fjärråtkomst måste konfigureras separat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กรอก URL และบัญชีของเซิร์ฟเวอร์เพลง Navidrome หรือที่รองรับ Subsonic ไม่ใช่โฟลเดอร์ที่แชร์ สอบถามผู้ดูแลระบบ บัญชีอาจต่างจาก NAS และต้องตั้งค่าการเข้าถึงระยะไกลแยกต่างหาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşılan klasör değil, Navidrome veya Subsonic uyumlu müzik sunucusunun URL’sini ve hesabını girin. Bilgileri yöneticiden isteyin; NAS hesabı farklı olabilir. Uzaktan erişim ayrıca ayarlanmalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введіть URL та обліковий запис музичного сервера Navidrome або сумісного із Subsonic, а не спільну папку. Запитайте адміністратора: обліковий запис NAS може відрізнятися. Віддалений доступ налаштовується окремо."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập URL và tài khoản máy chủ nhạc Navidrome hoặc tương thích Subsonic, không phải thư mục chia sẻ. Hỏi quản trị viên để biết thông tin; tài khoản NAS có thể khác. Cần thiết lập riêng truy cập từ xa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于连接 Navidrome 或兼容 Subsonic 的音乐服务器，不是 NAS 共享文件夹。填写服务器地址（含端口、路径）和音乐服账号；不清楚时请向管理员索取。音乐服账号不一定是 NAS 登录账号，外出访问需另行配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於連接 Navidrome 或相容 Subsonic 的音樂伺服器，不是 NAS 共用資料夾。填入伺服器位址（含連接埠、路徑）及音樂伺服器帳號；不清楚時請向管理員索取。帳號不一定是 NAS 登入帳號，外出存取需另行設定。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於連接 Navidrome 或相容 Subsonic 的音樂伺服器，不是 NAS 共用資料夾。填入伺服器位址（含連接埠、路徑）及音樂伺服器帳號；不清楚時請向管理員索取。帳號不一定是 NAS 登入帳號，外出存取需另行設定。"
          }
