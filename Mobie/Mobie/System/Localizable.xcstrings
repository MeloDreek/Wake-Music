        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komprimirani zvuk koristi viši stupanj kompresije kako bi smanjio veličinu datoteke, uz gubitak kvalitete zvuka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A veszteséges hang nagyobb tömörítést használ a fájlméret csökkentésére, a hangminőség rovására."
