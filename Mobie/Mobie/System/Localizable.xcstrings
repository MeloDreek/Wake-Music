            "value" : "आप एक साथ कई खातों में साइन इन नहीं कर सकते। कृपया पहले से साइन इन किए गए खाते को हटाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne možete se istovremeno prijaviti na više računa. Uklonite prethodno prijavljeni račun."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem lehet egyszerre több fiókba bejelentkezni. Kérjük, távolítsa el a korábban bejelentkezett fiókot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak dapat masuk ke beberapa akun secara bersamaan. Hapus akun yang sebelumnya masuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
