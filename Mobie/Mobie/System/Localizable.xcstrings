    "You can’t sign in to multiple accounts at the same time. Please remove the previously signed-in account." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن ربط حساب واحد فقط لكل خدمة. أزل اتصال الحساب الحالي قبل إضافة حساب آخر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només pots connectar un compte per servei. Elimina la connexió actual abans d’iniciar sessió amb un altre compte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ke každé službě lze připojit jen jeden účet. Chcete-li použít jiný, nejprve odpojte stávající připojení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan kun forbinde én konto pr. tjeneste. Afbryd den eksisterende forbindelse, før du bruger en anden konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst pro Dienst nur ein Konto verbinden. Entferne die aktuelle Verbindung, bevor du dich mit einem anderen Konto anmeldest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε να συνδέσετε μόνο έναν λογαριασμό ανά υπηρεσία. Αποσυνδέστε την υπάρχουσα σύνδεση πριν χρησιμοποιήσετε άλλον λογαριασμό."
          }
