    "1. Once purchased, the cost will be deducted from your Apple Account." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. بمجرد الشراء، سيتم خصم التكلفة من حساب Apple الخاص بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Nach dem Kauf wird die Gebühr von Ihrem Apple-Konto abgebucht."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Once purchased, the cost will be deducted from your Apple Account."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Once purchased, the cost will be deducted from your Apple Account."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Once purchased, the cost will be deducted from your Apple Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Una vez realizada la compra, el costo se deducirá de su cuenta de Apple."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Una vez realizada la compra, el costo se deducirá de su cuenta de Apple."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Una vez realizada la compra, el costo se deducirá de su cuenta de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Une fois l'achat effectué, le coût sera déduit de votre compte Apple."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Une fois l'achat effectué, le coût sera déduit de votre compte Apple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. एक बार खरीद लेने पर, लागत आपके एप्पल खाते से काट ली जाएगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Setelah dibeli, biayanya akan dipotong dari Akun Apple Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Una volta acquistato, il costo verrà detratto dal vostro account Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 購入後、Appleアカウントから代金が引き落とされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 구매가 완료되면 Apple 계정에서 비용이 차감됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Setelah dibeli, kos akan ditolak daripada Akaun Apple anda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Uma vez comprada, a taxa será deduzida da sua conta Apple."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Uma vez comprada, a taxa será deduzida da sua conta Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. После покупки комиссия будет списана с вашей учетной записи Apple."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. เมื่อซื้อแล้วค่าใช้จ่ายจะถูกหักจากบัญชี Apple ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Satın alındıktan sonra, ücret Apple hesabınızdan düşülecektir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Sau khi mua, chi phí sẽ được khấu trừ từ Tài khoản Apple của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1、一旦购买，费用将从您的Apple账户中扣除。"
          }
        },
        "zh-Hant" : {
