    "Regular lossless audio, which loses a small amount of audio data during compression, typically has a sample rate of 44.1kHz, 48.1kHz, or 96kHz." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصوت العادي غير المنقوص، الذي يفقد كمية صغيرة من البيانات الصوتية أثناء الضغط، وعادةً ما يكون معدل العينة 44.1 كيلو هرتز أو 48.1 كيلو هرتز أو 96 كيلو هرتز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normales verlustfreies Audio, bei dem während der Kompression eine kleine Menge an Audiodaten verloren geht, mit einer typischen Abtastrate von 44,1 kHz, 48,1 kHz oder 96 kHz."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regular lossless audio, which loses a small amount of audio data during compression, typically has a sample rate of 44.1kHz, 48.1kHz, or 96kHz."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regular lossless audio, which loses a small amount of audio data during compression, typically has a sample rate of 44.1kHz, 48.1kHz, or 96kHz."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regular lossless audio, which loses a small amount of audio data during compression, typically has a sample rate of 44.1kHz, 48.1kHz, or 96kHz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio sin pérdidas estándar, que pierde una pequeña cantidad de datos de audio durante la compresión, con una tasa de muestreo típica de 44,1 kHz, 48,1 kHz o 96 kHz"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio sin pérdidas estándar, que pierde una pequeña cantidad de datos de audio durante la compresión, con una tasa de muestreo típica de 44,1 kHz, 48,1 kHz o 96 kHz"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio sin pérdidas estándar, que pierde una pequeña cantidad de datos de audio durante la compresión, con una tasa de muestreo típica de 44,1 kHz, 48,1 kHz o 96 kHz"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio sans perte standard, qui perd une petite quantité de données audio lors de la compression, avec un taux d'échantillonnage généralement de 44,1 kHz, 48,1 kHz ou 96 kHz."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio sans perte standard, qui perd une petite quantité de données audio lors de la compression, avec un taux d'échantillonnage généralement de 44,1 kHz, 48,1 kHz ou 96 kHz."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नियमित दोषरहित ऑडियो, जिसमें संपीड़न के दौरान ऑडियो डेटा की थोड़ी मात्रा नष्ट हो जाती है, की नमूना दर आमतौर पर 44.1kHz, 48.1kHz, या 96kHz होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio lossless biasa, yang kehilangan sejumlah kecil data audio selama kompresi, umumnya memiliki laju sampel 44,1 kHz, 48,1 kHz, atau 96 kHz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'audio lossless regolare, che perde una piccola quantità di dati audio durante la compressione, ha in genere una frequenza di campionamento di 44,1 kHz, 48,1 kHz o 96 kHz."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般的なロスレスオーディオは、圧縮中に少量のオーディオデータが失われ、サンプリングレートは通常44.1kHz、48.1kHz、または96kHzです"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반 무손실 오디오는 압축 과정에서 소량의 오디오 데이터가 손실됨, 일반적으로 44.1kHz, 48.1kHz 또는 96kHz의 샘플 레이트로 압축됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio tanpa kehilangan biasa, yang kehilangan sejumlah kecil data audio semasa pemampatan, biasanya mempunyai kadar sampel 44.1kHz, 48.1kHz atau 96kHz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áudio sem perdas regular, que perde uma pequena quantidade de dados de áudio durante a compressão, com uma taxa de amostragem geralmente de 44,1 kHz, 48,1 kHz ou 96 kHz"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áudio sem perdas regular, que perde uma pequena quantidade de dados de áudio durante a compressão, com uma taxa de amostragem geralmente de 44,1 kHz, 48,1 kHz ou 96 kHz"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычное без потерь аудио, при котором во время сжатия теряется небольшое количество аудиоданных, с частотой дискретизации обычно 44,1 кГц, 48,1 кГц или 96 кГц"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงปกติที่ไม่สูญเสียข้อมูล ซึ่งสูญเสียข้อมูลเสียงจำนวนเล็กน้อยในระหว่างการบีบอัด โดยทั่วไปจะมีอัตราตัวอย่าง 44.1kHz, 48.1kHz หรือ 96kHz"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal kayıpsız ses, sıkıştırma sırasında küçük bir miktar ses verisi kaybeder, genellikle 44,1 kHz, 48,1 kHz veya 96 kHz örnekleme hızıyla"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm thanh không mất chất lượng thông thường, mất một lượng nhỏ dữ liệu âm thanh trong quá trình nén, với tỷ lệ lấy mẫu thường là 44,1kHz, 48,1kHz hoặc 96kHz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "普通的无损音频，压缩过程中丢失少量的音频数据，采样率通常为44.1kHz，48.1kHz或96kHz"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "普通的無損音頻，在壓縮過程中會損失少量音頻數據，採樣率通常為44.1kHz、48.1kHz或96kHz"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "普通嘅无损音频，喺压缩过程中会损失少量音频数据，采样率通常为44.1kHz、48.1kHz或96kHz"
          }
        }
      }
    },
