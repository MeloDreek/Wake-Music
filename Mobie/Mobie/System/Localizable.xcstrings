    "A more powerful player engine that supports music formats that Apple Music cannot decode, such as DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV etc." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محرك تشغيل أكثر قوة يدعم تنسيقات الموسيقى التي لا يستطيع Apple Music فك تشفيرها، مثل DSD (DSF، DFF)، وDTS، وAPE، وOGG، وOPUS، وWMA، وS3M، وTTA، وMOD، وWV، وما إلى ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine leistungsfähigere Player-Engine, die Musikformate unterstützt, die Apple Music nicht dekodieren kann, wie DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV usw."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A more powerful player engine that supports music formats that Apple Music cannot decode, such as DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV etc."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A more powerful player engine that supports music formats that Apple Music cannot decode, such as DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV etc."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A more powerful player engine that supports music formats that Apple Music cannot decode, such as DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV etc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un motor de reproducción más potente que admite formatos de música que Apple Music no puede decodificar, como DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV, etc."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un motor de reproducción más potente que admite formatos de música que Apple Music no puede decodificar, como DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV, etc."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un motor de reproducción más potente que admite formatos de música que Apple Music no puede decodificar, como DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV, etc."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un moteur de lecteur plus puissant qui prend en charge les formats musicaux qu'Apple Music ne peut pas décoder, tels que DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV, etc."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un moteur de lecteur plus puissant qui prend en charge les formats musicaux qu'Apple Music ne peut pas décoder, tels que DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV, etc."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक अधिक शक्तिशाली प्लेयर इंजन जो ऐसे संगीत प्रारूपों का समर्थन करता है जिन्हें Apple Music डिकोड नहीं कर सकता, जैसे DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV आदि।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesin pemutar musik yang lebih canggih yang mendukung format musik yang tidak dapat didekode oleh Apple Music, seperti DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV, dan lain-lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un motore di riproduzione più potente che supporta formati musicali che Apple Music non è in grado di decodificare, come DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV, ecc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DSD (DSF、DFF)、DTS、APE、OGG、OPUS、WMA、S3M、TTA、MOD、WV など、Apple Music がデコードできない音楽形式をサポートする、より強力なプレーヤー エンジンです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DSD(DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV 등 Apple Music에서 디코딩할 수 없는 음악 형식을 지원하는 더욱 강력한 플레이어 엔진입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enjin pemain yang lebih berkuasa yang menyokong format muzik yang Apple Music tidak boleh menyahkod, seperti DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV dll."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um mecanismo de reprodução mais poderoso que suporta formatos de música que o Apple Music não consegue decodificar, como DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV, etc."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um motor de reprodução mais poderoso que suporta formatos de música que o Apple Music não consegue descodificar, como DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV, etc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более мощный движок проигрывателя, поддерживающий музыкальные форматы, которые Apple Music не может декодировать, такие как DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV и т. д."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เครื่องมือเล่นเพลงที่ทรงพลังยิ่งขึ้นที่รองรับรูปแบบเพลงที่ Apple Music ไม่สามารถถอดรหัสได้ เช่น DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV เป็นต้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music'in çözemediği DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV gibi müzik formatlarını destekleyen daha güçlü bir oynatıcı motoru."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một công cụ phát nhạc mạnh mẽ hơn hỗ trợ các định dạng nhạc mà Apple Music không giải mã được, chẳng hạn như DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV, v.v."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更强大的播放器引擎，支持Apple Music也无法解码的音乐格式。如：DSD(DSF、DFF)、DTS、APE、OGG、OPUS、WMA、S3M、TTA、MOD、WV等等"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更強大的播放器引擎，支援Apple Music也無法解碼的音樂格式。如：DSD(DSF、DFF)、DTS、APE、OGG、OPUS、WMA、S3M、TTA、MOD、WV等等"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更強大嘅播放器引擎，支援 Apple Music 亦解碼唔到嘅音樂格式。如： DSD （ DSF 、 DFF ）、 DTS 、 APE 、 OGG 、 OPUS 、 WMA 、 S3M 、 TTA 、 MOD 、 WV 等等"
          }
        }
      }
    },
