    "Go beyond basic tags—edit covers and lyrics too. Organizing music has never been easier!" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخطى العلامات الأساسية وحرّر الأغلفة والكلمات. تنظيم الموسيقى بات غاية في السهولة!"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ves més enllà de les etiquetes bàsiques: edita també portades i lletres. Organitzar la música mai no havia estat tan fàcil!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejen základní tagy—upravujte i obaly a texty. Organizace hudby nebyla nikdy snazší!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå ud over grundlæggende tags—rediger også omslag og tekster. Musikorganisering er blevet helt enkelt!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr als nur Basis-Tags: Bearbeiten Sie auch Cover und Songtexte. Musik organisieren, so einfach geht’s!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεπεράστε τις βασικές ετικέτες—επεξεργαστείτε εξώφυλλα και στίχους. Η οργάνωση μουσικής έγινε απλή!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit artwork and lyrics as well as basic tags, and make organizing your music easier."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit artwork and lyrics as well as basic tags, and make organising your music easier."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit artwork and lyrics as well as basic tags, and make organising your music easier."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit artwork and lyrics as well as basic tags, and make organising your music easier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve más allá de las etiquetas básicas: edita también portadas y letras. ¡Organizar tu música es así de simple!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve más allá de las etiquetas básicas: edita también portadas y letras. ¡Organizar tu música es así de simple!"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve más allá de las etiquetas básicas: edita también portadas y letras. ¡Organizar tu música es así de simple!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuta muutakin kuin perustageja—muokkaa myös kansia ja sanoituksia. Musiikin järjestely on näin helppoa!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allez au-delà des tags de base : modifiez aussi les pochettes et paroles. Organiser sa musique devient si simple !"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allez au-delà des tags de base : modifiez aussi les pochettes et paroles. Organiser sa musique devient si simple !"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לערוך גם עטיפות ומילים, מעבר לתגיות הבסיסיות. סידור המוזיקה מעולם לא היה קל יותר!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेसिक टैग से आगे बढ़ें—कवर और लिरिक्स भी एडिट करें। म्यूजिक ऑर्गनाइज करना अब हुआ बिल्कुल आसान!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadiđite osnovne oznake—uređujte omote i tekstove. Organizacija glazbe nikada nije bila lakša!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lépjen túl az alaptageken—szerkesszen borítókat és dalszövegeket is. A zenerendszerezés ilyen egyszerű!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih dari sekadar tag dasar—edit juga sampul dan lirik. Mengatur musik jadi semudah ini!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai oltre i tag di base: modifica anche copertine e testi. Organizzare la musica non è mai stato così semplice!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本タグだけでなく、カバーアートや歌詞も編集可能。音楽整理が、これまでにないほど簡単に！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 태그는 물론, 커버와 가사까지 편집해 보세요. 음악 정리, 이제 정말 간단해집니다!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih daripada sekadar tag asas—edit juga sampul dan lirik. Mengatur muzik jadi semudah ini!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå lenger enn grunnleggende tags—rediger også omslag og tekster. Musikkorganisering har aldri vært enklere!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga verder dan basistags—bewerk ook hoezen en songteksten. Muziek ordenen was nog nooit zo eenvoudig!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyjdź poza podstawowe tagi—edytuj też okładki i teksty. Organizacja muzyki jeszcze nigdy nie była tak prosta!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vá além dos tags básicos: edite também capas e letras. Organizar suas músicas nunca foi tão simples!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vá além dos tags básicos: edite também capas e letras. Organizar as suas músicas nunca foi tão simples!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treci dincolo de taguri de bază—editează coperți și versuri. Organizarea muzicii e atât de simplă!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не только базовые теги: редактируйте обложки и тексты. Организовать музыку—проще, чем кажется!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nielen základné tagy—upravujte aj obaly a texty. Organizácia hudby nebola nikdy jednoduchšia!"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojdite dlje od osnovnih oznak – urejajte tudi naslovnice in besedila. Organiziranje glasbe še nikoli ni bilo lažje!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå bortom grundläggende taggar—redigera även omslag och låttexter. Musikorganisering har aldrig varit enklare!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก้าวไปอีกขั้น—แก้ไขปกและเนื้อเพลงได้ตามใจชอบ การจัดระเบียบเพลงจึงเป็นเรื่องง่ายนิดเดียว!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temel etiketlerin ötesine geçin; kapakları ve sözleri de düzenleyin. Müzik düzenlemek hiç bu kadar kolay olmamıştı!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не лише базові теги: редагуйте обкладинки та тексти. Організувати музику—простіше, ніж здається!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không chỉ là các tag cơ bản—bạn còn sửa được cả bìa và lời nhạc. Quản lý nhạc chưa bao giờ dễ dàng đến thế!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不只编辑基础标签，还能修改封面和歌词，让整理音乐更轻松。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不只編輯基本標籤，還能修改封面和歌詞，讓整理音樂更輕鬆。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不只編輯基本標籤，還能修改封面和歌詞，讓整理音樂更輕鬆。"
