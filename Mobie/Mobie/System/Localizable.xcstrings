    "Audio sample is too short or invalid for fingerprinting. The duration is insufficient for acoustic analysis. Please edit it manually." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عينة الصوت قصيرة جداً أو غير صالحة للبصمة الصوتية. المدة غير كافية للتحليل الصوتي. يرجى التعديل يدوياً."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mostra d'àudio és massa curta o no és vàlida per a l'empremta. La durada és insuficient per a l'anàlisi acústica. Editeu manualment."
          }
        },
        "cs" : {
          "stringUnit" : {
