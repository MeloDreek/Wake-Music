    "Turn off this switch if the last 3 seconds of the original video do not contain the advertisement sound" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بإيقاف تشغيل هذا المفتاح إذا كانت آخر 3 ثوانٍ من الفيديو الأصلي لا تحتوي على صوت الإعلان"
          }
        },
        "de" : {
