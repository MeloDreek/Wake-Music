    "Cached paths have been cleared. To avoid repeated operations, please move your frequently used files to the system【Music】 or 【Wake Music】folder." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم مسح مسارات التخزين المؤقت. لتجنب التكرار، يُرجى نقل الملفات المستخدمة بكثرة إلى مجلد الموسيقى أو Wake Music في النظام.\n\n"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache-Pfade wurden gelöscht. Um wiederholte Vorgänge zu vermeiden, verschieben Sie häufig verwendete Dateien bitte in den Systemordner Musik oder Wake Music."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cached paths have been cleared. To avoid repeated operations, please move your frequently used files to the system【Music】 or 【Wake Music】folder."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cached paths have been cleared. To avoid repeated operations, please move your frequently used files to the system【Music】 or 【Wake Music】folder."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cached paths have been cleared. To avoid repeated operations, please move your frequently used files to the system【Music】 or 【Wake Music】folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las rutas en caché han sido eliminadas. Para evitar operaciones repetitivas, mueve tus archivos habituales a la carpeta Música o Wake Music del sistema."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las rutas en caché fueron borradas. Para evitar hacer esto repetidamente, mueve tus archivos más usados a la carpeta Música o Wake Music del sistema."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cached paths have been cleared. To avoid repeating this step, move frequently used files to the Music or Wake Music folder on your system."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cache des chemins a été vidé. Pour éviter de répéter cette opération, déplacez vos fichiers fréquemment utilisés dans le dossier Musique ou Wake Music du système."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chemins mis en cache ont été effacés. Pour éviter de devoir répéter l’opération, veuillez déplacer vos fichiers fréquemment utilisés dans le dossier Musique ou Wake Music."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैश किए गए पथ साफ़ कर दिए गए हैं। बार-बार ऑपरेशन से बचने के लिए, कृपया अपनी अक्सर इस्तेमाल की जाने वाली फ़ाइलों को सिस्टम 【म्यूजिक】 या 【Wake Music】 फ़ोल्डर में ले जाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalur cache telah dihapus. Untuk menghindari operasi berulang, silakan pindahkan file yang sering Anda gunakan ke folder sistem 【Music】 atau 【Wake Music】."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I percorsi nella cache sono stati cancellati. Per evitare operazioni ripetitive, sposta i file che usi più spesso nella cartella Musica o Wake Music del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャッシュされたパスはクリアされました。操作の繰り返しを避けるため、よく使うファイルはシステムのミュージックまたはWake Musicフォルダに移動してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캐시된 경로가 삭제되었습니다. 반복 작업을 피하려면 자주 사용하는 파일을 시스템의 음악 또는 Wake Music 폴더로 이동해 주세요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laluan cache telah dikosongkan. Untuk mengelakkan operasi berulang, sila alihkan fail anda yang kerap digunakan ke folder 【Muzik】 atau 【Muzik Bangun】."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os caminhos em cache foram limpos. Para evitar operações repetidas, mova os arquivos usados com frequência para a pasta Música ou Wake Music do sistema."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os caminhos em cache foram limpos. Para evitar repetições, mova os ficheiros que usa frequentemente para a pasta Música ou Wake Music do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кэшированные пути очищены. Чтобы избежать повторных действий, переместите часто используемые файлы в системную папку Музыка или Wake Music.\n\n"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เส้นทางแคชได้รับการล้างแล้ว เพื่อหลีกเลี่ยงการดำเนินการซ้ำ โปรดย้ายไฟล์ที่คุณใช้บ่อยไปยังโฟลเดอร์ Music หรือ 【Wake Music】 ของระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önbellek yolları temizlendi. Tekrarlayan işlemleri önlemek için sık kullandığınız dosyaları sistemin Müzik veya Wake Music klasörüne taşıyın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các đường dẫn bộ nhớ đệm đã được xóa. Để tránh thao tác lặp lại, hãy chuyển các tệp bạn thường dùng vào thư mục Nhạc hoặc Wake Music của hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缓存的路径已清空，为了避免重复操作，请将常用的文件移动到系统的【音乐】或【Wake Music】文件夹"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路徑快取已清除。為避免重複操作，請將常用檔案移動到系統的【音樂】或【Wake Music】資料夾"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路徑快取已清除。為免重複操作，請將常用的檔案移動到系統的【音樂】或【Wake Music】資料夾"
          }
        }
      }
    },
