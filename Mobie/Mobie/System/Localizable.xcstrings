        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До кожного сервісу можна підключити лише один обліковий запис. Щоб використати інший, спершу від’єднайте поточне підключення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi dịch vụ chỉ có thể kết nối một tài khoản. Hãy xóa kết nối hiện tại trước khi thêm tài khoản khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
