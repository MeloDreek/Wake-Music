    "115 Drive does not support streaming DSF or DFF files. Download them to your device to play them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يدعم 115 Drive تشغيل ملفات DSF أو DFF عبر الإنترنت. نزّلها إلى جهازك لتشغيلها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "115 Drive no permet reproduir fitxers DSF o DFF en línia. Descarrega’ls al dispositiu per reproduir-los."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "115 Drive nepodporuje streamování souborů DSF ani DFF. Pro přehrávání je stáhněte do zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "115 Drive understøtter ikke streaming af DSF- eller DFF-filer. Download dem til din enhed for at afspille dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
