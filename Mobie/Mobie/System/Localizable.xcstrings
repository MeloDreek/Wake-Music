        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glazbene oznake (ID3 metapodaci) odnose se na metapodatke trajno ugrađene u audio datoteke, uključujući: omot, tekst pjesme, naslov, izvođača, naziv albuma, godinu izdanja, glazbeni žanr, brzinu uzorkovanja, brzinu prijenosa i više."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
