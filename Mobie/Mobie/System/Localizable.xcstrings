    "Purchase.RemoteAccessMessage" : {
      "comment" : "Premium upgrade guidance. Premium guidance shown before opening the paywall for remote services; describes current functionality only.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بالترقية إلى Premium لتوصيل مساحات التخزين السحابي وأجهزة NAS وخوادم الموسيقى وتشغيل موسيقاك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa a Premium per connectar els teus espais al núvol, dispositius NAS i servidors de música i reproduir la teva música."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejděte na Premium a připojte cloudová úložiště, NAS a hudební servery, abyste mohli přehrávat svou hudbu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
