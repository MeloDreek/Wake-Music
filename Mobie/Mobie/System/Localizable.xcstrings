{
  "sourceLanguage" : "en",
  "strings" : {
    "Onboarding.Connect.Body": {
      "comment": "Welcome onboarding. Feature/premium presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط وحدات التخزين السحابي وخوادم NAS. موسيقاك معك أينما كنت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecta els teus espais al núvol i servidors NAS. La teva música, siguis on siguis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte cloudová úložiště a servery NAS. Vaše hudba, ať jste kdekoli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilslut dit cloudlager og dine NAS-servere. Din musik, hvor du end er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Cloud-Speicher und NAS-Server. Deine Musik, wo immer du bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέστε χώρους cloud και διακομιστές NAS. Η μουσική σας, όπου κι αν είστε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your cloud drives and NAS servers. Your music, wherever you are."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your cloud drives and NAS servers. Your music, wherever you are."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your cloud drives and NAS servers. Your music, wherever you are."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your cloud drives and NAS servers. Your music, wherever you are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tus unidades en la nube y servidores NAS. Tu música, estés donde estés."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tus unidades en la nube y servidores NAS. Tu música, estés donde estés."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tus unidades en la nube y servidores NAS. Tu música, estés donde estés."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä pilvitallennustilasi ja NAS-palvelimesi. Musiikkisi kulkee mukanasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez vos espaces cloud et serveurs NAS. Votre musique, où que vous soyez."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez vos espaces cloud et serveurs NAS. Votre musique, où que vous soyez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חברו כונני ענן ושרתי NAS. המוזיקה שלכם, בכל מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने क्लाउड ड्राइव और NAS सर्वर जोड़ें। आपका संगीत, जहाँ भी आप हों।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povežite pohranu u oblaku i NAS poslužitelje. Vaša glazba, gdje god bili."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakoztasd felhőtárhelyeidet és NAS-szervereidet. A zenéd, bárhol is vagy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan penyimpanan cloud dan server NAS Anda. Musik Anda, di mana pun Anda berada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega cloud e server NAS. La tua musica, ovunque tu sia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドストレージや NAS に接続。好きな音楽を、どこにいても。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 드라이브와 NAS에 연결하세요. 어디서든 자유롭게 음악을 즐기세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan storan awan dan pelayan NAS anda. Muzik anda, di mana-mana sahaja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til skylagring og NAS-servere. Musikken din, uansett hvor du er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind je cloudopslag en NAS-servers. Je muziek, waar je ook bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz dyski w chmurze i serwery NAS. Twoja muzyka, gdziekolwiek jesteś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte suas nuvens e servidores NAS. Sua música, onde você estiver."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue os seus serviços de nuvem e servidores NAS. A sua música, onde quer que esteja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează spațiile cloud și serverele NAS. Muzica ta, oriunde te-ai afla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключайте облачные диски и NAS-серверы. Ваша музыка — где бы вы ни были."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojte cloudové úložiská a servery NAS. Vaša hudba, nech ste kdekoľvek."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povežite shrambe v oblaku in strežnike NAS. Vaša glasba, kjer koli ste."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut molnlagring och NAS-servrar. Din musik, var du än är."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อคลาวด์ไดรฟ์และเซิร์ฟเวอร์ NAS ฟังเพลงของคุณได้อย่างอิสระทุกที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulut sürücülerinizi ve NAS sunucularınızı bağlayın. Müziğiniz, nerede olursanız olun yanınızda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключайте хмарні диски та NAS-сервери. Ваша музика — де б ви не були."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối ổ đĩa đám mây và máy chủ NAS. Âm nhạc của bạn, ở bất cứ đâu."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "連接雲端硬碟與 NAS 伺服器，自由聽歌，就是這麼簡單。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接网盘与 NAS 服务器，听歌自由，就是这么简单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接雲端硬碟與 NAS 伺服器，自由聽歌，就是這麼簡單。"
          }
        }
      }
    },
    "Onboarding.Equalizer.Body": {
      "comment": "Welcome onboarding. Feature/premium presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محرك صوت يدعم جميع الصيغ، ومعادل صوت بعشرة نطاقات. اضبط الصوت على ذوقك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un motor d’àudio multiformat i un equalitzador de 10 bandes. El so a la teva mida."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvukový engine pro všechny formáty a 10pásmový ekvalizér. Zvuk podle vás."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En lydmotor til alle formater og en 10-bånds equalizer. Lyd på din måde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Audio-Engine für alle Formate. Ein 10-Band-Equalizer. Dein persönlicher Klang."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μηχανή ήχου για όλες τις μορφές και ισοσταθμιστής 10 ζωνών. Ήχος στα μέτρα σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An all-format audio engine. A 10-band equalizer. Sound shaped around you."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "An all-format audio engine. A 10-band equalizer. Sound shaped around you."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "An all-format audio engine. A 10-band equalizer. Sound shaped around you."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "An all-format audio engine. A 10-band equalizer. Sound shaped around you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un motor de audio multiformato y un ecualizador de 10 bandas. El sonido, a tu medida."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un motor de audio multiformato y un ecualizador de 10 bandas. El sonido, a tu medida."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Un motor de audio multiformato y un ecualizador de 10 bandas. El sonido, a tu medida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikkia formaatteja tukeva äänimoottori ja 10-kaistainen taajuuskorjain. Sinun näköisesi ääni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un moteur audio multiformat et un égaliseur à 10 bandes. Un son à votre image."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un moteur audio multiformat et un égaliseur à 10 bandes. Un son à votre image."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנוע שמע לכל הפורמטים ואקולייזר עם 10 תחומים. צליל שמתאים לכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी फ़ॉर्मैट के लिए ऑडियो इंजन और 10-बैंड इक्वलाइज़र। आवाज़, आपकी पसंद की।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvučni sustav za sve formate i 10-pojasni ekvilizator. Zvuk po vašoj mjeri."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden formátumot támogató hangmotor és 10 sávos hangszínszabályzó. Hangzás a te ízlésed szerint."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesin audio untuk semua format dan equalizer 10 band. Suara sesuai selera Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un motore audio multiformato e un equalizzatore a 10 bande. Il suono, come piace a te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全形式対応の音声エンジンと10バンドイコライザーで、あなた好みの音に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 형식을 지원하는 오디오 엔진과 10밴드 이퀄라이저로 나만의 사운드를 완성하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjin audio untuk semua format dan penyama 10 jalur. Bunyi mengikut cita rasa anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En lydmotor for alle formater og en 10-bånds equalizer. Lyd slik du liker den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een audio-engine voor alle formaten en een 10-bands equalizer. Geluid zoals jij het wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Silnik audio obsługujący wszystkie formaty i 10-pasmowy korektor. Dźwięk dopasowany do Ciebie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mecanismo de áudio multiformato e um equalizador de 10 bandas. O som do seu jeito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um motor de áudio multiformato e um equalizador de 10 bandas. O som à sua medida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un motor audio pentru toate formatele și un egalizator cu 10 benzi. Sunet pe gustul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудиодвижок для всех форматов и 10-полосный эквалайзер. Настройте звук под себя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvukový engine pre všetky formáty a 10-pásmový ekvalizér. Zvuk podľa vás."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvočni pogon za vse formate in 10-pasovni izenačevalnik. Zvok po vaši meri."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ljudmotor för alla format och en 10-bands equalizer. Ljud på ditt sätt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอนจินเสียงที่รองรับทุกฟอร์แมต พร้อมอีควอไลเซอร์ 10 แบนด์ ปรับเสียงในแบบที่คุณชอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm formatları destekleyen ses motoru ve 10 bantlı ekolayzer. Zevkinize göre ses."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіорушій для всіх форматів і 10-смуговий еквалайзер. Налаштуйте звук під себе."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ máy âm thanh đa định dạng và bộ cân bằng 10 băng tần. Âm thanh theo cách của bạn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "全格式音訊引擎，配搭 10 段等化器，調出您的專屬好聲音。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全格式音频引擎，搭配 10 段均衡器，调出您的专属好声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全格式音訊引擎，搭配 10 段等化器，調出您的專屬好聲音。"
          }
        }
      }
    },
    "Onboarding.Fingerprint.Body": {
      "comment": "Welcome onboarding. Feature/premium presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرّف على أغانيك وضمّن بياناتها الوصفية في الملفات. ابنِ مجموعة تستمتع بها دون إنترنت وتحتفظ بها لسنوات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifica les cançons i integra’n les metadades als fitxers. Crea una col·lecció sense connexió que perduri."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznávejte skladby a vkládejte metadata do souborů. Vytvořte si offline sbírku na dlouhá léta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genkend sange, og indlejr metadata i filerne. Skab en offlinesamling, der holder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkenne Songs und bette ihre Metadaten ein. Für eine Offline-Sammlung, die bleibt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναγνωρίστε τραγούδια και ενσωματώστε τα μεταδεδομένα στα αρχεία. Δημιουργήστε μια συλλογή εκτός σύνδεσης που διαρκεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identify your songs and embed their metadata. Build an offline collection that lasts."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Identify your songs and embed their metadata. Build an offline collection that lasts."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Identify your songs and embed their metadata. Build an offline collection that lasts."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Identify your songs and embed their metadata. Build an offline collection that lasts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifica tus canciones e integra sus metadatos en los archivos. Crea una colección sin conexión que perdure."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifica tus canciones e integra sus metadatos en los archivos. Crea una colección sin conexión que perdure."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifica tus canciones e integra sus metadatos en los archivos. Crea una colección sin conexión que perdure."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnista kappaleet ja tallenna metatiedot tiedostoihin. Rakenna offline-kokoelma, joka kestää aikaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiez vos morceaux et intégrez leurs métadonnées aux fichiers. Une collection hors ligne à garder longtemps."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiez vos morceaux et intégrez leurs métadonnées aux fichiers. Une collection hors ligne à garder longtemps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהו שירים והטמיעו את המטא־נתונים בקבצים. בנו אוסף להאזנה ללא חיבור שיישאר איתכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गाने पहचानें और उनका मेटाडेटा फ़ाइलों में सहेजें। एक ऐसा ऑफ़लाइन संग्रह बनाएँ जो हमेशा साथ रहे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznajte pjesme i ugradite metapodatke u datoteke. Izgradite trajnu izvanmrežnu zbirku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azonosítsd a dalokat, és ágyazd be metaadataikat a fájlokba. Építs maradandó offline gyűjteményt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenali lagu dan sematkan metadatanya ke dalam file. Bangun koleksi offline yang tahan lama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifica i brani e incorpora i metadati nei file. Crea una raccolta offline da conservare nel tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲を識別し、メタデータをファイルに保存。ずっと大切にできるオフラインコレクションへ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곡을 식별하고 메타데이터를 파일에 저장하세요. 오래 간직할 오프라인 컬렉션을 만들어 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenal pasti lagu dan benamkan metadatanya dalam fail. Bina koleksi luar talian untuk disimpan lama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenkjenn sanger og bygg inn metadata i filene. Lag en frakoblet samling som varer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herken nummers en sla metadata op in de bestanden. Bouw een offline collectie die blijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznawaj utwory i zapisuj metadane w plikach. Stwórz kolekcję offline na lata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifique músicas e incorpore os metadados aos arquivos. Crie uma coleção offline para guardar por muito tempo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifique músicas e incorpore os metadados nos ficheiros. Crie uma coleção offline para guardar ao longo do tempo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifică melodiile și încorporează metadatele în fișiere. Creează o colecție offline de păstrat în timp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавайте песни и встраивайте метаданные в файлы. Создайте офлайн-коллекцию на долгие годы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznávajte skladby a vkladajte metadáta do súborov. Vytvorte si offline zbierku na dlhé roky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznajte skladbe in vdelajte metapodatke v datoteke. Ustvarite trajno zbirko za poslušanje brez povezave."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiera låtar och bädda in metadata i filerna. Bygg en offlinesamling som håller."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุเพลงและฝังข้อมูลเมตาลงในไฟล์ สร้างคลังเพลงออฟไลน์ที่เก็บไว้ได้ยาวนาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkıları tanıyın ve meta verilerini dosyalara gömün. Kalıcı bir çevrimdışı koleksiyon oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнавайте пісні та вбудовуйте метадані у файли. Створіть офлайн-колекцію на довгі роки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận diện bài hát và nhúng siêu dữ liệu vào tệp. Xây dựng bộ sưu tập ngoại tuyến để lưu giữ lâu dài."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "辨識歌曲並將中繼資料永久寫入檔案，讓離線收藏歷久常新。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别歌曲并将元数据永久写入文件，让离线收藏历久弥新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "辨識歌曲並將中繼資料永久寫入檔案，讓離線收藏歷久彌新。"
          }
        }
      }
    },
