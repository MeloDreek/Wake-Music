    "MusicServer.ExitConfirmation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي الخروج إلى العودة إلى الوضع الكلاسيكي وإيقاف الأغنية الحالية مؤقتًا. هل تريد المتابعة؟"
