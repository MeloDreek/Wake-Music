    "Download.PreDownloadHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنزيل الأغنية التالية تلقائيًا إلى مجلد الموسيقى الرئيسي للاستماع دون اتصال. يستهلك بيانات الشبكة ومساحة الجهاز."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarrega automàticament la cançó següent a la carpeta principal de Música per escoltar-la sense connexió. Consumeix dades i espai al dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky stáhne další skladbu do hlavní složky Hudba pro poslech offline. Využívá síťová data a úložiště zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download automatisk næste sang til hovedmappen Musik til offlineafspilning. Bruger netværksdata og lagerplads på enheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt den nächsten Titel automatisch in den Musik-Hauptordner zum Offline-Hören. Verbraucht Datenvolumen und Gerätespeicher."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτόματη λήψη του επόμενου τραγουδιού στον κύριο φάκελο Μουσικής για ακρόαση εκτός σύνδεσης. Χρησιμοποιεί δεδομένα και χώρο αποθήκευσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically download the next song to the Music home folder for offline listening. Uses network data and device storage."
          }
        },
        "en-AU" : {
