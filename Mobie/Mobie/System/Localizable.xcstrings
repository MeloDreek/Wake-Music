        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès SMB refusé. Vérifiez les identifiants et les autorisations du dossier partagé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגישה ל-SMB נדחתה. יש לבדוק שם משתמש, סיסמה והרשאות לתיקייה המשותפת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB पहुँच अस्वीकृत। उपयोगकर्ता नाम, पासवर्ड और साझा फ़ोल्डर की अनुमतियाँ जाँचें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB pristup odbijen. Provjerite korisničko ime, lozinku i dopuštenja dijeljene mape."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
