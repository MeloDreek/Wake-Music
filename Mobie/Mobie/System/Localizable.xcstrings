    "Yandex.PermissionDenied" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رُفض الوصول إلى Yandex Disk. أعد الاتصال واسمح بقراءة معلومات القرص والملفات. إذا استمر الخطأ، تحقق من أذونات التطبيق للقراءة فقط في إعدادات Yandex OAuth."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accés a Yandex Disk denegat. Torna a connectar-te i permet l’accés a la informació del disc i als fitxers. Si persisteix, comprova els permisos de només lectura de l’app a Yandex OAuth."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup k Yandex Disk byl zamítnut. Připojte se znovu a povolte přístup k informacím o disku a souborům. Pokud chyba přetrvá, ověřte oprávnění aplikace pouze ke čtení v nastavení Yandex OAuth."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til Yandex Disk blev nægtet. Tilslut igen, og tillad adgang til diskoplysninger og filer. Hvis fejlen fortsætter, kontroller appens læsetilladelser i Yandex OAuth-indstillingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yandex Disk-Zugriff verweigert. Erneut verbinden und Zugriff auf Laufwerksinformationen und Dateien erlauben. Bei weiteren Fehlern die Leseberechtigungen der App in Yandex OAuth prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόσβαση στο Yandex Disk απορρίφθηκε. Συνδεθείτε ξανά και επιτρέψτε πρόσβαση σε πληροφορίες δίσκου και αρχεία. Αν επιμένει, ελέγξτε τα δικαιώματα μόνο ανάγνωσης της εφαρμογής στις ρυθμίσεις Yandex OAuth."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yandex Disk access was denied. Reconnect and allow access to disk information and files. If this persists, check the app's read-only permissions in Yandex OAuth settings."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yandex Disk access was denied. Reconnect and allow access to disk information and files. If this persists, check the app's read-only permissions in Yandex OAuth settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yandex Disk access was denied. Reconnect and allow access to disk information and files. If this persists, check the app's read-only permissions in Yandex OAuth settings."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yandex Disk access was denied. Reconnect and allow access to disk information and files. If this persists, check the app's read-only permissions in Yandex OAuth settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso a Yandex Disk denegado. Reconecta y permite acceso a la información del disco y a los archivos. Si persiste, revisa los permisos de solo lectura de la app en Yandex OAuth."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso a Yandex Disk denegado. Reconecta y permite acceso a la información del disco y a los archivos. Si persiste, revisa los permisos de solo lectura de la app en Yandex OAuth."
          }
