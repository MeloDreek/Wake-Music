        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga música de tu servidor remoto y reprodúcela sin conexión para maximizar tu experiencia musical"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez de la musique depuis votre serveur distant et écoutez-la hors ligne pour maximiser votre expérience musicale"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez de la musique à partir de votre serveur distant et écoutez-la hors ligne pour maximiser votre expérience musicale"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने रिमोट सर्वर से संगीत डाउनलोड करें और अपने संगीत अनुभव को अधिकतम करने के लिए इसे ऑफ़लाइन चलाएं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unduh musik dari server jarak jauh Anda dan putar secara offline untuk memaksimalkan pengalaman musik Anda"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica la musica dal tuo server remoto e riproducila offline per massimizzare la tua esperienza musicale"
          }
        },
