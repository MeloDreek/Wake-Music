    "Album covers after parsing of local music files, you can reuse these images to quickly fill music files with missing covers." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هنا صور الأغلفة المستخرجة من ملفات الموسيقى المحلية. يمكنك استخدامها لإضافة أغلفة إلى ملفات موسيقى أخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquestes portades s’han extret dels fitxers de música locals. Pots reutilitzar-les per afegir ràpidament les portades que falten."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zde najdete obaly načtené z místních hudebních souborů. Můžete je použít k doplnění chybějících obalů u dalších skladeb."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her finder du coverbilleder hentet fra dine lokale musikfiler. Brug dem til at tilføje manglende covers til andre sange."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Cover wurden aus lokalen Musikdateien ausgelesen. Du kannst sie wiederverwenden, um fehlende Cover schnell zu ergänzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εδώ εμφανίζονται εξώφυλλα από τα τοπικά αρχεία μουσικής σας. Χρησιμοποιήστε τα για να προσθέσετε εξώφυλλα σε άλλα τραγούδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artwork extracted from your local music appears here. Reuse it to add covers to other music files."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artwork extracted from your local music appears here. Reuse it to add covers to other music files."
          }
        },
        "en-GB" : {
          "stringUnit" : {
