    "Turn off this switch if the last 3 seconds of the original video do not contain the advertisement sound" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كانت آخر 3 ثوان من الفيديو الأصلي لا تحتوي على صوت إعلاني ، فيرجى إيقاف تشغيل هذا المفتاح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si els darrers 3 segons del vídeo original no contenen so publicitari, desactiveu aquest interruptor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud poslední 3 sekundy původního videa neobsahují reklamní zvuk, vypněte tento vypínač."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis de sidste 3 sekunder af den originale video ikke indeholder reklamelyd, skal du slukke for denne kontakt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die letzten 3 Sekunden des Originalvideos keinen Werbeton enthalten, schalten Sie bitte diesen Schalter aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εάν τα τελευταία 3 δευτερόλεπτα του αρχικού βίντεο δεν περιέχουν διαφημιστικό ήχο, απενεργοποιήστε αυτόν τον διακόπτη."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off this switch if the last 3 seconds of the original video do not contain the advertisement sound"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off this switch if the last 3 seconds of the original video do not contain the advertisement sound"
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off this switch if the last 3 seconds of the original video do not contain the advertisement sound"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si los últimos 3 segundos del video original no contienen sonido publicitario, apague este interruptor."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si los últimos 3 segundos del video original no contienen sonido publicitario, apague este interruptor."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si los últimos 3 segundos del video original no contienen sonido publicitario, apague este interruptor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos alkuperäisen videon viimeiset 3 sekuntia eivät sisällä mainosääntä, kytke tämä kytkin pois päältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si les 3 dernières secondes de la vidéo d’origine ne contiennent pas de son publicitaire, veuillez désactiver cet interrupteur."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si les 3 dernières secondes de la vidéo originale ne contiennent pas de son publicitaire, veuillez éteindre ce commutateur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם 3 השניות האחרונות של הסרטון המקורי אינן מכילות צליל פרסום, כבה מתג זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि मूल वीडियो के अंतिम 3 सेकंड में विज्ञापन ध्वनि नहीं है, तो कृपया इस स्विच को बंद कर दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako posljednje 3 sekunde izvornog videozapisa ne sadrže reklamni zvuk, isključite ovaj prekidač."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha az eredeti videó utolsó 3 másodperce nem tartalmaz reklámhangot, kérjük, kapcsolja ki ezt a kapcsolót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika 3 detik terakhir video asli tidak berisi suara iklan, matikan sakelar ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se gli ultimi 3 secondi del video originale non contengono suoni pubblicitari, disattivare questo interruttore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のビデオの最後の3秒に広告音が含まれていない場合は、このスイッチをオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 동영상의 마지막 3초에 광고음이 포함되어 있지 않은 경우 이 스위치를 끄십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika 3 saat terakhir video asal tidak mengandungi bunyi pengiklanan, sila matikan suis ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis de siste 3 sekundene av den originale videoen ikke inneholder reklamelyd, må du slå av denne bryteren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de laatste 3 seconden van de originele video geen reclamegeluid bevatten, zet deze schakelaar dan uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli ostatnie 3 sekundy oryginalnego filmu nie zawierają dźwięku reklamowego, wyłącz ten przełącznik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se os últimos 3 segundos do vídeo original não contiverem som publicitário, desligue esta opção."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se os últimos 3 segundos do vídeo original não contiverem som publicitário, desligue este interruptor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă ultimele 3 secunde ale videoclipului original nu conțin sunet publicitar, vă rugăm să opriți acest comutator."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если последние 3 секунды оригинального видео не содержат рекламного звука, пожалуйста, выключите этот переключатель."
          }
        },
        "sk" : {
          "stringUnit" : {
