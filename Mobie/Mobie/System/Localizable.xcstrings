    "Download music from your remote server and play it offline to maximize your music experience." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتنزيل الموسيقى من الخادم البعيد الخاص بك وتشغيلها دون اتصال بالإنترنت لتحسين تجربة الموسيقى الخاصة بك"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laden Sie Musik von Ihrem Remote-Server herunter und spielen Sie sie offline ab, um Ihr Musikerlebnis zu maximieren"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download music from your remote server and play it offline to maximize your music experience."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download music from your remote server and play it offline to maximize your music experience."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download music from your remote server and play it offline to maximize your music experience."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga música de tu servidor remoto y reprodúcela sin conexión para maximizar tu experiencia musical"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga música de tu servidor remoto y reprodúcela sin conexión para maximizar tu experiencia musical"
