        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "온라인 매칭은 오디오 파일 이름이나 내장된 곡 제목, 아티스트 이름, 재생 시간에 크게 의존하므로, 규격에 맞지 않는 요소가 하나라도 있으면 잘못된 커버 이미지와 가사가 매칭될 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padanan dalam talian bergantung pada nama fail audio atau maklumat tajuk, artis dan tempoh lagu dalam fail. Maklumat yang tidak standard boleh menyebabkan padanan kulit album atau lirik yang salah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onlinematching er sterkt avhengig av lydfilnavnene dine eller innebygde titler, artistnavn og sportider. Et hvilket som helst ustandardisert element kan føre til feil coverbilde og sangtekster."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online matchen is erg afhankelijk van uw audiobestandsnamen of ingesloten titels, artiestennamen en tijdsduur. Elk afwijkend element kan leiden tot verkeerde albumhoezen en songteksten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopasowywanie online w dużej mierze zależy od nazw plików audio lub osadzonych tytułów, wykonawców i czasu trwania. Każdy niestandardowy element może prowadzić do dopasowania błędnych okładek i tekstów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A correspondência online depende muito dos nomes dos seus arquivos de áudio ou dos títulos, nomes de artistas e durações incorporados. Qualquer elemento fora do padrão pode levar à correspondência incorreta de capas e letras."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A correspondência online depende muito dos nomes dos seus ficheiros de áudio ou dos títulos, nomes de artistas e durações incorporados. Qualquer elemento fora do padrão pode levar à correspondência incorreta de capas e letras."
