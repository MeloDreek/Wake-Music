        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’audio lossy utilizza una compressione maggiore per ridurre le dimensioni del file, a scapito della qualità audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非可逆圧縮音源は高い圧縮率でファイルサイズを小さくする代わりに、音質が低下します。"
