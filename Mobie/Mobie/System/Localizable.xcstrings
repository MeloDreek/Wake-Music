        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquee todas las funciones Premium al precio más bajo de la historia. Los futuros aumentos de precio o ajustes a un modelo de suscripción exclusiva tampoco te afectarán."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquee todas las funciones Premium al precio más bajo de la historia. Los futuros aumentos de precio o ajustes a un modelo de suscripción exclusiva tampoco te afectarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouillez toutes les fonctionnalités premium au prix le plus bas jamais pratiqué pour les premiers inscrits ! Les futures augmentations de prix ou le passage à un modèle d'abonnement ne vous affecteront pas non plus !"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouillez toutes les fonctionnalités premium au prix le plus bas jamais pratiqué pour les premiers inscrits ! Les futures augmentations de prix ou le passage à un modèle d'abonnement ne vous affecteront pas non plus !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी प्रीमियम सुविधाओं को अब तक की सबसे कम शुरुआती कीमत पर अनलॉक करें! भविष्य में मूल्य वृद्धि या केवल सदस्यता के लिए समायोजन भी आपके लाभों को प्रभावित नहीं करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka semua fitur premium dengan harga early bird terendah sepanjang masa! Kenaikan harga di masa depan atau penyesuaian pada langganan eksklusif juga tidak akan memengaruhi manfaat Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sbloccate tutte le funzioni premium al prezzo più basso di sempre! I futuri aumenti di prezzo o gli adeguamenti del solo abbonamento non influiscono sui vostri vantaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去最安の早期割引価格ですべてのプレミアム機能をご利用いただけます！ 今後の値上げやサブスクリプション・モデルへの変更も影響ありません！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "역대 최저가 얼리버드 가격으로 모든 프리미엄 기능을 이용하세요! 향후 가격 인상이나 구독 전용 상품 가격 조정은 현재 혜택에 영향을 미치지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka kunci semua ciri premium pada harga early bird yang paling rendah! Kenaikan harga masa hadapan atau pelarasan pada langganan sahaja juga tidak menjejaskan faedah anda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueie todos os recursos premium pelo preço mais baixo de todos os tempos! Futuros aumentos de preço ou ajustes para um modelo somente de assinatura também não o afetarão!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueie todos os recursos premium pelo preço mais baixo de todos os tempos! Futuros aumentos de preço ou ajustes para um modelo somente de assinatura também não o afetarão!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "разблокируйте все премиум функции по исторически низкой цене раннего доступа! Будущие повышения цен или переход на модель подписки не повлияют на ваши права!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปลดล็อกคุณสมบัติพรีเมียมทั้งหมดด้วยราคาพิเศษสุด! การเพิ่มราคาในอนาคตหรือการปรับราคาสำหรับการสมัครสมาชิกเท่านั้นจะไม่ส่งผลต่อสิทธิประโยชน์ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdiye kadarki en düşük erken rezervasyon fiyatıyla tüm premium özelliklerin kilidini açın! Gelecekteki fiyat artışları veya yalnızca abonelik modeline geçiş sizi de etkilemeyecek!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở khóa tất cả các tính năng cao cấp với mức giá sớm nhất trong lịch sử! Việc tăng giá trong tương lai hoặc điều chỉnh chỉ thành chế độ đăng ký cũng không ảnh hưởng đến quyền lợi của bạn!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以历史最低的早鸟价解锁所有高级功能！未来涨价或调整为仅订阅模式也不影响您的权益!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以歷史最低的早鳥價解鎖所有高級功能！未來漲價或調整為僅訂閱模式也不影響您的權益!"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
