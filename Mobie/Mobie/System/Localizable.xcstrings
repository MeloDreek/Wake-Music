          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu 3 giây cuối của video gốc không chứa âm thanh quảng cáo, vui lòng tắt nút chuyển này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
