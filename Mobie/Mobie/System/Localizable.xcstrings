    "Failed to embed some tags. The file might be corrupted. Try editing manually or replacing it with a new file." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تضمين بعض الوسوم. قد يكون الملف تالفًا. جرّب تعديلها يدويًا أو استبدال الملف بآخر جديد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’han pogut incrustar algunes etiquetes. Pot ser que el fitxer estigui malmès. Prova d’editar-lo manualment o substitueix-lo per un fitxer nou."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vložení některých tagů selhalo. Soubor může být poškozen. Zkuste jej upravit ručně nebo jej nahraďte novým souborem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indlejring af nogle tags mislykkedes. Filen kan være beskadiget. Prøv at redigere manuelt eller erstat den med en ny fil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Tags konnten nicht eingebettet werden. Die Datei ist möglicherweise beschädigt. Versuche, sie manuell zu bearbeiten, oder ersetze sie durch eine neue Datei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποτυχία ενσωμάτωσης ορισμένων ετικετών. Το αρχείο ενδέχεται να είναι κατεστραμμένο. Δοκιμάστε χειροκίνητη επεξεργασία ή αντικατάσταση."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
