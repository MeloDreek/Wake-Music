          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Audioprobe ist zu kurz oder ungültig für das Fingerprinting. Die Dauer reicht für eine akustische Analyse nicht aus. Bitte manuell bearbeiten."
