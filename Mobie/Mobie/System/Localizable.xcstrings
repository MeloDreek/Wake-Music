    "Please make sure the current device is connected to the same Wi-Fi as your computer or Android phone, and keep the screen on during transmission❗️" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرجى التأكد من أن الجهاز الحالي متصل بنفس شبكة Wi-Fi مثل جهاز الكمبيوتر أو هاتف Android ، وعدم إيقاف تشغيل الشاشة ❗️ أثناء الإرسال"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assegureu-vos que el dispositiu actual estigui connectat a la mateixa Wi-Fi que el vostre ordinador o telèfon Android i no apagueu la pantalla ❗️ durant la transmissió"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujistěte se, že je aktuální zařízení připojeno ke stejné síti Wi-Fi jako váš počítač nebo telefon se systémem Android, a během přenosu nevypínejte obrazovku ❗️"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
