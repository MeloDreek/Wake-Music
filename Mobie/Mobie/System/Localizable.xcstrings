          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fișierul poate fi corupt sau într-un format neacceptat. Se recomandă înlocuirea cu fișiere MP3, Flac, M4A sau WAV standard. Puteți consulta întrebările frecvente sau trimite un raport."
