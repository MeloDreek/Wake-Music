          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Box 请求失败，请检查网络连接及账号访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Box 請求失敗，請檢查網路連線及帳號存取權限。"
