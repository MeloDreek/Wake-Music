        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Match metadata via audio fingerprinting in mere minutes. Automatically batch edit your music and permanently embed missing integral music tags including cover art, lyrics, title, artist, album, genre, year, and comments."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Match song details via audio fingerprinting technology within minutes. Automatically batch edit your music and permanently embed missing music covers, lyrics, titles, artists, albums, tracks genres, years, or notes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincula metadatos mediante huella digital de audio en pocos minutos. Edita automáticamente tu música en lote e incrusta permanentemente etiquetas que falten como portadas, letras, título, artista, álbum, género, año o comentarios."
          }
        },
        "es-419" : {
          "stringUnit" : {
