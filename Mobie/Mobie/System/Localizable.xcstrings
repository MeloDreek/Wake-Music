    "If you think we are not bad, please give us a 5 star rating or recommend it to your friends. Thank you for your support!" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كنت تعتقد أننا نقوم بعمل جيد ، فيرجى تزويدنا بمراجعة 5 نجوم أو التوصية بها لأصدقائك. شكرا لدعمكم!"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si creieu que estem fent una bona feina, feu-nos una ressenya de 5 estrelles o recomaneu-la als vostres amics. Gràcies pel vostre suport!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud si myslíte, že odvádíme dobrou práci, dejte nám prosím 5hvězdičkovou recenzi nebo ji doporučte svým přátelům. Děkujeme za vaši podporu!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du synes, vi gør et godt stykke arbejde, så giv os en 5-stjernet anmeldelse eller anbefal den til dine venner. Tak for din støtte!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie der Meinung sind, dass wir einen guten Job machen, geben Sie uns bitte eine 5-Sterne-Bewertung oder empfehlen Sie es Ihren Freunden. Vielen Dank für Ihre Unterstützung!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν νομίζετε ότι κάνουμε καλή δουλειά, δώστε μας μια κριτική 5 αστέρων ή προτείνετε την στους φίλους σας. Σας ευχαριστούμε για την υποστήριξή σας!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enjoying Wakemusic? Give us a 5-star rating or recommend it to a friend. Thank you for your support!"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enjoying Wakemusic? Give us a 5-star rating or recommend it to a friend. Thank you for your support!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enjoying Wakemusic? Give us a 5-star rating or recommend it to a friend. Thank you for your support!"
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enjoying Wakemusic? Give us a 5-star rating or recommend it to a friend. Thank you for your support!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si crees que estamos haciendo un buen trabajo, danos una reseña de 5 estrellas o recomiéndalo a tus amigos. ¡Gracias por su apoyo!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si crees que estamos haciendo un buen trabajo, danos una reseña de 5 estrellas o recomiéndalo a tus amigos. ¡Gracias por su apoyo!"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si crees que estamos haciendo un buen trabajo, danos una reseña de 5 estrellas o recomiéndalo a tus amigos. ¡Gracias por su apoyo!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos teemme mielestäsi hyvää työtä, anna meille 5 tähden arvostelu tai suosittele sitä ystävillesi. Kiitos tuestasi!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous pensez que nous faisons du bon travail, donnez-nous un avis 5 étoiles ou recommandez-le à vos amis. Merci pour votre soutien !"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous pensez que nous faisons du bon travail, veuillez nous donner un avis 5 étoiles ou le recommander à vos amis. Merci pour votre soutien !"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם אתה חושב שאנחנו עושים עבודה טובה, אנא תן לנו ביקורת של 5 כוכבים או המלץ עליה לחבריך. תודה על תמיכתך!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आपको लगता है कि हम अच्छा काम कर रहे हैं, तो कृपया हमें 5-स्टार समीक्षा दें या अपने दोस्तों को इसकी अनुशंसा करें। आपके समर्थन के लिए धन्यवाद!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako mislite da radimo dobar posao, dajte nam recenziju s 5 zvjezdica ili je preporučite svojim prijateljima. Hvala vam na podršci!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha úgy gondolja, hogy jó munkát végzünk, kérjük, írjon nekünk egy 5 csillagos értékelést, vagy ajánlja barátainak. Köszönjük a támogatást!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika menurut Anda kami melakukan pekerjaan dengan baik, beri kami ulasan bintang 5 atau rekomendasikan kepada teman-teman Anda. Terima kasih atas dukungan Anda!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pensi che stiamo facendo un buon lavoro, ti preghiamo di darci una recensione a 5 stelle o di consigliarla ai tuoi amici. Grazie per il vostro supporto!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを気に入っていただけたら、星5つの評価やお友達への紹介で応援していただけるとうれしいです。いつもありがとうございます！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 마음에 드셨다면 별 5개 평가를 남기거나 친구에게 추천해 주세요. 응원해 주셔서 감사합니다!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika anda fikir kami melakukan kerja yang baik, sila beri kami ulasan 5 bintang atau mengesyorkannya kepada rakan anda. Terima kasih atas sokongan anda!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du synes vi gjør en god jobb, vennligst gi oss en 5-stjerners anmeldelse eller anbefal den til vennene dine. Takk for støtten!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je denkt dat we het goed doen, geef ons dan een 5-sterrenrecensie of beveel het aan bij je vrienden. Bedankt voor je steun!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli uważasz, że robimy dobrą robotę, daj nam 5 gwiazdek lub poleć to swoim znajomym. Dziękujemy za wsparcie!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você acha que estamos fazendo um bom trabalho, por favor, dê-nos uma avaliação de 5 estrelas ou recomende-a aos seus amigos. Obrigado pelo seu apoio!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você acha que estamos fazendo um bom trabalho, por favor, dê-nos uma avaliação de 5 estrelas ou recomende-a aos seus amigos. Obrigado pelo vosso apoio!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă credeți că facem o treabă bună, vă rugăm să ne dați o recenzie de 5 stele sau să o recomandați prietenilor dvs. Vă mulțumim pentru sprijin!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы считаете, что мы делаем хорошую работу, пожалуйста, оставьте нам 5-звездочный отзыв или порекомендуйте его своим друзьям. Спасибо за вашу поддержку!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak si myslíte, že robíme dobrú prácu, dajte nám 5-hviezdičkovú recenziu alebo ju odporučte svojim priateľom. Ďakujeme za podporu!"
