    "This specific audio format is not supported for fingerprinting. We highly recommend using modern popular formats such as FLAC, M4A, WAV, or MP3. Please edit manually." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنسيق الصوت هذا غير مدعوم حالياً للبصمة الصوتية. نوصي باستيراد التنسيقات الشائعة الحديثة مثل FLAC أو M4A أو WAV أو MP3. يرجى التعديل يدوياً."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest format d’àudio no admet la identificació per empremta acústica. Et recomanem fer servir FLAC, M4A, WAV o MP3. Edita les metadades manualment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento audio formát není pro rozpoznávání otisků podporován. Doporučujeme importovat moderní populární formáty jako FLAC, M4A, WAV nebo MP3. Upravte data ručně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette lydformat understøttes ikke til fingeraftryk. Vi anbefaler at importere moderne, populære formater som FLAC, M4A, WAV eller MP3. Rediger venligst manuelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Audioformat wird für das Fingerprinting nicht unterstützt. Wir empfehlen den Import moderner, gängiger Formate wie FLAC, M4A, WAV oder MP3. Bitte manuell bearbeiten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η μορφή ήχου δεν υποστηρίζεται για αναγνώριση αποτυπώματος. Συνιστούμε την εισαγωγή σύγχρονων δημοφιλών μορφών όπως FLAC, M4A, WAV ή MP3. Παρακαλώ επεξεργαστείτε χειροκίνητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio fingerprinting is not available for this format. Try a common format such as FLAC, M4A, WAV, or MP3, or edit the tags manually."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
