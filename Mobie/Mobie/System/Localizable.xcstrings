          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de ahorro de energía actualiza las letras con menos frecuencia para reducir el uso de la CPU y el consumo de batería. Desactívalo para que se actualicen más a menudo."
          }
        },
