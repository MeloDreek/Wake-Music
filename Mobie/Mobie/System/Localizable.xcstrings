    "Import once, auto-match hundreds of songs. Batch automation has never been this efficient." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استورد مرة واحدة، وطابق مئات الأغاني تلقائيًا. الأتمتة الجماعية أصبحت أكثر كفاءة!"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa una vegada i enllaça centenars de cançons. L'automatització en lot mai ha estat tan eficient!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importujte jednou, automaticky doplňte stovky skladeb. Hromadná automatizace nebyla nikdy efektivnější!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importer én gang, match automatisk hundredvis af sange. Batch-automatisering har aldrig været så effektiv!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal importieren, Hunderte von Songs automatisch abgleichen. Batch-Automatisierung war nie effizienter!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισαγάγετε μία φορά, αντιστοιχίστε εκατοντάδες τραγούδια. Η μαζική αυτοματοποίηση έγινε αποδοτική!"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import once, auto-match hundreds of songs. Batch automation has never been this efficient."
          }
