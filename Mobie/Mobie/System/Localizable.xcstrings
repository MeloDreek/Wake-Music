    "Get lifetime access at the lowest price — unlock all feature on iOS and macOS!" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احصل على عضوية دائمة بأقل سعر متاح الآن، وافتح جميع الميزات على iOS وmacOS!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werden Sie jetzt zum günstigsten Preis dauerhaftes Mitglied und schalten Sie alle Funktionen auf iOS und macOS frei!"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Become a lifetime member at the lowest price available now and unlock all features on iOS and macOS!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Become a lifetime member at the lowest available discount and unlock all features on iOS and macOS!"
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Become a lifetime member at the lowest available discounted price and unlock all features on iOS and macOS!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazte miembro de por vida al precio con descuento más bajo disponible y desbloquea todas las funciones en iOS y macOS."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazte miembro de por vida al precio más bajo disponible y desbloquea todas las funciones en iOS y macOS."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazte miembro de por vida al precio más bajo disponible y desbloquea todas las funciones en iOS y macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devenez membre à vie au prix réduit le plus bas du moment et débloquez toutes les fonctionnalités sur iOS et macOS !"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devenez membre à vie au prix réduit le plus bas en ce moment et débloquez toutes les fonctionnalités sur iOS et macOS !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे कम उपलब्ध डिस्काउंट मूल्य पर लाइफटाइम सदस्य बनें और iOS तथा macOS की सभी सुविधाएँ अनलॉक करें!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jadilah anggota seumur hidup dengan harga diskon terendah saat ini dan buka semua fitur di iOS dan macOS!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diventa membro a vita al prezzo scontato più basso disponibile ora e sblocca tutte le funzioni su iOS e macOS!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今だけの最安値で永久メンバーになり、iOS と macOS の全機能を解放しましょう！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 제공되는 최저 할인 가격으로 평생 멤버가 되어 iOS와 macOS의 모든 기능을 잠금 해제하세요!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jadi ahli seumur hidup pada harga diskaun terendah sekarang dan buka semua ciri di iOS dan macOS!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torne-se um membro vitalício pelo menor preço promocional disponível agora e desbloqueie todos os recursos no iOS e macOS!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torne-se membro vitalício pelo preço com desconto mais baixo disponível agora e desbloqueie todas as funcionalidades no iOS e macOS!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Станьте пожизненным участником по самой низкой текущей цене и откройте все функции на iOS и macOS!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นสมาชิกตลอดชีพในราคาส่วนลดที่ต่ำที่สุดตอนนี้ และปลดล็อกทุกฟีเจอร์บน iOS และ macOS!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anda mevcut en düşük indirimli fiyatla ömür boyu üye olun ve iOS ile macOS'teki tüm özelliklerin kilidini açın!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trở thành hội viên trọn đời với mức giá ưu đãi thấp nhất hiện tại và mở khóa mọi tính năng trên iOS và macOS!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以当前最低的折扣价成为永久会员，解锁iOS、macOS上的所有功能！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以目前最低的優惠價格成為永久會員，解鎖 iOS、macOS 上的所有功能！"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以目前最低折扣價成為永久會員，解鎖 iOS、macOS 上的所有功能！"
