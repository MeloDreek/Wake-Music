    "Customize your experience with features like theme colors and music player skins." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خصّص تجربتك باستخدام ميزات مثل ألوان السمات وواجهات مشغل الموسيقى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalitza la teva experiència amb funcions com els colors del tema i les aparences del reproductor de música."
