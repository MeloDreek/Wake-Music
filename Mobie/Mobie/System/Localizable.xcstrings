    "Unable to open document. Text encoding Unicode (UTF-8 and GBK) is not applicable." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر قراءة ملف كلمات الأغاني. تأكد من أنه غير فارغ ويستخدم ترميز UTF-8 أو GBK."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut llegir el fitxer de lletres. Comprova que no sigui buit i que faci servir la codificació UTF-8 o GBK."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor s textem nelze přečíst. Ověřte, že není prázdný a používá kódování UTF-8 nebo GBK."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangtekstfilen kan ikke læses. Kontrollér, at den ikke er tom og bruger UTF-8- eller GBK-kodning."
