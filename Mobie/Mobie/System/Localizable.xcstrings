    "Complete music tag editor that supports parsing and editing embedded music tags such as title, artist, album, cover, lyrics, etc." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محرر شامل لوسوم الملفات الصوتية، يدعم تحليل وتحرير الوسوم المدمجة مثل العنوان، الفنان، الألبوم، صورة الغلاف، الكلمات وغير ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein vollständiger Musik-Tag-Editor, der das Auslesen und Bearbeiten eingebetteter Tags wie Titel, Künstler, Album, Cover, Songtexte usw. unterstützt."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complete music tag editor that supports parsing and editing embedded music tags such as title, artist, album, cover, lyrics, etc."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complete music tag editor that supports parsing and editing embedded music tags such as title, artist, album, cover, lyrics, etc."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complete music tag editor that supports parsing and editing embedded music tags such as title, artist, album, cover, lyrics, etc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor completo de etiquetas de música, con soporte para analizar y editar metadatos incrustados como el título, el artista, el álbum, la carátula, las letras, entre otros."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un editor de etiquetas musicales completo, compatible con la lectura y edición de etiquetas embebidas como título, artista, álbum, carátula, letras, entre otros."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor de etiquetas de música completo, permite leer y editar los metadatos integrados como título, artista, álbum, portada, letras y más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éditeur complet de tags musicaux, prenant en charge l’analyse et la modification des métadonnées intégrées comme le titre, l’artiste, l’album, la pochette, les paroles, etc."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éditeur complet de tags musicaux, prenant en charge l’analyse et la modification des métadonnées intégrées comme le titre, l’artiste, l’album, la pochette, les paroles, etc."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूर्ण संगीत टैग संपादक जो शीर्षक, कलाकार, एल्बम, कवर, गीत आदि जैसे एम्बेडेड संगीत टैग को पार्स करने और संपादित करने का समर्थन करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor tag musik lengkap yang mendukung pemrosesan dan pengeditan tag musik tertanam seperti judul, artis, album, sampul, lirik, dll. Penghapusan Lengkap"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un editor completo di tag musicali, in grado di analizzare e modificare i metadati incorporati come titolo, artista, album, copertina, testi e altro ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトル、アーティスト、アルバム、ジャケット、歌詞などの埋め込みタグを解析・編集できる、完全な音楽タグエディタです"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제목, 아티스트, 앨범, 커버, 가사 등 내장된 음악 태그를 분석하고 편집할 수 있는 완전한 태그 편집기입니다."
