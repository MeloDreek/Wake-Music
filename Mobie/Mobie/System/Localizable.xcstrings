          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB-luku epäonnistui. Pidä palvelin hereillä, yhdistä samaan verkkoon ja tarkista osoite sekä oikeudet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture SMB impossible. Gardez le serveur éveillé, connectez-vous au même réseau et vérifiez l’adresse et les autorisations."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
