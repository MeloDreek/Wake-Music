    "Regular lossless audio, which loses a small amount of audio data during compression, typically has a sample rate of 44.1kHz, 48.1kHz, or 96kHz." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحافظ الصوت دون فقدان الجودة على جميع بيانات الصوت الأصلية. تشمل معدلات العينات الشائعة 44.1 و48 و96 كيلوهرتز."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’àudio sense pèrdues conserva totes les dades de l’àudio original. Les freqüències de mostreig habituals inclouen 44,1, 48 i 96 kHz."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezztrátový zvuk zachovává všechna původní zvuková data. Běžné vzorkovací frekvence jsou 44,1, 48 a 96 kHz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabsfri lyd bevarer alle de oprindelige lyddata. Almindelige samplingsfrekvenser er 44,1, 48 og 96 kHz."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlustfreies Audio erhält alle ursprünglichen Audiodaten. Gängige Abtastraten sind 44,1, 48 und 96 kHz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο ήχος χωρίς απώλειες διατηρεί όλα τα αρχικά δεδομένα ήχου. Συνήθεις ρυθμοί δειγματοληψίας είναι τα 44,1, 48 και 96 kHz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lossless audio preserves all of the original audio data. Common sample rates include 44.1, 48, and 96 kHz."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lossless audio preserves all of the original audio data. Common sample rates include 44.1, 48, and 96 kHz."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lossless audio preserves all of the original audio data. Common sample rates include 44.1, 48, and 96 kHz."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lossless audio preserves all of the original audio data. Common sample rates include 44.1, 48, and 96 kHz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio sin pérdida conserva todos los datos del audio original. Algunas frecuencias de muestreo habituales son 44,1, 48 y 96 kHz."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio sin pérdida conserva todos los datos del audio original. Algunas frecuencias de muestreo habituales son 44,1, 48 y 96 kHz."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio sin pérdida conserva todos los datos del audio original. Algunas frecuencias de muestreo habituales son 44,1, 48 y 96 kHz."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Häviötön ääni säilyttää kaiken alkuperäisen äänidatan. Tavallisia näytteenottotaajuuksia ovat 44,1, 48 ja 96 kHz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’audio sans perte conserve toutes les données audio d’origine. Les fréquences d’échantillonnage courantes comprennent 44,1, 48 et 96 kHz."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’audio sans perte conserve toutes les données audio d’origine. Les fréquences d’échantillonnage courantes comprennent 44,1, 48 et 96 kHz."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמע ללא אובדן איכות שומר על כל נתוני השמע המקוריים. קצבי דגימה נפוצים כוללים 44.1, 48 ו-96 קילו-הרץ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉसलेस ऑडियो मूल ऑडियो डेटा को पूरी तरह बनाए रखता है। आम सैंपल रेट में 44.1, 48 और 96 kHz शामिल हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvuk bez gubitaka čuva sve izvorne zvučne podatke. Uobičajene frekvencije uzorkovanja su 44,1, 48 i 96 kHz."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A veszteségmentes hang minden eredeti hangadatot megőriz. Gyakori mintavételi frekvencia a 44,1, 48 és 96 kHz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio lossless mempertahankan seluruh data audio asli. Laju sampel yang umum meliputi 44,1, 48, dan 96 kHz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’audio lossless conserva tutti i dati audio originali. Le frequenze di campionamento più comuni includono 44,1, 48 e 96 kHz."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロスレス音声は、元の音声データをすべて保持します。一般的なサンプルレートには44.1kHz、48kHz、96kHzなどがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무손실 오디오는 원래 오디오 데이터를 모두 보존합니다. 일반적인 샘플레이트로는 44.1, 48, 96kHz 등이 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio tanpa kehilangan mengekalkan semua data audio asal. Kadar sampel lazim termasuk 44.1, 48 dan 96 kHz."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapsfri lyd bevarer alle de opprinnelige lyddataene. Vanlige samplingsfrekvenser er 44,1, 48 og 96 kHz."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lossless audio behoudt alle oorspronkelijke audiogegevens. Veelgebruikte samplefrequenties zijn 44,1, 48 en 96 kHz."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dźwięk bezstratny zachowuje wszystkie oryginalne dane audio. Typowe częstotliwości próbkowania to 44,1, 48 i 96 kHz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O áudio sem perdas preserva todos os dados do áudio original. As taxas de amostragem mais comuns incluem 44,1, 48 e 96 kHz."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O áudio sem perdas preserva todos os dados do áudio original. As taxas de amostragem comuns incluem 44,1, 48 e 96 kHz."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunetul fără pierderi păstrează toate datele audio originale. Frecvențele de eșantionare uzuale includ 44,1, 48 și 96 kHz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звук без потерь сохраняет все исходные аудиоданные. Распространённые частоты дискретизации — 44,1, 48 и 96 кГц."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezstratový zvuk zachováva všetky pôvodné zvukové údaje. Bežné vzorkovacie frekvencie sú 44,1, 48 a 96 kHz."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvok brez izgub ohrani vse izvirne zvočne podatke. Pogoste frekvence vzorčenja so 44,1, 48 in 96 kHz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förlustfritt ljud bevarar alla ursprungliga ljuddata. Vanliga samplingsfrekvenser är 44,1, 48 och 96 kHz."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงแบบไม่สูญเสียข้อมูลจะเก็บข้อมูลเสียงต้นฉบับไว้ทั้งหมด อัตราการสุ่มตัวอย่างที่ใช้ทั่วไป ได้แก่ 44.1, 48 และ 96 kHz"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıpsız ses, orijinal ses verilerinin tamamını korur. Yaygın örnekleme hızları arasında 44,1, 48 ve 96 kHz bulunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звук без втрат зберігає всі початкові аудіодані. Поширені частоти дискретизації — 44,1, 48 і 96 кГц."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm thanh không mất dữ liệu giữ nguyên toàn bộ dữ liệu âm thanh gốc. Tần số lấy mẫu phổ biến gồm 44,1, 48 và 96 kHz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无损音频会保留原始音频的全部数据，常见采样率包括 44.1、48 和 96 kHz。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無損音訊會保留原始音訊的所有資料，常見取樣率包括 44.1、48 和 96 kHz。"
