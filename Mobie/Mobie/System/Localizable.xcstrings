    "Lossy audio, with a higher compression rate, smaller file size, but sacrifices a significant amount of sound quality." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صوت ضائع، بمعدل ضغط أعلى، وحجم ملف أصغر، ولكنه يضحي بقدر كبير من جودة الصوت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlustbehaftetes Audio mit höherer Kompressionsrate, kleinerer Dateigröße, aber auf Kosten der Klangqualität"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lossy audio, with a higher compression rate, smaller file size, but sacrifices a significant amount of sound quality."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lossy audio, with a higher compression rate, smaller file size, but sacrifices a significant amount of sound quality."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lossy audio, with a higher compression rate, smaller file size, but sacrifices a significant amount of sound quality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio con pérdidas, con una tasa de compresión más alta, tamaño de archivo más pequeño, pero sacrificando una gran cantidad de calidad de sonido."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio con pérdidas, con una tasa de compresión más alta, tamaño de archivo más pequeño, pero sacrificando una gran cantidad de calidad de sonido."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio con pérdidas, con una tasa de compresión más alta, tamaño de archivo más pequeño, pero sacrificando una gran cantidad de calidad de sonido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio avec perte, ayant un taux de compression plus élevé, une taille de fichier plus petite, mais sacrifiant une grande partie de la qualité sonore."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio avec perte, ayant un taux de compression plus élevé, une taille de fichier plus petite, mais sacrifiant une grande partie de la qualité sonore."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हानिपूर्ण ऑडियो, उच्च संपीड़न दर, छोटे फ़ाइल आकार के साथ, लेकिन ध्वनि की गुणवत्ता का एक महत्वपूर्ण हिस्सा बलिदान करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio lossy, dengan tingkat kompresi yang lebih tinggi, ukuran file yang lebih kecil, tetapi mengorbankan kualitas suara yang signifikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'audio lossy, con un tasso di compressione più elevato, riduce le dimensioni del file, ma sacrifica una quantità significativa di qualità del suono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロス音声、圧縮率が高く、ファイルサイズが小さいが、音質が大幅に犠牲になっています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손실 오디오는 압축률이 높고 파일 크기가 작지만 음질이 크게 저하됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio yang hilang, dengan kadar mampatan yang lebih tinggi, saiz fail yang lebih kecil, tetapi mengorbankan sejumlah besar kualiti bunyi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áudio com perdas, com uma taxa de compressão mais alta, tamanho de arquivo menor, mas sacrificando uma grande quantidade de qualidade de som."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áudio com perdas, com uma taxa de compressão mais alta, tamanho de arquivo menor, mas sacrificando uma grande quantidade de qualidade de som."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сжатый аудиофайл с потерями, с более высоким коэффициентом сжатия, меньшим размером файла, но с значительной потерей качества звука."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีการสูญเสียเสียง โดยมีอัตราการบีบอัดที่สูงกว่า ขนาดไฟล์ที่เล็กกว่า แต่ก็ต้องแลกมาด้วยคุณภาพเสียงที่ลดลงอย่างมาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıplı ses, daha yüksek bir sıkıştırma oranına sahip, daha küçük dosya boyutu ile ancak ses kalitesinden önemli bir kısmı feda eder"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm thanh có mất chất lượng, với tỷ lệ nén cao, kích thước tệp nhỏ hơn, nhưng hy sinh một lượng lớn chất lượng âm thanh."
          }
        },
        "zh-Hans" : {
