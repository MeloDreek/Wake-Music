        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heu connectat correctament un servei al núvol! Actualitzeu a Premium per sbloccar l'agregació multinúvol i connectar serveis il·limitats (WebDAV, Navidrome i unitats) sense problemes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úspěšně jste připojili cloudovou službu! Přejděte na Premium, odemkněte agregaci více cloudů a připojte neomezené množství cloudových služeb (WebDAV, Navidrome a disky)."
