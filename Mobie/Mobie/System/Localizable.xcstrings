      }
    },
    "Use only the All-Format Audio Engine for decoding. It can parse embedded artwork and lyrics from remote files and supports all music formats, including DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV, and more." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
