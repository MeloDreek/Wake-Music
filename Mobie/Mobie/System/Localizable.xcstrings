        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het songtekstbestand kan niet worden gelezen. Controleer of het niet leeg is en de tekstcodering UTF-8 of GBK gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można odczytać pliku tekstu piosenki. Upewnij się, że nie jest pusty i używa kodowania UTF-8 lub GBK."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o arquivo de letras. Verifique se ele não está vazio e se usa a codificação UTF-8 ou GBK."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o ficheiro de letras. Verifique se não está vazio e se utiliza a codificação UTF-8 ou GBK."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fișierul de versuri nu poate fi citit. Asigurați-vă că nu este gol și că folosește codarea UTF-8 sau GBK."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать файл текста песни. Убедитесь, что он не пуст и использует кодировку UTF-8 или GBK."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Súbor s textom sa nedá prečítať. Overte, že nie je prázdny a používa kódovanie UTF-8 alebo GBK."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoteke z besedilom ni mogoče prebrati. Preverite, da ni prazna in da uporablja kodiranje UTF-8 ali GBK."
