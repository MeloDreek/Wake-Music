    "EQ.PremiumPrompt" : {
      "comment" : "Shown before the Premium paywall when a free user attempts to edit EQ; opening and browsing the EQ page remain free.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رقِّ إلى Premium لفتح جميع إعدادات المعادل وضبط النطاقات العشرة والمضخم الأولي. يمكنك أيضًا مواصلة استكشاف الصفحة قبل الترقية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa a Premium per desbloquejar tots els preajustos d’EQ, l’ajust de 10 bandes i el preamplificador. També pots continuar explorant abans de decidir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejděte na Premium a odemkněte všechny předvolby EQ, ladění 10 pásem a předzesilovač. Než se rozhodnete, můžete stránku dál procházet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opgrader til Premium for at låse op for alle EQ-forudindstillinger, 10-båndsjustering og forforstærkeren. Du kan også kigge videre, før du beslutter dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Premium schaltest du alle EQ-Presets, die 10-Band-Abstimmung und den Vorverstärker frei. Du kannst dich auch erst weiter umsehen, bevor du ein Upgrade machst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναβαθμίστε σε Premium για όλες τις προρυθμίσεις EQ, ρύθμιση 10 ζωνών και έλεγχο προενισχυτή. Μπορείτε επίσης να συνεχίσετε την περιήγηση πριν αποφασίσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upgrade to Premium to unlock all EQ presets, 10-band tuning, and preamp control. You can also keep exploring before upgrading."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upgrade to Premium to unlock all EQ presets, 10-band tuning, and preamp control. You can also keep exploring before upgrading."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upgrade to Premium to unlock all EQ presets, 10-band tuning, and preamp control. You can also keep exploring before upgrading."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upgrade to Premium to unlock all EQ presets, 10-band tuning, and preamp control. You can also keep exploring before upgrading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pásate a Premium para desbloquear todos los preajustes EQ, el ajuste de 10 bandas y el preamplificador. También puedes seguir explorando antes de decidir."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
