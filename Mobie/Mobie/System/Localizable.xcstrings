    "System memory is insufficient to process this audio file. This is usually due to temporary high system overhead. Please edit it manually." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ذاكرة النظام غير كافية لمعالجة ملف الصوت هذا. يرجع هذا عادةً إلى زيادة العبء المؤقت على النظام. يرجى التعديل يدوياً."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La memòria del sistema és insuficient per processar aquest fitxer d'àudio. Això se sol deure a una sobrecàrrega temporal del sistema. Editeu manualment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systémová paměť je pro zpracování tohoto audio souboru nedostatečná. To je obvykle způsobeno dočasným vysokým zatížením systému. Upravte data ručně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemhukommelsen er utilstrækkelig til at behandle denne lydfil. Dette skyldes normalt midlertidig høj systembelastning. Rediger venligst manuelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Systemarbeitsspeicher reicht nicht aus, um diese Audiodatei zu verarbeiten. Dies liegt meist an einer vorübergehenden hohen Systemauslastung. Bitte manuell bearbeiten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μνήμη του συστήματος δεν επαρκεί για την επεξεργασία αυτού του αρχείου ήχου. Αυτό οφείλεται συνήθως σε προσωρινή υψηλή επιβάρυνση του συστήματος. Παρακαλώ επεξεργαστείτε χειροκίνητα."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
