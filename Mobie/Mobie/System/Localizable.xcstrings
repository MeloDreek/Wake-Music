      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hann FFT من 4096 نقطة · قمم القنوات. لا يكفي الطيف وحده لإثبات جودة الصوت دون فقدان."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
