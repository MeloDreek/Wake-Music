        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso SMB denegado. Revisa el usuario, la contraseña y los permisos de la carpeta compartida."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
