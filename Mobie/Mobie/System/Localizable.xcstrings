    "Unlock all premium features at the lowest ever early bird price! Future price increases or adjustments to the subscription-only also do not affect your benefits." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح جميع الميزات المميزة بأقل سعر على الإطلاق! لا تؤثر الزيادات المستقبلية في الأسعار أو التعديلات على الاشتراك فقط على مزاياك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalten Sie alle Premium-Funktionen zum niedrigsten Frühbucherpreis aller Zeiten frei! Zukünftige Preiserhöhungen oder Anpassungen an ein reines Abonnementmodell werden Sie nicht betreffen!"
          }
        },
        "en-AU" : {
          "stringUnit" : {
