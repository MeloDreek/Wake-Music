    "Purchase records is associated with the Apple Account you are currently signed in to on your device" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتبط سجلات الشراء بحساب Apple المسجل دخوله حاليًا على جهازك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els registres de compres estan associats al compte d'Apple connectat actualment al dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záznamy o nákupech jsou propojeny s účtem Apple, k němuž jste na zařízení aktuálně přihlášeni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Købshistorik er tilknyttet den Apple-konto, der i øjeblikket er logget ind på din enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaufnachweise sind mit dem Apple-Konto verknüpft, das derzeit auf Ihrem Gerät angemeldet ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ιστορικό αγορών συνδέεται με τον λογαριασμό Apple που είναι συνδεδεμένος στη συσκευή σας."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purchase records is associated with the Apple Account you are currently signed in to on your device"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purchase records is associated with the Apple Account you are currently signed in to on your device"
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purchase records is associated with the Apple Account you are currently signed in to on your device"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial de compras está asociado a la cuenta de Apple con la que has iniciado sesión en el dispositivo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros de compra están asociados a la cuenta de Apple iniciada actualmente en tu dispositivo."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros de compra están asociados a la cuenta de Apple iniciada actualmente en tu dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostotiedot liitetään Apple-tiliin, jolle olet tällä hetkellä kirjautuneena laitteellasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les achats sont associés au compte Apple actuellement connecté sur votre appareil."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les achats sont associés au compte Apple actuellement connecté sur votre appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רשומות הרכישה קשורות לחשבון ה-Apple שמחובר כעת במכשיר שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खरीदारी के रिकॉर्ड आपके डिवाइस पर वर्तमान में साइन इन किए गए Apple अकाउंट से जुड़े हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisi o kupnji povezani su s Apple računom koji je trenutno prijavljen na vašem uređaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vásárlási előzmények a készülékén jelenleg bejelentkezett Apple-fiókhoz kapcsolódnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riwayat pembelian dikaitkan dengan Akun Apple yang saat ini masuk di perangkat Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronologia acquisti associata all'account Apple attualmente connesso sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入履歴は、現在デバイスにサインインしているAppleアカウントに紐付けられています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매 기록은 현재 기기에 로그인된 Apple 계정에 연결되어 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekod pembelian dikaitkan dengan Akaun Apple yang log masuk semasa pada peranti anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjøpshistorikk er knyttet til Apple-kontoen som for øyeblikket er logget på enheten din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aankoopgegevens zijn gekoppeld aan het Apple Account dat momenteel op je apparaat is ingelogd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekordy zakupów są powiązane z kontem Apple, na które jesteś obecnie zalogowany na urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os registros de compras estão associados à Conta Apple conectada no momento em seu dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
