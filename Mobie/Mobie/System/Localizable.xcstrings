    "Even with a million songs in your library, your device storage stays free. No API required—Wakemusic can display embedded album artwork and lyrics directly from remote files." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ بمجموعتك الموسيقية في السحابة ووفّر مساحة على جهازك. يستطيع محرك الصوت الداعم لجميع التنسيقات قراءة الأغلفة وكلمات الأغاني المضمّنة مباشرةً من ملفات الموسيقى البعيدة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desa la teva col·lecció de música al núvol i estalvia espai al dispositiu. El motor d’àudio multiformat pot llegir les portades i les lletres incrustades directament dels fitxers de música remots."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložte hudební sbírku do cloudu a ušetřete místo v zařízení. Zvukový modul pro všechny formáty umí číst vložené obaly a texty přímo ze vzdálených souborů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem din musiksamling i skyen, og spar plads på enheden. Lydmotoren til alle formater kan læse indlejrede covers og sangtekster direkte fra fjernfiler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre deine Musiksammlung in der Cloud auf und spare Speicherplatz auf deinem Gerät. Die Audio-Engine für alle Formate kann eingebettete Cover und Songtexte direkt aus entfernten Musikdateien auslesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύστε τη μουσική συλλογή σας στο cloud και εξοικονομήστε χώρο στη συσκευή. Η μηχανή ήχου όλων των μορφότυπων διαβάζει ενσωματωμένα εξώφυλλα και στίχους απευθείας από απομακρυσμένα αρχεία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your music collection in the cloud and save space on your device. The All-Format Audio Engine can read embedded artwork and lyrics directly from remote music files."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your music collection in the cloud and save space on your device. The All-Format Audio Engine can read embedded artwork and lyrics directly from remote music files."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your music collection in the cloud and save space on your device. The All-Format Audio Engine can read embedded artwork and lyrics directly from remote music files."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your music collection in the cloud and save space on your device. The All-Format Audio Engine can read embedded artwork and lyrics directly from remote music files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tu colección de música en la nube y ahorra espacio en el dispositivo. El motor de audio para todos los formatos puede leer portadas y letras incrustadas directamente de los archivos de música remotos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tu colección de música en la nube y ahorra espacio en el dispositivo. El motor de audio para todos los formatos puede leer portadas y letras incrustadas directamente de los archivos de música remotos."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tu colección de música en la nube y ahorra espacio en el dispositivo. El motor de audio para todos los formatos puede leer portadas y letras incrustadas directamente de los archivos de música remotos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilytä musiikkikokoelmasi pilvessä ja säästä laitteen tallennustilaa. Kaikkien tiedostomuotojen äänimoottori voi lukea upotetut kansikuvat ja sanoitukset suoraan etätiedostoista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez votre collection musicale dans le cloud et économisez de l’espace sur votre appareil. Le moteur audio tous formats peut lire les pochettes et les paroles intégrées directement dans les fichiers musicaux distants."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez votre collection musicale dans le cloud et économisez de l’espace sur votre appareil. Le moteur audio tous formats peut lire les pochettes et les paroles intégrées directement dans les fichiers musicaux distants."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמרו את אוסף המוזיקה בענן וחסכו מקום במכשיר. מנוע השמע לכל הפורמטים יכול לקרוא עטיפות ומילים מוטמעות ישירות מקובצי מוזיקה מרוחקים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना संगीत संग्रह क्लाउड में रखें और डिवाइस की स्टोरेज बचाएँ। ऑल-फ़ॉर्मैट ऑडियो इंजन रिमोट संगीत फ़ाइलों से एम्बेड किए गए कवर और बोल सीधे पढ़ सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čuvajte glazbenu zbirku u oblaku i uštedite prostor na uređaju. Audiopogon za sve formate može čitati ugrađene omote i tekstove pjesama izravno iz udaljenih datoteka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tárolja zenegyűjteményét a felhőben, és takarítson meg helyet az eszközön. Az összes formátumot kezelő hangmotor közvetlenül a távoli fájlokból tudja kiolvasni a beágyazott borítókat és dalszövegeket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan koleksi musik di cloud untuk menghemat ruang perangkat. Mesin Audio Semua Format dapat membaca sampul dan lirik yang disematkan langsung dari file musik jarak jauh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva la tua raccolta musicale sul cloud e risparmia spazio sul dispositivo. Il motore audio per tutti i formati può leggere copertine e testi incorporati direttamente dai file musicali remoti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音楽コレクションをクラウドに保存して、デバイスの容量を節約できます。全フォーマット対応オーディオエンジンは、リモートの音楽ファイルに埋め込まれたカバー画像や歌詞を直接読み取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음악 컬렉션을 클라우드에 보관해 기기의 저장 공간을 절약하세요. 모든 형식을 지원하는 오디오 엔진으로 원격 음악 파일에 저장된 커버 이미지와 가사를 직접 읽을 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan koleksi muzik anda di awan untuk menjimatkan ruang peranti. Enjin Audio Semua Format boleh membaca kulit album dan lirik terbenam terus daripada fail muzik jauh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre musikksamlingen i skyen og spar plass på enheten. Lydmotoren for alle formater kan lese innebygde omslag og sangtekster direkte fra eksterne filer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar je muziekcollectie in de cloud en bespaar ruimte op je apparaat. De audio-engine voor alle formaten kan ingesloten albumhoezen en songteksten rechtstreeks uit externe muziekbestanden lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechowuj kolekcję muzyki w chmurze i oszczędzaj miejsce na urządzeniu. Silnik audio dla wszystkich formatów odczytuje osadzone okładki i teksty bezpośrednio ze zdalnych plików."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde sua coleção de música na nuvem e economize espaço no dispositivo. O mecanismo de áudio para todos os formatos pode ler capas e letras incorporadas diretamente dos arquivos de música remotos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde a sua coleção de música na nuvem e poupe espaço no dispositivo. O motor de áudio para todos os formatos pode ler capas e letras incorporadas diretamente dos ficheiros de música remotos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Păstrați colecția muzicală în cloud și economisiți spațiu pe dispozitiv. Motorul audio pentru toate formatele poate citi copertele și versurile încorporate direct din fișierele aflate la distanță."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храните музыкальную коллекцию в облаке и экономьте место на устройстве. Аудиодвижок для всех форматов может читать встроенные обложки и тексты песен прямо из удалённых файлов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložte hudobnú zbierku do cloudu a ušetrite miesto v zariadení. Zvukový modul pre všetky formáty dokáže čítať vložené obaly a texty priamo zo vzdialených súborov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasbeno zbirko hranite v oblaku in prihranite prostor v napravi. Zvočni pogon za vse formate lahko bere vdelane ovitke in besedila neposredno iz oddaljenih datotek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara musiksamlingen i molnet och frigör utrymme på enheten. Ljudmotorn för alla format kan läsa inbäddade omslag och låttexter direkt från fjärrfiler."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บคอลเลกชันเพลงบนคลาวด์เพื่อประหยัดพื้นที่ในอุปกรณ์ เอนจินเสียงที่รองรับทุกรูปแบบสามารถอ่านปกและเนื้อเพลงที่ฝังไว้จากไฟล์เพลงระยะไกลได้โดยตรง"
