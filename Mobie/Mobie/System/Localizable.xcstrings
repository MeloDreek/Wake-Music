      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان خادمك يحتوي على أكثر من 10,000 أغنية. سيؤدي إيقاف تشغيله إلى إظهار جميع الفنانين والأغاني فقط. إذا كان الرقم مرتفعًا جدًا، فإن تشغيله سيستهلك المزيد من وقت الطلب والذاكرة، وستحدث مشاكل تأخر لا يمكن إصلاحها"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Ihr Server mehr als 10.000 Titel hat. Wenn Sie die Option ausschalten, werden nur alle Künstler und Titel angezeigt. Wenn die Anzahl zu hoch ist, verbraucht das Einschalten der Funktion mehr Anfragezeit und Speicherplatz, und es kommt zu nicht behebbaren Verzögerungsproblemen"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
