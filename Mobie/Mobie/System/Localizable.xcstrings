        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas portadas se han extraído de tus archivos de música locales. Puedes reutilizarlas para añadir rápidamente las portadas que faltan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tässä näkyvät paikallisista musiikkitiedostoista poimitut kansikuvat. Voit käyttää niitä muiden kappaleiden puuttuvien kansikuvien täydentämiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces pochettes ont été extraites de vos fichiers musicaux locaux. Vous pouvez les réutiliser pour ajouter rapidement les pochettes manquantes."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces pochettes ont été extraites de vos fichiers musicaux locaux. Vous pouvez les réutiliser pour ajouter rapidement les pochettes manquantes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כאן מופיעות עטיפות שחולצו מקובצי המוזיקה המקומיים. אפשר להשתמש בהן להוספת עטיפות לקובצי מוזיקה אחרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ आपकी स्थानीय संगीत फ़ाइलों से निकाले गए कवर दिखते हैं। इन्हें दूसरी संगीत फ़ाइलों में कवर जोड़ने के लिए इस्तेमाल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovdje se prikazuju omoti izdvojeni iz lokalnih glazbenih datoteka. Upotrijebite ih za dodavanje omota drugim pjesmama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itt találhatók a helyi zenefájlokból kinyert borítók. Felhasználhatja őket más dalok hiányzó borítóinak pótlására."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sampul yang diambil dari file musik lokal Anda muncul di sini. Gunakan kembali untuk menambahkan sampul ke file musik lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste copertine sono state estratte dai file musicali locali. Puoi riutilizzarle per aggiungere rapidamente le copertine mancanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルの音楽ファイルから抽出したカバー画像がここに表示されます。他の音楽ファイルのカバーとして再利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 음악 파일에서 추출한 커버 이미지입니다. 다른 음악 파일의 커버로 사용할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar kulit album yang diekstrak daripada fail muzik tempatan anda dipaparkan di sini. Gunakan semula gambar ini untuk menambah kulit album pada fail muzik lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her finner du omslagsbilder hentet fra lokale musikkfiler. Bruk dem til å legge til manglende omslag på andre sanger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze albumhoezen zijn uit je lokale muziekbestanden gehaald. Je kunt ze hergebruiken om ontbrekende hoezen snel toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj znajdziesz okładki wyodrębnione z lokalnych plików muzycznych. Możesz nimi uzupełnić brakujące okładki innych utworów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas capas foram extraídas dos arquivos de música locais. Você pode reutilizá-las para adicionar rapidamente as capas que faltam."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas capas foram extraídas dos ficheiros de música locais. Pode reutilizá-las para adicionar rapidamente as capas em falta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aici apar coperțile extrase din fișierele muzicale locale. Le puteți folosi pentru a adăuga coperțile lipsă altor piese."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь собраны обложки из локальных музыкальных файлов. Используйте их для других треков, у которых нет обложки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nájdete obaly načítané z miestnych hudobných súborov. Môžete nimi doplniť chýbajúce obaly ďalších skladieb."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tukaj so ovitki, pridobljeni iz lokalnih glasbenih datotek. Z njimi lahko dodate manjkajoče ovitke drugim skladbam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Här visas omslag hämtade från dina lokala musikfiler. Använd dem för att lägga till saknade omslag till andra låtar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปกที่ดึงจากไฟล์เพลงในอุปกรณ์จะแสดงที่นี่ คุณสามารถนำไปใช้เพิ่มปกให้ไฟล์เพลงอื่นได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel müzik dosyalarınızdan çıkarılan kapaklar burada görünür. Bunları diğer müzik dosyalarına kapak eklemek için kullanabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тут зібрано обкладинки з локальних музичних файлів. Використовуйте їх для інших треків, які не мають обкладинки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh bìa được trích xuất từ các tệp nhạc trên thiết bị sẽ xuất hiện ở đây. Bạn có thể dùng lại để thêm ảnh bìa cho các tệp nhạc khác."
          }
