    "Once metadata is written into tags, no matter what device you transfer your music files to, this information will never be lost!" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ الوسوم داخل ملف الموسيقى نفسه، وتنتقل معه عند نسخه إلى جهاز آخر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les etiquetes es desen al fitxer de música mateix i es copien amb ell quan el passes a un altre dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagy se ukládají přímo do hudebního souboru, takže se při kopírování do jiného zařízení přenesou spolu s ním."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags gemmes i selve musikfilen, så de følger med, når du kopierer filen til en anden enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tags werden direkt in der Musikdatei gespeichert und mit übertragen, wenn du die Datei auf ein anderes Gerät kopierst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ετικέτες αποθηκεύονται μέσα στο μουσικό αρχείο και μεταφέρονται μαζί του όταν το αντιγράφετε σε άλλη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags are stored in the music file itself, so they travel with it when you copy the file to another device."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags are stored in the music file itself, so they travel with it when you copy the file to another device."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags are stored in the music file itself, so they travel with it when you copy the file to another device."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags are stored in the music file itself, so they travel with it when you copy the file to another device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las etiquetas se guardan dentro del archivo de música y se transfieren con él cuando lo copias a otro dispositivo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las etiquetas se guardan dentro del archivo de música y se transfieren con él cuando lo copias a otro dispositivo."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las etiquetas se guardan dentro del archivo de música y se transfieren con él cuando lo copias a otro dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnisteet tallennetaan itse musiikkitiedostoon, joten ne kulkevat mukana, kun kopioit tiedoston toiseen laitteeseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les métadonnées sont stockées dans le fichier musical lui-même et l’accompagnent lorsque vous le copiez sur un autre appareil."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les métadonnées sont stockées dans le fichier musical lui-même et l’accompagnent lorsque vous le copiez sur un autre appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התגיות נשמרות בתוך קובץ המוזיקה עצמו ועוברות איתו כשמעתיקים אותו למכשיר אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टैग संगीत फ़ाइल के अंदर सहेजे जाते हैं, इसलिए फ़ाइल को दूसरे डिवाइस पर कॉपी करने पर वे भी साथ जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznake se pohranjuju u samoj glazbenoj datoteci pa se prenose zajedno s njom kada je kopirate na drugi uređaj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A címkék magában a zenefájlban tárolódnak, így a fájl másik eszközre másolásakor vele együtt kerülnek át."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag disimpan dalam file musik dan ikut tersalin saat file dipindahkan ke perangkat lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tag sono salvati nel file musicale stesso e lo accompagnano quando lo copi su un altro dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タグは音楽ファイル自体に保存されるため、別のデバイスにファイルをコピーすると一緒に引き継がれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "태그는 음악 파일 자체에 저장되므로 파일을 다른 기기로 복사하면 함께 이동합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag disimpan dalam fail muzik itu sendiri, jadi tag turut disalin apabila fail dipindahkan ke peranti lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taggene lagres i selve musikkfilen, så de følger med når du kopierer filen til en annen enhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tags worden in het muziekbestand zelf opgeslagen en gaan mee wanneer je het bestand naar een ander apparaat kopieert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagi są zapisywane w samym pliku muzycznym, więc zostają z nim podczas kopiowania na inne urządzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tags ficam armazenadas no próprio arquivo de música e vão junto quando você o copia para outro dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As etiquetas ficam guardadas no próprio ficheiro de música e acompanham-no quando o copia para outro dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etichetele sunt stocate în fișierul muzical, așa că se transferă odată cu el când îl copiați pe alt dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теги хранятся внутри музыкального файла и переносятся вместе с ним при копировании на другое устройство."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagy sa ukladajú priamo do hudobného súboru, takže sa pri kopírovaní do iného zariadenia prenesú spolu s ním."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznake so shranjene v sami glasbeni datoteki, zato se pri kopiranju v drugo napravo prenesejo skupaj z njo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taggarna lagras i själva musikfilen och följer därför med när du kopierar filen till en annan enhet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แท็กจะเก็บอยู่ในไฟล์เพลง จึงติดไปด้วยเมื่อคุณคัดลอกไฟล์ไปยังอุปกรณ์อื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiketler müzik dosyasının içinde saklanır; dosyayı başka bir cihaza kopyaladığınızda onunla birlikte taşınır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теги зберігаються всередині музичного файлу й переносяться разом із ним під час копіювання на інший пристрій."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thẻ được lưu ngay trong tệp nhạc nên sẽ đi cùng tệp khi bạn sao chép sang thiết bị khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签保存在音乐文件内部，复制文件到其他设备时，这些信息也会一同保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤儲存在音樂檔案內部，將檔案複製到其他裝置時，這些資訊也會一併保留。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤儲存在音樂檔案內部，將檔案複製到其他裝置時，這些資料也會一併保留。"
          }
        }
