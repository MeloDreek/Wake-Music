        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez au mode classique hors ligne et profitez de vos téléchargements Navidrome pour une expérience musicale hors ligne incomparable."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לעבור למצב הקלאסי הלא מקוון וליהנות מהשירים שהורדת מ־Navidrome עם חוויית מוזיקה מעולה ללא אינטרנט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्लासिक ऑफ़लाइन मोड पर जाएँ और Navidrome से डाउनलोड किए गए गानों के साथ बेहतरीन ऑफ़लाइन संगीत अनुभव का आनंद लें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prebacite se u klasični izvanmrežni način rada i uživajte u pjesmama preuzetim s Navidromea uz vrhunski doživljaj glazbe bez interneta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váltson klasszikus offline módra, és élvezze a Navidrome-ból letöltött dalokat kiváló zenei élménnyel, internet nélkül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beralih ke mode offline Klasik untuk menikmati lagu yang diunduh dari Navidrome dengan pengalaman musik offline terbaik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa alla modalità classica offline e goditi i brani scaricati da Navidrome con un’esperienza musicale offline di altissimo livello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラシックのオフラインモードに切り替えると、Navidromeからダウンロードした曲を、充実したオフライン音楽体験で楽しめます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클래식 오프라인 모드로 전환하여 Navidrome에서 다운로드한 곡을 최고의 오프라인 음악 환경에서 즐겨 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beralih ke mod luar talian Klasik untuk menikmati lagu yang dimuat turun daripada Navidrome dengan pengalaman muzik luar talian terbaik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bytt til klassisk frakoblet modus og nyt sangene du har lastet ned fra Navidrome, med en førsteklasses musikkopplevelse uten nett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel over naar de klassieke offlinemodus en geniet van je Navidrome-downloads met de ultieme offline muziekervaring."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejdź do klasycznego trybu offline i ciesz się utworami pobranymi z Navidrome oraz doskonałym odtwarzaniem muzyki bez internetu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mude para o modo clássico offline e aproveite suas músicas baixadas do Navidrome com a melhor experiência musical sem internet."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mude para o modo clássico offline e desfrute das músicas descarregadas do Navidrome com a melhor experiência musical sem internet."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treceți la modul clasic offline și bucurați-vă de melodiile descărcate din Navidrome, cu o experiență muzicală offline de excepție."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключитесь в классический офлайн-режим и наслаждайтесь музыкой, скачанной из Navidrome, без интернета и с максимальным удобством."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepnite do klasického offline režimu a vychutnajte si skladby stiahnuté z Navidrome so špičkovým zážitkom z hudby bez pripojenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preklopite v klasični način brez povezave in uživajte v skladbah, prenesenih iz Navidroma, z vrhunsko glasbeno izkušnjo brez interneta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Växla till klassiskt offlineläge och njut av låtarna du laddat ner från Navidrome med en förstklassig musikupplevelse utan internet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนเป็นโหมดคลาสสิกแบบออฟไลน์เพื่อเพลิดเพลินกับเพลงที่ดาวน์โหลดจาก Navidrome พร้อมประสบการณ์ฟังเพลงออฟไลน์ระดับยอดเยี่ยม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasik çevrimdışı moda geçerek Navidrome’dan indirdiğiniz şarkıların keyfini üstün bir çevrimdışı müzik deneyimiyle çıkarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перейдіть у класичний офлайн-режим і насолоджуйтеся музикою, завантаженою з Navidrome, з першокласним прослуховуванням без інтернету."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển sang chế độ ngoại tuyến Cổ điển để thưởng thức các bài hát đã tải từ Navidrome với trải nghiệm âm nhạc ngoại tuyến đỉnh cao."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從 Navidrome 下載的歌曲，您也可以直接切換到經典的離線模式，享受最頂級的離線音樂體驗。"
          }
        },
        "zh-Hans" : {
