    "Customize your experience with features like theme colors and music player skins." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خصّص تجربتك باستخدام ميزات مثل ألوان السمات وواجهات مشغل الموسيقى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalitza la teva experiència amb funcions com els colors del tema i les aparences del reproductor de música."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přizpůsobte si prostředí pomocí funkcí, jako jsou barvy motivu a vzhled hudebního přehrávače."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpas din oplevelse med funktioner som temafarver og forskellige udseender til musikafspilleren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe dein Erlebnis mit Funktionen wie Designfarben und Skins für den Musikplayer an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσαρμόστε την εμπειρία σας με λειτουργίες όπως τα χρώματα θέματος και οι εμφανίσεις του music player."
          }
        },
        "en" : {
