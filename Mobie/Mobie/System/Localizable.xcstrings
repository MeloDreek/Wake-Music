        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedä ja pudota musiikkitiedosto tähän ikkunaan tai napsauta \"Lataa tiedosto\" -painiketta. Älä sammuta näyttöä ❗️ lähetyksen aikana"
