    "Pre-download the next song while playing remote music. Once downloaded, it plays instantly without buffering, Wi-Fi, or cellular data." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نزّل تلقائيًا الأغنية التي تستمع إليها من المصدر البعيد. تظهر التنزيلات المكتملة في مكتبتك المحلية للاستماع دون اتصال بالإنترنت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarrega automàticament la cançó remota que estàs escoltant. Les descàrregues completades apareixen a la biblioteca de música local per poder-les escoltar sense connexió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při přehrávání vzdálené skladby ji automaticky stáhne pro offline poslech. Po dokončení stahování ji můžete přehrát bez Wi-Fi i mobilních dat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloader automatisk den sang, du streamer, til offlineafspilning. Når den er downloadet, kan du afspille den uden Wi-Fi eller mobildata."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt den gerade abgespielten Titel von einem entfernten Server automatisch herunter. Abgeschlossene Downloads erscheinen in deiner lokalen Mediathek und können offline abgespielt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατεβάζει αυτόματα το τραγούδι που αναπαράγεται από απομακρυσμένη πηγή για ακρόαση εκτός σύνδεσης. Μετά τη λήψη, μπορείτε να το ακούσετε χωρίς Wi-Fi ή δεδομένα κινητής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically download the remote song you are listening to. Completed downloads appear in your local music library for offline playback."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically download the remote song you are listening to. Completed downloads appear in your local music library for offline playback."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically download the remote song you are listening to. Completed downloads appear in your local music library for offline playback."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically download the remote song you are listening to. Completed downloads appear in your local music library for offline playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga automáticamente la canción remota que estás escuchando. Las descargas completadas aparecen en tu biblioteca de música local para que puedas escucharlas sin conexión."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga automáticamente la canción remota que estás escuchando. Las descargas completadas aparecen en tu biblioteca de música local para que puedas escucharlas sin conexión."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga automáticamente la canción remota que estás escuchando. Las descargas completadas aparecen en tu biblioteca de música local para que puedas escucharlas sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lataa parhaillaan suoratoistettavan kappaleen automaattisesti offline-kuuntelua varten. Latauksen jälkeen voit toistaa sen ilman Wi-Fiä tai mobiilidataa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge automatiquement le titre distant que vous écoutez. Les téléchargements terminés apparaissent dans votre bibliothèque musicale locale pour une écoute hors ligne."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge automatiquement le titre distant que vous écoutez. Les téléchargements terminés apparaissent dans votre bibliothèque musicale locale pour une écoute hors ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הורדה אוטומטית של השיר המרוחק שמתנגן כעת. לאחר סיום ההורדה, השיר יופיע בספרייה המקומית להאזנה ללא אינטרנט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिमोट स्रोत से सुने जा रहे गाने को अपने-आप डाउनलोड करें। डाउनलोड पूरे होने पर गाने स्थानीय लाइब्रेरी में मिलेंगे और उन्हें ऑफ़लाइन सुन सकेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatski preuzima trenutačnu pjesmu s udaljenog izvora za slušanje izvan mreže. Nakon preuzimanja možete je slušati bez Wi-Fi-ja ili mobilnih podataka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatikusan letölti az éppen távolról lejátszott dalt offline hallgatáshoz. A letöltés után Wi-Fi és mobiladat nélkül is lejátszható."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unduh otomatis lagu jarak jauh yang sedang Anda dengarkan. Unduhan yang selesai akan muncul di koleksi lokal untuk diputar secara offline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica automaticamente il brano remoto che stai ascoltando. I download completati appaiono nella libreria musicale locale per l’ascolto offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生中のリモートの曲を自動でダウンロードします。完了した曲はローカルの音楽ライブラリに表示され、オフラインで再生できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 듣고 있는 원격 음악을 자동으로 다운로드합니다. 다운로드가 완료된 곡은 로컬 음악 보관함에 표시되며 오프라인으로 재생할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muat turun secara automatik lagu jauh yang sedang anda dengar. Muat turun yang selesai akan muncul dalam pustaka muzik tempatan untuk main balik di luar talian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laster automatisk ned sangen du strømmer, for lytting uten nett. Etter nedlasting kan du spille den av uten Wi-Fi eller mobildata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloadt automatisch het nummer dat je op afstand beluistert. Voltooide downloads verschijnen in je lokale muziekbibliotheek, zodat je ze offline kunt afspelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatycznie pobiera bieżący utwór ze zdalnego źródła do słuchania offline. Po pobraniu możesz go odtworzyć bez Wi-Fi i danych komórkowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa automaticamente a música remota que você está ouvindo. Os downloads concluídos aparecem na biblioteca de músicas locais para reprodução offline."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarrega automaticamente a música remota que está a ouvir. As descargas concluídas aparecem na biblioteca de música local para reprodução offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarcă automat piesa redată de la distanță pentru ascultare offline. După descărcare, o puteți reda fără Wi-Fi sau date mobile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически скачивает текущий трек с удалённого источника для прослушивания офлайн. После загрузки его можно слушать без Wi-Fi и мобильного интернета."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri prehrávaní vzdialenej skladby ju automaticky stiahne na počúvanie offline. Po dokončení sťahovania ju môžete prehrať bez Wi-Fi aj mobilných dát."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samodejno prenese trenutno skladbo iz oddaljenega vira za poslušanje brez povezave. Po prenosu jo lahko predvajate brez omrežja Wi-Fi ali mobilnih podatkov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laddar automatiskt ner låten som strömmas så att du kan lyssna offline. Efter nedladdningen kan du spela den utan Wi-Fi eller mobildata."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดาวน์โหลดเพลงจากระยะไกลที่กำลังฟังโดยอัตโนมัติ เมื่อดาวน์โหลดเสร็จ เพลงจะปรากฏในคลังเพลงในอุปกรณ์เพื่อฟังแบบออฟไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinlediğiniz uzak şarkıyı otomatik olarak indirin. Tamamlanan indirmeler, çevrimdışı dinlemek üzere yerel müzik kitaplığınızda görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматично завантажує поточний трек із віддаленого джерела для прослуховування офлайн. Після завантаження його можна слухати без Wi-Fi та мобільного інтернету."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động tải bài hát từ xa đang nghe. Bài tải xong sẽ xuất hiện trong thư viện nhạc trên thiết bị để phát ngoại tuyến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动下载正在播放的远程歌曲。下载完成后会出现在本地音乐库中，方便离线播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動下載正在播放的遠端歌曲。下載完成後會顯示在本機音樂庫中，方便離線播放。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動下載正在播放的遠端歌曲。下載完成後會顯示在本機音樂庫中，方便離線播放。"
          }
        }
      }
    },
    "Prefer Apple's built-in AVPlayer. If AVPlayer fails to play a file, playback will automatically switch to the All-Format Audio Engine. If AVPlayer successfully decodes the file, this mode may not be able to read embedded artwork and lyrics from remote files." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُفضّل استخدام AVPlayer المدمج من Apple. إذا فشل AVPlayer في تشغيل ملف، فسيتم التبديل تلقائيًا إلى محرك الصوت الشامل. إذا نجح AVPlayer في فك ترميز الملف، فقد لا يتمكن هذا الوضع من قراءة الغلاف المضمّن وكلمات الأغاني من الملفات البعيدة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioritza l’AVPlayer integrat d’Apple. Si l’AVPlayer no pot reproduir un fitxer, la reproducció canviarà automàticament al motor d’àudio multiformat. Si l’AVPlayer descodifica correctament el fitxer, és possible que aquest mode no pugui llegir la portada i les lletres incrustades dels fitxers remots."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upřednostňuje se vestavěný AVPlayer od Applu. Pokud AVPlayer nedokáže soubor přehrát, přehrávání se automaticky přepne na zvukový engine pro všechny formáty. Pokud AVPlayer soubor úspěšně dekóduje, tento režim nemusí být schopen načíst vložený obrázek a texty ze vzdálených souborů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples indbyggede AVPlayer bruges som førstevalg. Hvis AVPlayer ikke kan afspille en fil, skifter afspilningen automatisk til lydmotoren til alle formater. Hvis AVPlayer kan afkode filen, kan denne funktion muligvis ikke læse indlejret albumgrafik og sangtekster fra fjernfiler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples integrierter AVPlayer wird bevorzugt verwendet. Kann AVPlayer eine Datei nicht abspielen, wechselt die Wiedergabe automatisch zur Audio-Engine für alle Formate. Bei Dateien, die AVPlayer abspielt, können eingebettete Cover und Songtexte aus entfernten Dateien in diesem Modus möglicherweise nicht ausgelesen werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προτιμάται ο ενσωματωμένος AVPlayer της Apple. Αν ο AVPlayer αποτύχει να αναπαράγει ένα αρχείο, η αναπαραγωγή μεταβαίνει αυτόματα στη μηχανή ήχου όλων των μορφών. Αν ο AVPlayer αποκωδικοποιήσει επιτυχώς το αρχείο, αυτή η λειτουργία ενδέχεται να μην μπορεί να διαβάσει ενσωματωμένο εξώφυλλο και στίχους από απομακρυσμένα αρχεία."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefer Apple's built-in AVPlayer. If AVPlayer fails to play a file, playback will automatically switch to the All-Format Audio Engine. If AVPlayer successfully decodes the file, this mode may not be able to read embedded artwork and lyrics from remote files."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefer Apple's built-in AVPlayer. If AVPlayer fails to play a file, playback will automatically switch to the All-Format Audio Engine. If AVPlayer successfully decodes the file, this mode may not be able to read embedded artwork and lyrics from remote files."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefer Apple's built-in AVPlayer. If AVPlayer fails to play a file, playback will automatically switch to the All-Format Audio Engine. If AVPlayer successfully decodes the file, this mode may not be able to read embedded artwork and lyrics from remote files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se prioriza el AVPlayer integrado de Apple. Si AVPlayer no puede reproducir un archivo, la reproducción cambiará automáticamente al motor de audio para todos los formatos. Si AVPlayer consigue decodificar el archivo, este modo puede no ser capaz de leer la portada y las letras incrustadas en archivos remotos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se prioriza el AVPlayer integrado de Apple. Si AVPlayer no puede reproducir un archivo, la reproducción cambiará automáticamente al motor de audio para todos los formatos. Si AVPlayer consigue decodificar el archivo, este modo puede no ser capaz de leer la portada y las letras incrustadas en archivos remotos."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se prioriza el AVPlayer integrado de Apple. Si AVPlayer no puede reproducir un archivo, la reproducción cambiará automáticamente al motor de audio para todos los formatos. Si AVPlayer consigue decodificar el archivo, este modo puede no ser capaz de leer la portada y las letras incrustadas en archivos remotos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applen sisäänrakennettua AVPlayeria käytetään ensisijaisesti. Jos AVPlayer ei pysty toistamaan tiedostoa, toisto siirtyy automaattisesti kaikkien formaattien äänimoottoriin. Jos AVPlayer pystyy purkamaan tiedoston, tämä tila ei välttämättä pysty lukemaan etätiedostojen upotettua kansikuvaa ja sanoituksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’AVPlayer intégré d’Apple est utilisé en priorité. Si AVPlayer ne parvient pas à lire un fichier, la lecture bascule automatiquement vers le moteur audio tous formats. Si AVPlayer décode correctement le fichier, ce mode peut ne pas pouvoir lire la pochette et les paroles intégrées aux fichiers distants."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’AVPlayer intégré d’Apple est utilisé en priorité. Si AVPlayer ne parvient pas à lire un fichier, la lecture bascule automatiquement vers le moteur audio tous formats. Si AVPlayer décode correctement le fichier, ce mode peut ne pas pouvoir lire la pochette et les paroles intégrées aux fichiers distants."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נעשה שימוש מועדף ב-AVPlayer המובנה של Apple. אם AVPlayer נכשל בהפעלת קובץ, ההפעלה תעבור אוטומטית למנוע השמע לכל הפורמטים. אם AVPlayer מצליח לפענח את הקובץ, ייתכן שמצב זה לא יוכל לקרוא עטיפה ומילות שיר מוטמעות מקבצים מרוחקים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple के बिल्ट-इन AVPlayer को प्राथमिकता दी जाती है। यदि AVPlayer किसी फ़ाइल को चलाने में विफल रहता है, तो प्लेबैक अपने आप ऑल-फ़ॉर्मैट ऑडियो इंजन पर स्विच हो जाएगा। यदि AVPlayer फ़ाइल को सफलतापूर्वक डिकोड कर लेता है, तो यह मोड रिमोट फ़ाइलों से एम्बेडेड कवर और लिरिक्स को पढ़ने में सक्षम नहीं हो सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prednost ima Appleov ugrađeni AVPlayer. Ako AVPlayer ne uspije reproducirati datoteku, reprodukcija će se automatski prebaciti na audio pogon za sve formate. Ako AVPlayer uspješno dekodira datoteku, ovaj način rada možda neće moći očitati ugrađenu naslovnicu i tekstove iz udaljenih datoteka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elsőként az Apple beépített AVPlayerét használja. Ha az AVPlayer nem tudja lejátszani a fájlt, a lejátszás automatikusan átvált a minden formátumot támogató hangmotorra. Ha az AVPlayer sikeresen dekódolja a fájlt, ez a mód előfordulhat, hogy nem tudja beolvasni a távoli fájlokba ágyazott borítóképet és dalszöveget."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer bawaan Apple akan diprioritaskan. Jika AVPlayer gagal memutar file, pemutaran akan otomatis beralih ke Mesin Audio Semua Format. Jika AVPlayer berhasil mendekode file, mode ini mungkin tidak dapat membaca sampul dan lirik yang disematkan dalam file jarak jauh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene data priorità all’AVPlayer integrato di Apple. Se AVPlayer non riesce a riprodurre un file, la riproduzione passerà automaticamente al motore audio per tutti i formati. Se AVPlayer riesce a decodificare il file, questa modalità potrebbe non essere in grado di leggere la copertina e i testi incorporati nei file remoti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleの内蔵AVPlayerを優先して使用します。AVPlayerで再生できない場合は、自動的に全フォーマット対応オーディオエンジンに切り替わります。AVPlayerで正常にデコードできた場合、このモードではリモートファイルに埋め込まれたアートワークや歌詞を解析できないことがあります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple의 내장 AVPlayer를 우선 사용합니다. AVPlayer로 파일을 재생하지 못하면 자동으로 모든 형식을 지원하는 오디오 엔진으로 전환됩니다. AVPlayer에서 파일 디코딩에 성공한 경우, 이 모드에서는 원격 파일에 삽입된 앨범 아트와 가사를 읽지 못할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer terbina dalam Apple akan diutamakan. Jika AVPlayer gagal memainkan fail, main balik akan beralih secara automatik kepada Enjin Audio Semua Format. Jika AVPlayer berjaya menyahkod fail, mod ini mungkin tidak dapat membaca kulit album dan lirik yang terbenam dalam fail jauh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples innebygde AVPlayer prioriteres. Hvis AVPlayer ikke kan spille av en fil, byttes avspillingen automatisk til lydmotoren for alle formater. Hvis AVPlayer dekoder filen, kan denne modusen kanskje ikke lese innebygd omslag og sangtekster fra eksterne filer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ingebouwde AVPlayer van Apple krijgt de voorkeur. Als AVPlayer een bestand niet kan afspelen, schakelt het afspelen automatisch over naar de audio-engine voor alle formaten. Als AVPlayer het bestand wel kan decoderen, kan deze modus mogelijk geen ingesloten albumillustraties en songteksten uit externe bestanden lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W pierwszej kolejności używany jest wbudowany AVPlayer firmy Apple. Jeśli AVPlayer nie może odtworzyć pliku, odtwarzanie automatycznie przełączy się na silnik audio obsługujący wszystkie formaty. Jeśli AVPlayer pomyślnie zdekoduje plik, ten tryb może nie odczytać osadzonej okładki ani tekstu zdalnych plików."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AVPlayer integrado da Apple é priorizado. Se o AVPlayer não conseguir reproduzir um arquivo, a reprodução mudará automaticamente para o mecanismo de áudio para todos os formatos. Se o AVPlayer conseguir decodificar o arquivo, este modo pode não conseguir ler a capa e as letras incorporadas em arquivos remotos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AVPlayer integrado da Apple é utilizado prioritariamente. Se o AVPlayer não conseguir reproduzir um ficheiro, a reprodução mudará automaticamente para o motor de áudio para todos os formatos. Se o AVPlayer conseguir descodificar o ficheiro, este modo poderá não conseguir ler a capa e as letras incorporadas em ficheiros remotos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer-ul integrat de Apple este utilizat cu prioritate. Dacă AVPlayer nu poate reda un fișier, redarea va comuta automat la motorul audio pentru toate formatele. Dacă AVPlayer decodează cu succes fișierul, este posibil ca acest mod să nu poată citi coperta și versurile încorporate în fișierele de la distanță."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В первую очередь используется встроенный AVPlayer от Apple. Если AVPlayer не может воспроизвести файл, воспроизведение автоматически переключается на аудиодвижок для всех форматов. Если AVPlayer успешно декодирует файл, этот режим может не поддерживать чтение встроенной обложки и текста из удалённых файлов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprednostňuje sa vstavaný AVPlayer od Apple. Ak AVPlayer nedokáže prehrať súbor, prehrávanie sa automaticky prepne na zvukový engine pre všetky formáty. Ak AVPlayer súbor úspešne dekóduje, tento režim nemusí byť schopný načítať vložený obrázok a texty zo vzdialených súborov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prednostno se uporablja Applov vgrajeni AVPlayer. Če AVPlayer ne more predvajati datoteke, se predvajanje samodejno preklopi na zvočni pogon za vse formate. Če AVPlayer datoteko uspešno dekodira, ta način morda ne bo mogel prebrati vdelane naslovnice in besedila iz oddaljenih datotek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples inbyggda AVPlayer prioriteras. Om AVPlayer inte kan spela upp en fil växlar uppspelningen automatiskt till ljudmotorn för alla format. Om AVPlayer kan avkoda filen kan detta läge kanske inte läsa inbäddat omslag och låttexter från fjärrfiler."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระบบจะเลือกใช้ AVPlayer ในตัวของ Apple ก่อน หาก AVPlayer ไม่สามารถเล่นไฟล์ได้ ระบบจะสลับไปใช้เอนจินเสียงที่รองรับทุกรูปแบบโดยอัตโนมัติ หาก AVPlayer สามารถถอดรหัสไฟล์ได้ โหมดนี้อาจไม่สามารถอ่านปกอัลบั้มและเนื้อเพลงที่ฝังอยู่ในไฟล์ระยะไกลได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ın yerleşik AVPlayer'ına öncelik verilir. AVPlayer bir dosyayı oynatamazsa oynatma otomatik olarak Tüm Formatları Destekleyen Ses Motoru'na geçer. AVPlayer dosyanın kodunu başarıyla çözerse bu mod, uzak dosyalara gömülü kapak görselini ve şarkı sözlerini okuyamayabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевага надається вбудованому AVPlayer від Apple. Якщо AVPlayer не може відтворити файл, відтворення автоматично перемикається на аудіодвигун для всіх форматів. Якщо AVPlayer успішно декодує файл, цей режим може не підтримувати читання вбудованої обкладинки та тексту з віддалених файлів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ưu tiên sử dụng AVPlayer tích hợp của Apple. Nếu AVPlayer không thể phát tệp, trình phát sẽ tự động chuyển sang Bộ máy âm thanh hỗ trợ mọi định dạng. Nếu AVPlayer giải mã tệp thành công, chế độ này có thể không đọc được ảnh bìa và lời bài hát được nhúng trong các tệp từ xa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先使用 Apple 内置的 AVPlayer。当 AVPlayer 播放失败时，会自动切换到全格式音频引擎。如果 AVPlayer 解码成功，此模式可能无法解析远程文件内嵌的封面和歌词。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先使用 Apple 內建的 AVPlayer。當 AVPlayer 播放失敗時，會自動切換至全格式音訊引擎。如果 AVPlayer 解碼成功，此模式可能無法解析遠端檔案內嵌的封面和歌詞。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
