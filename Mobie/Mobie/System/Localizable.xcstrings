    "Guangya.ClockSkew" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض Guangya Drive وقت الجهاز. فعّل التاريخ والوقت التلقائيين في الإعدادات وأعد المحاولة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive ha rebutjat l’hora del dispositiu. Activa la data i hora automàtiques als ajustos i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive odmítl čas zařízení. Zapněte automatické datum a čas v nastavení a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive afviste enhedens tid. Slå automatisk dato og tid til i indstillinger, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive hat die Gerätezeit abgelehnt. Automatisches Datum und Uhrzeit in den Systemeinstellungen aktivieren und erneut versuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Guangya Drive απέρριψε την ώρα της συσκευής. Ενεργοποιήστε αυτόματη ημερομηνία και ώρα στις ρυθμίσεις και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive rejected the device time. Turn on automatic date and time in system settings, then try again."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive rejected the device time. Turn on automatic date and time in system settings, then try again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive rejected the device time. Turn on automatic date and time in system settings, then try again."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive rejected the device time. Turn on automatic date and time in system settings, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive rechazó la hora del dispositivo. Activa la fecha y hora automáticas en los ajustes y reintenta."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive rechazó la hora del dispositivo. Activa la fecha y hora automáticas en los ajustes y reintenta."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive rechazó la hora del dispositivo. Activa la fecha y hora automáticas en los ajustes y reintenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive hylkäsi laitteen ajan. Ota automaattinen päivä ja aika käyttöön asetuksissa ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive a refusé l’heure de l’appareil. Activez la date et l’heure automatiques dans les réglages, puis réessayez."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive a refusé l’heure de l’appareil. Activez la date et l’heure automatiques dans les réglages, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive דחה את שעת המכשיר. יש להפעיל תאריך ושעה אוטומטיים בהגדרות ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive ने डिवाइस का समय अस्वीकार किया। सेटिंग में स्वचालित दिनांक व समय चालू करके फिर प्रयास करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive odbio je vrijeme uređaja. Uključite automatski datum i vrijeme u postavkama pa pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Guangya Drive elutasította az eszköz idejét. Kapcsolja be az automatikus dátumot és időt a beállításokban, majd próbálja újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive menolak waktu perangkat. Aktifkan tanggal dan waktu otomatis di pengaturan, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive ha rifiutato l’ora del dispositivo. Attiva data e ora automatiche nelle impostazioni e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Driveが端末の時刻を拒否しました。システム設定で日付と時刻を自動設定にして再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive가 기기 시간을 거부했습니다. 시스템 설정에서 날짜 및 시간 자동 설정을 켜고 다시 시도하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive menolak masa peranti. Aktifkan tarikh dan masa automatik dalam tetapan, kemudian cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive avviste enhetens tid. Slå på automatisk dato og tid i innstillingene og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive heeft de apparaattijd afgewezen. Schakel automatische datum en tijd in de instellingen in en probeer opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive odrzucił czas urządzenia. Włącz automatyczną datę i godzinę w ustawieniach i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Guangya Drive rejeitou o horário do dispositivo. Ative data e hora automáticas nos ajustes e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Guangya Drive rejeitou a hora do dispositivo. Ative a data e hora automáticas nas definições e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive a respins ora dispozitivului. Activează data și ora automate în setări și reîncearcă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive отклонил время устройства. Включите автоматические дату и время в настройках и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive odmietol čas zariadenia. Zapnite automatický dátum a čas v nastaveniach a skúste znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive je zavrnil čas naprave. V nastavitvah vklopite samodejni datum in čas ter poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive avvisade enhetens tid. Aktivera automatiskt datum och tid i inställningarna och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive ปฏิเสธเวลาของอุปกรณ์ เปิดวันที่และเวลาอัตโนมัติในการตั้งค่าระบบแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive cihaz saatini reddetti. Sistem ayarlarında otomatik tarih ve saati açıp yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive відхилив час пристрою. Увімкніть автоматичні дату й час у налаштуваннях і повторіть спробу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive từ chối thời gian thiết bị. Bật ngày giờ tự động trong cài đặt hệ thống rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光鸭云盘检测到设备时间偏差。请在系统设置中开启自动设置日期与时间，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光鴨雲盤偵測到裝置時間有誤。請在系統設定中開啟自動設定日期與時間，然後重試。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光鴨雲盤偵測到裝置時間有誤。請在系統設定中開啟自動設定日期與時間，然後重試。"
          }
        }
      }
    },
    "Guangya.Configuration" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Guangya Drive التحقق من إعداد التطبيق أو توقيع الطلب. تواصل مع دعم Wake Music."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive no ha pogut validar la configuració de l’app o la signatura de la petició. Contacta amb el suport de Wake Music."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive nemohl ověřit nastavení aplikace nebo podpis požadavku. Kontaktujte podporu Wake Music."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive kunne ikke validere appkonfiguration eller anmodningssignatur. Kontakt Wake Music-support."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guangya Drive konnte App-Konfiguration oder Anfragesignatur nicht prüfen. Wake Music-Support kontaktieren."
          }
        },
        "el" : {
          "stringUnit" : {
