    "SMB access denied. Check the username, password, and shared-folder permissions." : {
      "comment" : "SMB connection, read-only audio access.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رُفض الوصول إلى SMB. تحقق من اسم المستخدم وكلمة المرور وأذونات المجلد المشترك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accés SMB denegat. Comprova l’usuari, la contrasenya i els permisos de la carpeta compartida."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup SMB zamítnut. Zkontrolujte jméno, heslo a oprávnění sdílené složky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB-adgang nægtet. Kontroller brugernavn, adgangskode og den delte mappes tilladelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB-Zugriff verweigert. Benutzername, Passwort und Freigabeberechtigungen prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόσβαση SMB απορρίφθηκε. Ελέγξτε χρήστη, κωδικό και δικαιώματα φακέλου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB access denied. Check the username, password, and shared-folder permissions."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB access denied. Check the username, password, and shared-folder permissions."
          }
