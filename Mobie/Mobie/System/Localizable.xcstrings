        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אודיו דחוס מאבד מידע כדי להקטין את גודל הקובץ, על חשבון איכות השמע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉसी ऑडियो फ़ाइल का आकार कम करने के लिए अधिक कंप्रेशन का उपयोग करता है, जिससे ऑडियो गुणवत्ता प्रभावित होती है।"
