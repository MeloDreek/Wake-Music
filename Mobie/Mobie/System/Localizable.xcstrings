    "Full-format playback engine, supporting audio formats unsupported by Apple Music. E.g., DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV, etc." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محرك تشغيل جميع الصيغ، يدعم تنسيقات الصوت التي لا يستطيع Apple Music فك ترميزها. مثل: DSD (DSF, DFF)، DTS، APE، OGG، OPUS، WMA، S3M، TTA، MOD، WV، إلخ"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motor de reproducció multiformat, compatible amb formats que Apple Music no pot descodificar. Com: DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV, etc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehrávací engine pro všechny formáty, podporující zvuky, které Apple Music nedokáže dekódovat. Např.: DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV atd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuldformatsafspilningsmotor, der understøtter lydformater, som Apple Music ikke kan afkode. F.eks.: DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV osv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal-Wiedergabe-Engine, unterstützt Audioformate, die Apple Music nicht dekodieren kann. Z. B.: DSD (DSF, DFF), DTS, APE, OGG, OPUS, WMA, S3M, TTA, MOD, WV etc."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
