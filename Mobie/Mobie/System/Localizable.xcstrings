    "MEGA.ProxyUnsupported" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع MEGA استخدام إعداد الوكيل الحالي للنظام. نصوص الوكيل التلقائي (PAC) غير مدعومة بعد. استخدم وكيل HTTP أو SOCKS يدويًا صالحًا، أو شبكة تصل إلى MEGA مباشرة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MEGA no pot utilitzar aquesta configuració de servidor intermediari. Els scripts automàtics (PAC) encara no són compatibles. Utilitza un proxy HTTP o SOCKS manual vàlid, o una xarxa amb accés directe a MEGA."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MEGA nemůže použít toto systémové nastavení proxy. Automatické skripty proxy (PAC) zatím nejsou podporovány. Použijte platnou ruční proxy HTTP či SOCKS nebo síť s přímým přístupem k MEGA."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MEGA kan ikke bruge denne systemproxykonfiguration. Automatiske proxyscripts (PAC) understøttes endnu ikke. Brug en gyldig manuel HTTP- eller SOCKS-proxy eller et netværk med direkte adgang til MEGA."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MEGA kann diese System-Proxykonfiguration nicht nutzen. Automatische Proxyskripte (PAC) werden noch nicht unterstützt. Einen gültigen manuellen HTTP- oder SOCKS-Proxy oder ein Netzwerk mit direktem MEGA-Zugriff verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το MEGA δεν μπορεί να χρησιμοποιήσει αυτές τις ρυθμίσεις διακομιστή μεσολάβησης. Τα αυτόματα σενάρια (PAC) δεν υποστηρίζονται ακόμα. Χρησιμοποιήστε έγκυρο χειροκίνητο HTTP ή SOCKS proxy ή δίκτυο με άμεση πρόσβαση στο MEGA."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MEGA cannot use this system proxy configuration. Automatic proxy scripts (PAC) are not supported yet. Use a valid manual HTTP or SOCKS proxy, or a network that can reach MEGA directly."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
