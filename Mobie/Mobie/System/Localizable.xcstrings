          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעבר לתגיות בסיסיות—ערוך גם עטיפות ומילים. ארגון מוזיקה מעולם δεν היה פשוט יותר!"
