        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit käyttää sisäänrakennettua musiikkitunnisteiden muokkausohjelmaamme varmistaaksesi, että jokainen äänitiedosto sisältää täydelliset upotetut metatiedot. Se tukee nyt äänisormenjälkiä metatietojen automaattiseen tunnistamiseen ja niiden eräkohtaiseen upottamiseen äänitiedostoihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez utiliser notre éditeur de tags musicaux intégré pour vous assurer que chaque fichier audio contient des métadonnées complètes. Il prend désormais en charge l'empreinte acoustique pour identifier automatiquement les métadonnées et les intégrer par lot dans vos fichiers audio."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez utiliser notre éditeur de tags musicaux intégré pour vous assurer que chaque fichier audio contient des métadonnées complètes. Il prend désormais en charge l'empreinte acoustique pour identifier automatiquement les métadonnées et les intégrer par lot dans vos fichiers audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תוכל להשתמש בעורך תגיות המוזיקה המובנה שלנו כדי להבטיח שכל קובץ שמע מכיל מטא-דאטה מוטמעת מלאה. המערכת תומכת כעת בטביעת אצבע קולית לזיהוי אוטומטי של מטא-דאטה והטמעתה באצווה ישירות בקובצי השמע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप यह सुनिश्चित करने के लिए हमारे अंतर्निहित संगीत टैग संपादक का उपयोग कर सकते हैं कि प्रत्येक ऑडियो फ़ाइल में पूर्ण एम्बेडेड मेटाडेटा हो। यह अब मेटाडेटा को स्वचालित रूप से पहचानने और ऑडियो फ़ाइलों में बैच-एम्बेड करने के लिए ऑडियो फ़िंगरप्रिंटिंग का समर्थन करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možete upotrijebiti naš ugrađeni uređivač glazbenih oznaka kako biste osigurali da svaka audio datoteka sadrži potpune ugrađene metapodatke. Sada podržava prepoznavanje zvučnog otiska za automatsko prepoznavanje metapodataka i njihovo skupno ugrađivanje u audio datoteke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beépített zenecímke-szerkesztőnk segítségével biztosíthatja, hogy minden hangfájl hiánytalanul beágyazott metaadatokat tartalmazzon. Mostantól támogatja az akusztikus ujjlenyomat-felismerést a metaadatok automatikus beazonosításához és azok tömeges beágyazásához a hangfájlokba."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda dapat menggunakan editor tag musik bawaan kami untuk memastikan setiap file audio memiliki metadata lengkap yang tertanam. Sekarang mendukung sidik jari audio untuk mengenali metadata secara otomatis dan menyematkannya secara massal ke dalam file audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi utilizzare il nostro editor di tag musicali integrato per assicurarti che ogni file audio contenga metadati incorporati completi. Ora supporta l'impronta acustica per identificare automaticamente i metadati e incorporarli in blocco nei file audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内蔵の音源タグエディタを使用すれば、すべての音声ファイルに完全なメタデータを直接埋め込むことができます。さらに音響フィンガープリント（音声識別）に対応し、メタデータを自動識別してファイルへ一括で自動埋め込みできるようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내장된 음악 태그 편집기를 사용하여 모든 오디오 파일에 완전한 메타데이터가 내장되도록 할 수 있습니다. 이제 오디오 핑거프린트 기능을 지원하여 메타데이터를 자동으로 인식하고 오디오 파일에 일괄 자동 내장할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda boleh menggunakan penyunting tag muzik terbina dalam kami untuk memastikan setiap fail audio mengandungi metadata penuh yang tertanam. Ia kini menyokong cap jari audio untuk mengenali metadata secara automatik dan memasukkannya secara pukal ke dalam fail audio."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan bruke vår innebygde musikk-tag-editor for å sikre at hver lydfil inneholder fullstendige innebygde metadata. Den støtter nå lydfingeravtrykk for automatisk gjenkjenning av metadata og automatisk batch-innebygging i lydfilene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U kunt onze ingebouwde muziektageditor gebruiken om ervoor te zorgen dat elk audiobestand volledige ingesloten metadata bevat. Het ondersteunt nu audio-vingerafdrukken om metadata automatisch te herkennen en in batch rechtstreeks in audiobestanden in te sluiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz skorzystać z naszego wbudowanego edytora tagów muzycznych, aby upewnić się, że każdy plik audio zawiera pełne osadzone metadane. Obsługuje on teraz rozpoznawanie śladu akustycznego do automatycznej identyfikacji metadanych i ich masowego osadzania w plikach audio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode usar nosso editor de tags de música integrado para garantir que cada arquivo de áudio contenha metadados incorporados completos. Agora ele suporta identificação por impressão digital de áudio para reconhecer metadados automaticamente e incorporá-los em lote nos arquivos de áudio."
