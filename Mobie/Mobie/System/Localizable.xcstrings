    "MusicServer.Downloads.OfflineMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقل إلى الوضع الكلاسيكي دون اتصال للاستمتاع بالأغاني التي نزّلتها من Navidrome مع أفضل تجربة موسيقية دون إنترنت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia al mode clàssic sense connexió i gaudeix de les cançons descarregades de Navidrome amb la millor experiència musical sense connexió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přepněte do klasického offline režimu a užijte si skladby stažené z Navidrome s prvotřídním poslechem bez připojení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skift til klassisk offlinetilstand, og nyd dine downloads fra Navidrome med den ultimative offline musikoplevelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle in den klassischen Offline-Modus und genieße deine Navidrome-Downloads mit erstklassigem Musikgenuss ohne Internet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεταβείτε στην κλασική λειτουργία εκτός σύνδεσης και απολαύστε τα τραγούδια που κατεβάσατε από το Navidrome με την απόλυτη μουσική εμπειρία χωρίς διαδίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch to Classic offline mode to enjoy your Navidrome downloads with the ultimate offline music experience."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch to Classic offline mode to enjoy your Navidrome downloads with the ultimate offline music experience."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch to Classic offline mode to enjoy your Navidrome downloads with the ultimate offline music experience."
          }
        },
        "en-IN" : {
