        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mrežno podudaranje uvelike se oslanja na nazive audio datoteka ili ugrađene naslove, izvođače i trajanje; bilo koji nestandardni element može dovesti do pogrešnih omota i tekstova."
