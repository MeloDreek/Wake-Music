        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az audiominta túl rövid vagy érvénytelen a hanglenyomathoz. A hossza nem elegendő az akusztikai elemzéshez. Kérjük, szerkessze manuálisan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
