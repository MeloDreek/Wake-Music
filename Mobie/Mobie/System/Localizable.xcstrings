    "Drag and drop music files into this window or click the Upload File button. Please keep the screen on while transferring." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب ملف الموسيقى وأفلته في هذه النافذة ، أو انقر فوق الزر \"تحميل ملف\". يرجى عدم إيقاف تشغيل الشاشة ❗️ أثناء الإرسال"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrossegueu i deixeu anar el fitxer de música en aquesta finestra o feu clic al botó \"Carrega fitxer\". Si us plau, no apagueu la pantalla ❗️ durant la transmissió"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přetáhněte hudební soubor do tohoto okna nebo klikněte na tlačítko \"Nahrát soubor\". Během přenosu prosím nevypínejte obrazovku ❗️"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk og slip musikfilen i dette vindue, eller klik på knappen \"Upload fil\". Sluk ikke for skærmen ❗️ under transmission"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie die Musikdatei per Drag & Drop in dieses Fenster oder klicken Sie auf die Schaltfläche \"Datei hochladen\". Bitte schalten Sie den Bildschirm ❗️ während der Übertragung nicht aus"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε και αποθέστε το αρχείο μουσικής σε αυτό το παράθυρο ή κάντε κλικ στο κουμπί \"Μεταφόρτωση αρχείου\". Μην απενεργοποιείτε την οθόνη ❗️ κατά τη μετάδοση"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
