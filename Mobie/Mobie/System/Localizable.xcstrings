    "When enabled, the UI refreshes 1,000 times per second for millisecond-precise lyrics, but CPU usage and power consumption can be 10× higher than in Power Saving mode." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقلّل وضع توفير الطاقة وتيرة تحديث كلمات الأغاني لتقليل استخدام المعالج واستهلاك البطارية. أوقفه لتحديث الكلمات بوتيرة أعلى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mode d’estalvi d’energia actualitza les lletres amb menys freqüència per reduir l’ús de la CPU i el consum de bateria. Desactiva’l per actualitzar-les més sovint."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsporný režim aktualizuje texty méně často, aby snížil zatížení procesoru a spotřebu baterie. Pro častější aktualizace ho vypněte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømsparetilstand opdaterer sangtekster sjældnere for at reducere CPU- og batteriforbruget. Slå den fra for hyppigere opdateringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Energiesparmodus aktualisiert die Songtexte seltener, um CPU-Auslastung und Akkuverbrauch zu senken. Deaktiviere ihn für häufigere Aktualisierungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η λειτουργία εξοικονόμησης ενέργειας ενημερώνει τους στίχους λιγότερο συχνά, μειώνοντας τη χρήση της CPU και την κατανάλωση μπαταρίας. Απενεργοποιήστε την για συχνότερες ενημερώσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Power Saving Mode updates lyrics less often to reduce CPU usage and battery consumption. Turn it off for more frequent updates."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Power Saving Mode updates lyrics less often to reduce CPU usage and battery consumption. Turn it off for more frequent updates."
          }
