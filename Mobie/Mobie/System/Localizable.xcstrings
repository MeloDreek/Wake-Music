          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB-käyttö estetty. Tarkista tunnus, salasana ja jaon oikeudet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès SMB refusé. Vérifiez les identifiants et les autorisations du dossier partagé."
