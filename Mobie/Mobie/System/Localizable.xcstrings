        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous que l’appareil actuel est connecté au même réseau Wi-Fi que votre ordinateur ou votre téléphone Android, et n’éteignez pas l’écran ❗️ pendant la transmission"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous que l’appareil actuel est connecté au même Wi-Fi que votre ordinateur ou votre téléphone Android, et n’éteignez pas l’écran ❗️ pendant la transmission"
