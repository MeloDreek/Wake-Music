        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš všestranný hudební přehrávač. Poslouchejte kdykoli a kdekoli a užijte si úplnou svobodu poslechu!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din ultimative musikafspiller. Afspil når som helst, hvor som helst, og nyd fuld lyttefrihed!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
