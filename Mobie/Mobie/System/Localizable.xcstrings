        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjerite je li trenutni uređaj povezan na isti Wi-Fi kao i vaše računalo ili Android telefon i nemojte isključivati zaslon ❗️ tijekom prijenosa"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérjük, győződjön meg arról, hogy az aktuális eszköz ugyanahhoz a Wi-Fi-hez csatlakozik, mint a számítógép vagy az Android telefon, és ne kapcsolja ki a képernyőt ❗️ átvitel közben"
          }
        },
        "id" : {
          "stringUnit" : {
