          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version macOS active temporairement toutes les fonctionnalités premium. N'hésitez pas à partager cette information avec vos amis."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version macOS active temporairement toutes les fonctionnalités premium. N'hésitez pas à partager cette information avec vos amis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS वर्शन ने कुछ समय के लिए सभी प्रीमियम फ़ीचर चालू कर दिए हैं। कृपया यह खबर अपने दोस्तों के साथ शेयर करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versi macOS untuk sementara telah mengaktifkan semua fitur premium. Silakan bagikan kabar ini kepada teman-teman Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versione per macOS ha temporaneamente abilitato tutte le funzionalità premium. Condividi questa notizia con i tuoi amici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS版では、すべてのプレミアム機能が一時的に有効になっています。このニュースをお友達と共有してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 버전에서 모든 프리미엄 기능이 일시적으로 활성화되었습니다. 이 소식을 친구들과 공유해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
