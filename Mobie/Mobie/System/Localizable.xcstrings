    "Connect your Mac or Windows computer via USB and with the help of our recommended tools (iTunes, iMazing), quickly import your files to a folder within the application" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتوصيل جهاز كمبيوتر Mac أو Windows عبر USB وقم باستيراد الملفات بسرعة إلى مجلدات داخل التطبيق بمساعدة أدواتنا الموصى بها (iTunes و iMazing)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecteu el vostre ordinador Mac o Windows mitjançant USB i importeu ràpidament fitxers a carpetes de l'aplicació amb l'ajuda de les nostres eines recomanades (iTunes, iMazing)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojte svůj počítač Mac nebo Windows přes USB a rychle importujte soubory do složek v aplikaci pomocí našich doporučených nástrojů (iTunes, iMazing)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilslut din Mac- eller Windows-computer via USB, og importer hurtigt filer til mapper i appen ved hjælp af vores anbefalede værktøjer (iTunes, iMazing)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließen Sie Ihren Mac oder Windows-Computer über USB an und importieren Sie Dateien schnell in In-App-Ordner mit Hilfe unserer empfohlenen Tools (iTunes, iMazing)."
          }
        },
        "el" : {
          "stringUnit" : {
