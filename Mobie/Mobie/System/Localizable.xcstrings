    "Audio fingerprint generated, but no matching track was found in global music databases. It may be an unreleased edit or remix, often related to unique waveform characteristics. Please edit manually." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إنشاء البصمة الصوتية بنجاح، ولكن لم يتم العثور على أغنية مطابقة في قاعدة بيانات الموسيقى السحابية العالمية. قد تكون هذه النسخة غير رسمية أو معدلة، وهو ما يرتبط غالبًا بخصائص الموجة الصوتية. يرجى التعديل يدويًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'ha generat l'empremta digital d'àudio, però no s'ha trobat cap cançó coincident a la base de dades musical global. Pot ser una versió no oficial o modificada, relacionat amb les característiques de l'ona d'àudio. Editeu-la manualment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvukový otisk byl úspěšně vygenerován, ale v globální hudební databázi nebyla nalezena žádná odpovídající skladba. Může jít o neoficiální úpravu, což často souvisí s vlastnostmi zvukové vlny. Upravte ručně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lydfingeraftryk blev oprettet, men der blev ikke fundet et matchende spor i den globale musikdatabase. Det kan være en uofficiel version eller remix, hvilket ofte skyldes lydbølgeegenskaber. Rediger venligst manuelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio-Fingerprint erfolgreich erstellt, aber in der globalen Musikdatenbank wurde kein passender Titel gefunden. Es handelt sich möglicherweise um ein inoffizielles Edit/Remix, was oft mit der Schallwelle zusammenhängt. Bitte manuell bearbeiten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ηχητικό αποτύπωμα δημιουργήθηκε, αλλά δεν βρέθηκε αντιστοιχία στην παγκόσμια βάση δεδομένων μουσικής. Ίσως πρόκειται για μη επίσημη διασκευή, κάτι που συχνά σχετίζεται με τα χαρακτηριστικά του ηχητικού κύματος. Παρακαλώ επεξεργαστείτε χειροκίνητα."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio fingerprint generated, but no matching track was found in global music databases. It may be an unreleased edit or remix, often related to unique waveform characteristics. Please edit manually."
          }
        },
        "en-GB" : {
