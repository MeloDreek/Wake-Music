            "value" : "3. إذا كنت قد اشتريت بالفعل على جهاز آخر ، فيرجى استئناف الشراء على الجهاز الجديد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Si ja heu comprat en un altre dispositiu, repreneu la compra en el dispositiu nou."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Pokud jste již nákup provedli na jiném zařízení, pokračujte v nákupu na novém zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Hvis du allerede har købt på en anden enhed, skal du genoptage købet på den nye enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Wenn Sie bereits auf einem anderen Gerät gekauft haben, setzen Sie den Kauf auf dem neuen Gerät fort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Εάν έχετε ήδη αγοράσει σε άλλη συσκευή, συνεχίστε την αγορά στη νέα συσκευή."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. If you have already purchased on another device, please resume the purchase on the new device."
          }
