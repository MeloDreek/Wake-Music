    "Audio sample is too short or invalid for fingerprinting. The duration is insufficient for acoustic analysis. Please edit it manually." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عينة الصوت قصيرة جداً أو غير صالحة للبصمة الصوتية. المدة غير كافية للتحليل الصوتي. يرجى التعديل يدوياً."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fragment d’àudio és massa curt o no és vàlid per generar una empremta acústica. No té prou durada per analitzar-lo. Edita les metadades manualment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvukový vzorek je příliš krátký nebo neplatný pro otisk. Doba trvání je nedostatečná pro akustickou analýzu. Upravte data ručně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lydprøven er for kort eller ugyldig til fingeraftryk. Varigheden er utilstrækkelig til akustisk analyse. Rediger venligst manuelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Audioprobe ist zu kurz oder ungültig für das Fingerprinting. Die Dauer reicht für eine akustische Analyse nicht aus. Bitte manuell bearbeiten."
