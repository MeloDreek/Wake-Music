    "EQ.PresetsGuide" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإعدادات المسبقة نقطة بداية، وليست قواعد لنوع موسيقي. تُحفظ تعديلاتك اليدوية ضمن «مخصّص»."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els preajustos són un punt de partida, no regles per a un gènere musical. Els ajustos manuals es desen a «Personalitzat»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předvolby jsou výchozím bodem, ne pravidlem pro daný žánr. Ruční úpravy se ukládají jako „Vlastní“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forudindstillinger er et udgangspunkt, ikke regler for en genre. Manuelle justeringer gemmes under Brugerdefineret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presets sind Ausgangspunkte, keine Vorgaben für ein Genre. Manuelle Anpassungen werden unter „Benutzerdefiniert“ gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι προεπιλογές είναι αφετηρία, όχι κανόνες για κάθε μουσικό είδος. Οι χειροκίνητες ρυθμίσεις αποθηκεύονται στο «Προσαρμοσμένο»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presets are starting points, not rules for a genre. Manual adjustments are saved to Custom."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presets are starting points, not rules for a genre. Manual adjustments are saved to Custom."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presets are starting points, not rules for a genre. Manual adjustments are saved to Custom."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presets are starting points, not rules for a genre. Manual adjustments are saved to Custom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los preajustes son un punto de partida, no reglas para cada género. Los ajustes manuales se guardan en «Personalizado»."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los preajustes son un punto de partida, no reglas para cada género. Los ajustes manuales se guardan en «Personalizado»."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los preajustes son un punto de partida, no reglas para cada género. Los ajustes manuales se guardan en «Personalizado»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiasetukset ovat lähtökohtia, eivät musiikkityylin sääntöjä. Omat säädöt tallennetaan Mukautettu-esiasetukseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les préréglages sont un point de départ, pas des règles pour un genre musical. Vos réglages manuels sont enregistrés dans « Personnalisé »."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les préréglages sont un point de départ, pas des règles pour un genre musical. Vos réglages manuels sont enregistrés dans « Personnalisé »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההגדרות המוכנות הן נקודת התחלה, לא כללים לסוגה מוזיקלית. שינויים ידניים נשמרים תחת „מותאם אישית”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रीसेट शुरुआत के लिए हैं, किसी शैली के नियम नहीं। मैन्युअल बदलाव कस्टम में सेव होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predlošci su polazište, a ne pravila za glazbeni žanr. Ručne prilagodbe spremaju se pod „Prilagođeno”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangképek kiindulópontok, nem műfaji szabályok. A kézi módosítások az Egyéni hangképbe kerülnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preset adalah titik awal, bukan aturan untuk suatu genre. Penyesuaian manual disimpan ke Kustom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I preset sono punti di partenza, non regole per un genere musicale. Le regolazioni manuali vengono salvate in «Personalizzato»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリセットは音作りの出発点であり、ジャンルごとの正解ではありません。手動で調整した設定は「カスタム」に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프리셋은 조정의 출발점이지, 장르별 정답은 아닙니다. 직접 조정한 값은 ‘사용자 설정’에 저장됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratetap ialah titik permulaan, bukan peraturan untuk sesuatu genre. Pelarasan manual disimpan dalam Tersuai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forhåndsinnstillinger er et utgangspunkt, ikke regler for en sjanger. Manuelle justeringer lagres under Egendefinert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presets zijn een startpunt, geen regels voor een genre. Handmatige aanpassingen worden opgeslagen onder ‘Aangepast’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presety to punkt wyjścia, a nie reguły dla gatunku muzycznego. Ręczne zmiany są zapisywane jako „Własny”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os presets são pontos de partida, não regras para um gênero. Os ajustes manuais são salvos em Personalizado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As predefinições são pontos de partida, não regras para um género. Os ajustes manuais são guardados em Personalizado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presetările sunt puncte de plecare, nu reguli pentru un gen muzical. Reglajele manuale se salvează la Personalizat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пресеты — отправная точка, а не правила для жанра. Ручные настройки сохраняются в пресете «Свой»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predvoľby sú východiskom, nie pravidlom pre daný žáner. Ručné úpravy sa ukladajú ako „Vlastný“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prednastavitve so izhodišče, ne pravila za glasbeno zvrst. Ročne prilagoditve se shranijo pod »Po meri«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förinställningar är en utgångspunkt, inte regler för en genre. Manuella justeringar sparas under Anpassad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พรีเซ็ตเป็นเพียงจุดเริ่มต้น ไม่ใช่กฎตายตัวของแนวเพลง การปรับด้วยตนเองจะบันทึกไว้ใน «กำหนดเอง»"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ön ayarlar bir başlangıç noktasıdır, türe özgü kurallar değildir. Elle yaptığınız ayarlar Özel seçeneğine kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пресети — відправна точка, а не правила для жанру. Ручні налаштування зберігаються у пресеті «Власний»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết lập sẵn là điểm khởi đầu, không phải quy tắc cho từng thể loại. Các điều chỉnh thủ công được lưu vào Tùy chỉnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预设只是听感起点，不是曲风的标准答案。手动调整会保存为「自定义」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設只是聽感起點，不是曲風的標準答案。手動調整會儲存為「自訂」。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設只是聽感起點，不是曲風的標準答案。手動調整會儲存為「自訂」。"
          }
        }
