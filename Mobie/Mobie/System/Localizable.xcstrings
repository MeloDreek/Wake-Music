            "value" : "फ़ाइल में एम्बेड किए गए गीतों को स्वचालित रूप से पार्स करें, जोड़ने, संपादित करने, हटाने और प्लेबैक का समर्थन करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secara otomatis mengurai lirik yang tertanam dalam file, mendukung penambahan, pengeditan, penghapusan, dan pemutaran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizza automaticamente i testi incorporati nel file, supporta l'aggiunta, la modifica, l'eliminazione e la riproduzione successiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルに埋め込まれた歌詞を自動的に解析し、追加、編集、削除、再生経過の追跡をサポート"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일에 포함된 가사를 자동으로 구문 분석하고, 추가, 편집, 삭제 및 재생 진행 상황 추적을 지원합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghuraikan lirik yang dibenamkan dalam fail secara automatik, menyokong menambah, mengedit, memadam dan mengikuti main balik"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analise automaticamente as letras incorporadas no arquivo e suporte para adicionar, editar, excluir e acompanhar o progresso da reprodução"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analise automaticamente as letras incorporadas no ficheiro e suporte a adicionar, editar, eliminar e seguir o progresso da reprodução"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматический разбор текстов песен, встроенных в файл, поддержка добавления, редактирования, удаления и последующего воспроизведения"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วิเคราะห์เนื้อเพลงที่ฝังอยู่ในไฟล์โดยอัตโนมัติ รองรับการเพิ่ม แก้ไข ลบ และติดตามการเล่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyaya gömülü şarkı sözlerini otomatik olarak ayrıştırın ve oynatma ilerlemesini eklemeyi, düzenlemeyi, silmeyi ve takip etmeyi destekleyin"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động phân tích lời bài hát được nhúng trong tệp, hỗ trợ thêm, chỉnh sửa, xóa và theo dõi quá trình phát lại"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动解析文件内嵌的歌词，支持新增、编辑、删除、跟随播放进度"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動解析音檔內嵌的歌詞，支持新增、編輯、刪除、跟隨播放進度"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動解析文件內嵌嘅歌詞，支持新增、編輯、刪除、跟隨播放進度"
