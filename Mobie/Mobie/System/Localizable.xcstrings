    "Please make sure the current device is connected to the same Wi-Fi as your computer or Android phone, and keep the screen on during transmission❗️" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرجى التأكد من أن الجهاز الحالي متصل بنفس شبكة Wi-Fi مثل جهاز الكمبيوتر أو هاتف Android ، وعدم إيقاف تشغيل الشاشة ❗️ أثناء الإرسال"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assegureu-vos que el dispositiu actual estigui connectat a la mateixa Wi-Fi que el vostre ordinador o telèfon Android i no apagueu la pantalla ❗️ durant la transmissió"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujistěte se, že je aktuální zařízení připojeno ke stejné síti Wi-Fi jako váš počítač nebo telefon se systémem Android, a během přenosu nevypínejte obrazovku ❗️"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sørg for, at den aktuelle enhed er tilsluttet det samme Wi-Fi som din computer eller Android-telefon, og sluk ikke for skærmen ❗️ under transmission"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte stellen Sie sicher, dass das aktuelle Gerät mit demselben WLAN wie Ihr Computer oder Android-Telefon verbunden ist, und schalten Sie den Bildschirm ❗️ während der Übertragung nicht aus"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βεβαιωθείτε ότι η τρέχουσα συσκευή είναι συνδεδεμένη στο ίδιο Wi-Fi με τον υπολογιστή σας ή το τηλέφωνο Android και μην απενεργοποιείτε την οθόνη ❗️ κατά τη μετάδοση"
          }
        },
        "en" : {
          "stringUnit" : {
