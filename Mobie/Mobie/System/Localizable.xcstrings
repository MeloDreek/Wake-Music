    "Unable to read from SMB. Keep the server awake, connect to the same network, and check the address and permissions." : {
      "comment" : "SMB connection, read-only audio access.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت القراءة من SMB. أبقِ الخادم مستيقظًا واتصل بالشبكة نفسها وتحقّق من العنوان والأذونات."
          }
        },
        "ca" : {
