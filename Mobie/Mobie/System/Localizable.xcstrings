    "Pan123.Network" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل طلب 123 Drive. يرجى التحقق من اتصالك وأذونات الحساب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sol·licitud a 123 Drive ha fallat. Comprova la connexió i els permisos del compte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požadavek 123 Drive selhal. Zkontrolujte připojení a oprávnění účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "123 Drive-anmodningen mislykkedes. Kontrollér din forbindelse og kontoens tilladelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die 123 Drive-Anfrage ist fehlgeschlagen. Bitte überprüfe deine Verbindung und die Kontoberechtigungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αίτημα 123 Drive απέτυχε. Ελέγξτε τη σύνδεσή σας και τα δικαιώματα του λογαριασμού."
          }
        },
