        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor tag muzik lengkap yang menyokong penghuraian dan pengeditan teg muzik terbenam seperti tajuk, artis, album, kulit muka depan, lirik, dsb."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
