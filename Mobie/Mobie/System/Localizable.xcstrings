    "Imported LRC lyrics files, if the music file does not have embedded lyrics, you can select these lyrics files to be embedded into the music file!" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هنا ملفات كلمات الأغاني بصيغة LRC التي استوردتها. إذا لم يحتوِ ملف موسيقى على كلمات، يمكنك اختيار أحد هذه الملفات لتضمين كلماته فيه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí trobaràs els fitxers de lletres LRC importats. Si una cançó no té la lletra incrustada, pots seleccionar-ne una per afegir-la al fitxer de música."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zde najdete importované texty ve formátu LRC. Pokud skladba nemá vložený text, vyberte zde soubor LRC a vložte ho do ní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her finder du importerede LRC-filer. Hvis en musikfil mangler sangtekst, kan du vælge en LRC-fil og gemme teksten i musikfilen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
