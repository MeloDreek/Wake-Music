    "No manual editing required! AI Acoustic Fingerprinting analyzes the audio waveform to instantly fetch accurate metadata, 4K artwork, lyrics, and more." : {
      "extractionState" : "pasted",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا داعي للتعديل اليدوي! تُحلل البصمة الصوتية الذكية الخصائص الصوتية لملفك لتجلب لك البيانات الوصفية الدقيقة، وأغلفة 4K، والكلمات فورًا."
          }
        },
