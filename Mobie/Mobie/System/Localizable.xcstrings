    "Lossy audio uses higher compression to reduce file size, at the cost of audio quality." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصوتيات ذات الضغط الفاقد تستخدم ضغطًا أعلى لتقليل حجم الملف، على حساب جودة الصوت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’àudio amb pèrdua utilitza una compressió més alta per reduir la mida dels fitxers, a costa de la qualitat del so."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ztrátový zvuk používá vyšší kompresi ke zmenšení velikosti souboru za cenu nižší kvality zvuku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyd med tab bruger kraftigere komprimering til at reducere filstørrelsen på bekostning af lydkvaliteten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlustbehaftetes Audio verwendet eine stärkere Komprimierung, um die Dateigröße zu reduzieren, auf Kosten der Audioqualität."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο ήχος με απώλειες χρησιμοποιεί υψηλότερη συμπίεση για τη μείωση του μεγέθους του αρχείου, εις βάρος της ποιότητας ήχου."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lossy audio uses higher compression to reduce file size, at the cost of audio quality."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lossy audio uses higher compression to reduce file size, at the cost of audio quality."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lossy audio uses higher compression to reduce file size, at the cost of audio quality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio con pérdida utiliza una mayor compresión para reducir el tamaño del archivo a costa de la calidad del sonido."
