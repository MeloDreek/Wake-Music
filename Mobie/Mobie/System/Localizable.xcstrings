    "Connect your Mac or Windows computer via USB and with the help of our recommended tools (iTunes, iMazing), quickly import your files to a folder within the application" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتوصيل جهاز كمبيوتر Mac أو Windows عبر USB وبمساعدة أدواتنا الموصى بها (iTunes و iMazing)، قم باستيراد ملفاتك بسرعة إلى مجلد داخل التطبيق"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließen Sie Ihren Mac oder Windows-Computer über USB an und importieren Sie Ihre Dateien schnell in einen In-App-Ordner mit Hilfe unserer empfohlenen Tools (iTunes, iMazing)."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect your Mac or Windows computer via USB and with the help of our recommended tools (iTunes, iMazing), quickly import your files to a folder within the application"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect your Mac or Windows computer via USB and with the help of our recommended tools (iTunes, iMazing), quickly import your files to a folder within the application"
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect your Mac or Windows computer via USB and with the help of our recommended tools (iTunes, iMazing), quickly import your files to a folder within the application"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte su ordenador Mac o Windows a través de USB y con la ayuda de nuestras herramientas recomendadas (iTunes, iMazing), importe rápidamente sus archivos a una carpeta dentro de la aplicación"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte su ordenador Mac o Windows a través de USB y con la ayuda de nuestras herramientas recomendadas (iTunes, iMazing), importe rápidamente sus archivos a una carpeta dentro de la aplicación"
          }
