          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pásate a Premium para desbloquear todos los preajustes EQ, el ajuste de 10 bandas y el preamplificador. También puedes seguir explorando antes de decidir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivitä Premiumiin, niin saat kaikki EQ-esiasetukset, 10 kaistan säädön ja esivahvistimen hallinnan. Voit myös jatkaa sivun tutkimista ennen päätöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez à Premium pour accéder à tous les préréglages EQ, aux 10 bandes et au préampli. Vous pouvez aussi continuer à explorer la page avant de décider."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez à Premium pour accéder à tous les préréglages EQ, aux 10 bandes et au préampli. Vous pouvez aussi continuer à explorer la page avant de décider."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שדרגו ל-Premium כדי לפתוח את כל ההגדרות המוכנות, כוונון של 10 תחומי תדרים ושליטה בקדם־מגבר. אפשר גם להמשיך לעיין לפני השדרוג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी EQ प्रीसेट, 10-बैंड ट्यूनिंग और प्रीऐम्प नियंत्रण के लिए Premium लें। अपग्रेड से पहले आप पेज देखना जारी रख सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadogradite na Premium za sve predloške EQ-a, podešavanje 10 pojaseva i kontrolu pretpojačala. Možete i nastaviti pregledavati prije odluke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váltson Premiumra az összes EQ-beállításhoz, a 10 sávos hangoláshoz és az előerősítő vezérléséhez. Döntés előtt tovább is böngészhet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingkatkan ke Premium untuk membuka semua preset EQ, penyesuaian 10 pita, dan kontrol preamp. Anda juga dapat terus menjelajahi halaman sebelum meningkatkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa a Premium per sbloccare tutti i preset EQ, la regolazione a 10 bande e il preamplificatore. Puoi anche continuare a esplorare prima di decidere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premiumにアップグレードすると、すべてのEQプリセット、10バンド調整、プリアンプ設定を利用できます。アップグレードせずに画面を見て回ることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium으로 업그레이드하면 모든 EQ 프리셋, 10밴드 조절, 프리앰프 설정을 사용할 수 있습니다. 업그레이드 전에 화면을 더 둘러보셔도 됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naik taraf kepada Premium untuk membuka semua praset EQ, pelarasan 10 jalur dan kawalan prapenguat. Anda juga boleh terus meneroka sebelum menaik taraf."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppgrader til Premium for alle EQ-forhåndsinnstillinger, 10-båndsjustering og kontroll av forforsterkeren. Du kan også fortsette å utforske før du bestemmer deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upgrade naar Premium voor alle EQ-presets, 10-bands afstelling en de voorversterker. Je kunt ook eerst verder rondkijken voordat je beslist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejdź na Premium, aby odblokować wszystkie ustawienia EQ, regulację 10 pasm i przedwzmacniacz. Możesz też dalej przeglądać przed podjęciem decyzji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assine o Premium para liberar todas as predefinições de EQ, o ajuste de 10 bandas e o pré-amplificador. Você também pode continuar explorando antes de decidir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adira ao Premium para desbloquear todas as predefinições de EQ, o ajuste de 10 bandas e o pré-amplificador. Pode também continuar a explorar antes de decidir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treceți la Premium pentru toate presetările EQ, reglajul pe 10 benzi și controlul preamplificatorului. Puteți continua să explorați înainte de a decide."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перейдите на Premium, чтобы открыть все пресеты EQ, настройку 10 полос и управление предусилителем. Можно также продолжить знакомство со страницей перед покупкой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prejdite na Premium a odomknite všetky predvoľby EQ, ladenie 10 pásiem a predzosilňovač. Pred rozhodnutím môžete stránku ďalej prezerať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadgradite na Premium za vse prednastavitve EQ, prilagajanje 10 pasov in nadzor predojačevalnika. Pred odločitvijo lahko nadaljujete raziskovanje strani."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppgradera till Premium för alla EQ-förinställningar, 10-bandsjustering och kontroll av förförstärkaren. Du kan också fortsätta utforska innan du bestämmer dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัปเกรดเป็น Premium เพื่อปลดล็อกพรีเซ็ต EQ ทั้งหมด การปรับ 10 ย่านความถี่ และพรีแอมป์ คุณสามารถดูตัวเลือกต่าง ๆ ต่อก่อนตัดสินใจอัปเกรดได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm EQ hazır ayarlarını, 10 bantlı ayarı ve ön yükseltici kontrolünü açmak için Premium'a yükseltin. Yükseltmeden önce sayfayı incelemeye devam edebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перейдіть на Premium, щоб відкрити всі пресети EQ, налаштування 10 смуг і керування передпідсилювачем. Також можна продовжити огляд сторінки перед покупкою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nâng cấp lên Premium để mở tất cả cấu hình EQ, tinh chỉnh 10 dải tần và điều khiển tiền khuếch đại. Bạn cũng có thể tiếp tục xem trước khi nâng cấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升级到高级版，即可解锁全部 EQ 预设、10 段调音和前级增益控制。你也可以先继续浏览，再决定是否升级。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升級至高級版，即可解鎖所有 EQ 預設、10 段調音和前級增益控制。你也可以先繼續瀏覽，再決定是否升級。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升級至高級版，即可解鎖所有 EQ 預設、10 段調音和前級增益控制。你也可以先繼續瀏覽，再決定是否升級。"
          }
        }
      }
    },
