        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat membaca daripada SMB. Pastikan pelayan tidak tidur, sambung ke rangkaian sama dan semak alamat serta kebenaran."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke lese fra SMB. Hold serveren våken, koble til samme nettverk og kontroller adresse og tillatelser."
