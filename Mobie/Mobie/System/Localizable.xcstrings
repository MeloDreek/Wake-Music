    "Unable to read from SMB. Keep the server awake, connect to the same network, and check the address and permissions." : {
      "comment" : "SMB connection, read-only audio access.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت القراءة من SMB. أبقِ الخادم مستيقظًا واتصل بالشبكة نفسها وتحقّق من العنوان والأذونات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es pot llegir d’SMB. Mantén el servidor actiu, connecta’t a la mateixa xarxa i comprova l’adreça i els permisos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze číst z SMB. Udržujte server vzhůru, připojte se ke stejné síti a ověřte adresu i oprávnění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke læse fra SMB. Hold serveren vågen, brug samme netværk, og kontroller adresse og tilladelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB kann nicht gelesen werden. Server wach halten, mit demselben Netzwerk verbinden und Adresse sowie Berechtigungen prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αδυναμία ανάγνωσης SMB. Κρατήστε τον διακομιστή ενεργό, συνδεθείτε στο ίδιο δίκτυο και ελέγξτε διεύθυνση και δικαιώματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unable to read from SMB. Keep the server awake, connect to the same network, and check the address and permissions."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unable to read from SMB. Keep the server awake, connect to the same network, and check the address and permissions."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
