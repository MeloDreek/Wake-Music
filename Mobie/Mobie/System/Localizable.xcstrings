    "FTP.ConnectionHelp" : {
      "comment" : "FTP sends credentials and content without transport encryption; suggest HTTPS WebDAV for remote access.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP sends your username, password, and files without encryption. Use it only on a trusted network. For access over the internet, use WebDAV over HTTPS instead."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل FTP اسم المستخدم وكلمة المرور والملفات دون تشفير. استخدمه فقط على شبكة موثوقة. للوصول عبر الإنترنت، استخدم WebDAV عبر HTTPS بدلًا منه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP envia el nom d’usuari, la contrasenya i els fitxers sense xifrar. Utilitza’l només en xarxes de confiança. Per accedir-hi per Internet, fes servir WebDAV amb HTTPS."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP přenáší uživatelské jméno, heslo i soubory bez šifrování. Používejte ho jen v důvěryhodné síti. Pro přístup přes internet raději použijte WebDAV přes HTTPS."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP sender brugernavn, adgangskode og filer uden kryptering. Brug det kun på et netværk, du har tillid til. Brug i stedet WebDAV via HTTPS til adgang over internettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP überträgt Benutzernamen, Passwort und Dateien unverschlüsselt. Verwende es nur in vertrauenswürdigen Netzwerken. Für den Zugriff über das Internet nutze stattdessen WebDAV über HTTPS."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το FTP μεταδίδει όνομα χρήστη, κωδικό και αρχεία χωρίς κρυπτογράφηση. Χρησιμοποιήστε το μόνο σε έμπιστο δίκτυο. Για πρόσβαση μέσω διαδικτύου, προτιμήστε WebDAV μέσω HTTPS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP envía el usuario, la contraseña y los archivos sin cifrar. Úsalo solo en redes de confianza. Para acceder por Internet, utiliza WebDAV mediante HTTPS."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP siirtää käyttäjätunnuksen, salasanan ja tiedostot salaamatta. Käytä sitä vain luotetussa verkossa. Käytä internetin kautta mieluummin WebDAV-yhteyttä HTTPS:llä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP transmet votre identifiant, votre mot de passe et vos fichiers sans chiffrement. Utilisez-le uniquement sur un réseau de confiance. Pour un accès par Internet, préférez WebDAV avec HTTPS."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP מעביר את שם המשתמש, הסיסמה והקבצים ללא הצפנה. יש להשתמש בו רק ברשת מהימנה. לגישה דרך האינטרנט עדיף להשתמש ב-WebDAV דרך HTTPS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP उपयोगकर्ता नाम, पासवर्ड और फ़ाइलें बिना एन्क्रिप्शन भेजता है। इसका उपयोग केवल विश्वसनीय नेटवर्क पर करें। इंटरनेट से पहुँचने के लिए HTTPS वाला WebDAV चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP šalje korisničko ime, lozinku i datoteke bez šifriranja. Koristite ga samo na pouzdanoj mreži. Za pristup putem interneta radije koristite WebDAV preko HTTPS-a."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az FTP titkosítás nélkül továbbítja a felhasználónevet, a jelszót és a fájlokat. Csak megbízható hálózaton használd. Internetes eléréshez inkább HTTPS-en keresztüli WebDAV-ot válassz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP mengirim nama pengguna, kata sandi, dan file tanpa enkripsi. Gunakan hanya di jaringan tepercaya. Untuk akses melalui internet, gunakan WebDAV melalui HTTPS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP invia nome utente, password e file senza crittografia. Usalo solo su reti attendibili. Per l’accesso via Internet, preferisci WebDAV su HTTPS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTPではユーザー名・パスワード・ファイルが暗号化されずに送信されます。信頼できるネットワークでのみ使用してください。インターネット経由ではHTTPSのWebDAVをお勧めします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP는 사용자 이름, 비밀번호, 파일을 암호화하지 않고 전송합니다. 신뢰할 수 있는 네트워크에서만 사용하세요. 인터넷을 통한 접속에는 HTTPS 기반 WebDAV를 권장합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP menghantar nama pengguna, kata laluan dan fail tanpa penyulitan. Gunakannya hanya pada rangkaian yang dipercayai. Untuk akses melalui internet, gunakan WebDAV melalui HTTPS."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP sender brukernavn, passord og filer uten kryptering. Bruk det bare på nettverk du stoler på. Bruk heller WebDAV over HTTPS for tilgang via internett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP verstuurt je gebruikersnaam, wachtwoord en bestanden zonder versleuteling. Gebruik het alleen op vertrouwde netwerken. Gebruik voor toegang via internet liever WebDAV met HTTPS."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP przesyła nazwę użytkownika, hasło i pliki bez szyfrowania. Używaj go tylko w zaufanej sieci. Do dostępu przez internet wybierz WebDAV przez HTTPS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O FTP envia usuário, senha e arquivos sem criptografia. Use apenas em uma rede confiável. Para acessar pela internet, prefira WebDAV por HTTPS."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O FTP envia o nome de utilizador, a palavra-passe e os ficheiros sem encriptação. Use-o apenas numa rede de confiança. Para acesso pela Internet, prefira WebDAV por HTTPS."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP transmite numele de utilizator, parola și fișierele fără criptare. Folosește-l doar într-o rețea de încredere. Pentru acces prin internet, alege WebDAV prin HTTPS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP передаёт имя пользователя, пароль и файлы без шифрования. Используйте его только в доверенной сети. Для доступа через интернет лучше выбрать WebDAV по HTTPS."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP prenáša používateľské meno, heslo a súbory bez šifrovania. Používajte ho len v dôveryhodnej sieti. Na prístup cez internet radšej použite WebDAV cez HTTPS."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP pošilja uporabniško ime, geslo in datoteke brez šifriranja. Uporabljajte ga samo v zaupanja vrednem omrežju. Za dostop prek interneta raje uporabite WebDAV prek HTTPS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP skickar användarnamn, lösenord och filer utan kryptering. Använd det bara i betrodda nätverk. Välj hellre WebDAV över HTTPS för åtkomst via internet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP ส่งชื่อผู้ใช้ รหัสผ่าน และไฟล์โดยไม่เข้ารหัส ใช้เฉพาะบนเครือข่ายที่เชื่อถือได้ หากเข้าถึงผ่านอินเทอร์เน็ต ควรใช้ WebDAV ผ่าน HTTPS แทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP kullanıcı adı, parola ve dosyaları şifrelemeden gönderir. Yalnızca güvenilir ağlarda kullanın. İnternet üzerinden erişim için HTTPS üzerinden WebDAV’ı tercih edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP передає ім’я користувача, пароль і файли без шифрування. Використовуйте його лише в довіреній мережі. Для доступу через інтернет краще обрати WebDAV через HTTPS."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP gửi tên người dùng, mật khẩu và tệp mà không mã hóa. Chỉ dùng trên mạng đáng tin cậy. Để truy cập qua Internet, hãy dùng WebDAV qua HTTPS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP 会以明文传输用户名、密码和文件。请仅在可信网络中使用；如需通过互联网访问，建议改用 HTTPS 加密的 WebDAV。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP 會以明文傳輸使用者名稱、密碼及檔案。請僅在可信任的網路中使用；如需透過網際網路存取，建議改用 HTTPS 加密的 WebDAV。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP 會以明文傳送用戶名稱、密碼及檔案。請只在可信任的網絡使用；如需透過互聯網存取，建議改用 HTTPS 加密的 WebDAV。"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP sends your username, password, and files without encryption. Use it only on a trusted network. For access over the internet, use WebDAV over HTTPS instead."
          }
        },
        "en-GB" : {
          "stringUnit" : {
