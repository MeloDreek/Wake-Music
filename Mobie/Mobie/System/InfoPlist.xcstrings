        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi ini memerlukan akses mikrofon untuk mendengar dan mengecam muzik sekeliling. Audio diproses secara tempatan dan tidak akan direkodkan atau disimpan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne appen krever mikrofontilgang for å lytte til og gjenkjenne omgivelsesmusikk. Lyd behandles lokalt og vil aldri bli tatt opp eller lagret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze app vereist microfoonstoegang om omgevingsmuziek te luisteren en te herkennen. Audio wordt lokaal verwerkt en zal nooit worden opgenomen of opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta aplikacja wymaga dostępu do mikrofonu, aby słuchać i rozpoznawać muzykę w otoczeniu. Dźwięk jest przetwarzany lokalnie i nigdy nie będzie nagrywany ani zapisywany."
