        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä sovellus vaatii mikrofonin käyttöoikeuden ympäristön musiikin kuunteluun ja tunnistamiseen. Ääni käsitellään paikallisesti, eikä sitä koskaan nauhoiteta tai tallenneta."
