    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب هذا التطبيق الوصول إلى الميكروفون للاستماع إلى الموسيقى المحيطة بك والتعرف عليها. يتم معالجة الصوت محلياً ولن يتم تسجيله أو حفظه أبداً."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta aplicació requereix accés al micròfon per escoltar i reconèixer la música ambient. L'àudio es processa localment i mai es gravarà ni es desarà."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato aplikace vyžaduje přístup k mikrofonu pro poslech a rozpoznávání okolní hudby. Zvuk je zpracováván lokálně a nikdy nebude nahráván ani ukládán."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne app kræver mikrofonadgang for at lytte og genkende omgivende musik. Lyd behandles lokalt og vil aldrig blive optaget eller gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App erfordert den Mikrofonzugriff, um Umgebungsmusik zu hören und zu erkennen. Audio wird lokal verarbeitet und wird niemals aufgenommen oder gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η εφαρμογή απαιτεί πρόσβαση στο μικρόφωνο για την ακρόαση και αναγνώριση της μουσικής περιβάλλοντος. Ο ήχος υποβάλλεται σε τοπική επεξεργασία και δεν θα καταγραφεί ποτέ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can use your camera to take live music videos and then convert them to music, with your permission."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app requires microphone access to listen and recognise ambient music around you. Audio is processed locally and will never be recorded or saved."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
